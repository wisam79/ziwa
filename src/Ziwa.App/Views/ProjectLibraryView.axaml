<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ziwa.App.ViewModels"
             xmlns:persist="using:Ziwa.Application.Persistence"
             xmlns:controls="using:Ziwa.App.Controls"
             x:Class="Ziwa.App.Views.ProjectLibraryView"
             x:DataType="vm:MainWindowViewModel"
             FlowDirection="RightToLeft">
  <controls:StudioDialogShell Title="مكتبة المشاريع والبدء السريع"
                              CloseCommand="{Binding CloseProjectLibraryCommand}"
                              CloseToolTip="إغلاق المكتبة دون حذف لقطات التعافي (Esc)"
                              CloseAccessibleName="إغلاق المكتبة والاحتفاظ بالتعافي"
                              DialogWidth="780"
                              DialogMaxHeight="720">
    <StackPanel Spacing="12">
      <!-- البدء السريع من قالب -->
      <controls:StudioCard Header="مشروع جديد من قالب جاهز:" IsEnabled="{Binding IsProjectEditable}">
        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
          <Button x:Name="LibraryQuickIdSheetButton"
                  Classes="studioPrimary"
                  Command="{Binding StartQuickStartFromLibraryCommand}"
                  CommandParameter="quickstart.idPhotoSheet"
                  ToolTip.Tip="إنشاء شيت صور هوية 4×6 بوصة جاهز للطباعة (Alt+1)"
                  AutomationProperties.Name="قالب شيت صور هوية 4×6"
                  Content="شيت هوية 4×6" />
          <Button x:Name="LibraryQuickBusinessCardButton"
                  Classes="studioSubtle"
                  Command="{Binding StartQuickStartFromLibraryCommand}"
                  CommandParameter="quickstart.businessCard"
                  ToolTip.Tip="إنشاء مشروع بطاقة أعمال احترافية (Alt+2)"
                  AutomationProperties.Name="قالب بطاقة عمل"
                  Content="بطاقة عمل" />
          <Button x:Name="LibraryQuickStickerSheetButton"
                  Classes="studioSubtle"
                  Command="{Binding StartQuickStartFromLibraryCommand}"
                  CommandParameter="quickstart.stickerSheet"
                  ToolTip.Tip="إنشاء شيت ملصقات بارامتري A5 (Alt+3)"
                  AutomationProperties.Name="قالب شيت ملصقات"
                  Content="شيت ملصقات" />
          <Button x:Name="LibraryQuickBlankA4Button"
                  Classes="studioSubtle"
                  Command="{Binding StartQuickStartFromLibraryCommand}"
                  CommandParameter="quickstart.blankA4"
                  ToolTip.Tip="إنشاء صفحة تصميم حرة مقاس A4 (Alt+4)"
                  AutomationProperties.Name="قالب صفحة حرة A4"
                  Content="صفحة حرة A4" />
        </WrapPanel>
      </controls:StudioCard>

      <controls:StudioCard Header="عمل قابل للتعافي بعد إغلاق غير طبيعي"
                           IsVisible="{Binding HasRecoveries}"
                           AccentKind="Warning">
        <StackPanel Spacing="8">
          <ListBox x:Name="RecoveryList" ItemsSource="{Binding RecoveryEntries}" SelectedItem="{Binding SelectedRecovery}" MaxHeight="100">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="persist:RecoveryEntry">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="{Binding Title}" />
                  <TextBlock Text="{Binding CapturedAtUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding IsProjectEditable}">
            <Button Classes="studioPrimary" Content="استعادة العمل" Command="{Binding RestoreSelectedRecoveryCommand}"
                    ToolTip.Tip="استعادة اللقطة دون استبدال ملف المشروع الأصلي" AutomationProperties.Name="استعادة العمل" />
            <Button Classes="studioDestructive" Content="تجاهل لقطة التعافي…" Command="{Binding AskDiscardRecoveryCommand}"
                    ToolTip.Tip="طلب حذف لقطة التعافي المختارة بعد التأكيد" AutomationProperties.Name="طلب تجاهل لقطة التعافي" />
          </StackPanel>
        </StackPanel>
      </controls:StudioCard>

      <Grid ColumnDefinitions="*,240" ColumnSpacing="10">
        <TextBlock Grid.Column="0" Text="{Binding ProjectLibraryCountText}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
        <TextBox x:Name="ProjectLibrarySearchBox"
                 Grid.Column="1"
                 Text="{Binding ProjectLibrarySearchQuery}"
                 Watermark="ابحث باسم المشروع أو المسار..."
                 ToolTip.Tip="تصفية قائمة المشاريع المحفوظة"
                 AutomationProperties.Name="بحث في مكتبة المشاريع" />
      </Grid>

      <Grid>
        <ListBox x:Name="ProjectLibraryList"
                 ItemsSource="{Binding FilteredProjectEntries}"
                 SelectedItem="{Binding SelectedProject}"
                 DoubleTapped="OnProjectListDoubleTapped"
                 MinHeight="110"
                 MaxHeight="230">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="persist:ProjectLibraryEntry">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding SavedAtUtc, StringFormat='حُفظ: {0:yyyy-MM-dd HH:mm}'}"
                           FlowDirection="LeftToRight"
                           FontSize="11"
                           Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding Path}"
                           TextTrimming="CharacterEllipsis"
                           FontSize="11"
                           Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock IsVisible="{Binding HasNoFilteredProjects}"
                   Text="لا توجد مشاريع مطابقة أو محفوظة بعد — اختر قالباً للبدء أو افتح ملف .ziwa"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
      </Grid>

      <controls:StudioCard IsVisible="{Binding IsRecoveryDiscardConfirmationOpen}" AccentKind="Destructive">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding RecoveryDiscardTitle}" FontWeight="SemiBold" />
          <TextBlock Text="سيُحذف ملف التعافي المختار نهائياً. هذا لا يحذف ملف المشروع المحفوظ." TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding IsProjectEditable}">
            <Button Classes="studioDestructive" Content="حذف لقطة التعافي نهائياً" Command="{Binding ConfirmDiscardRecoveryCommand}"
                    ToolTip.Tip="تأكيد حذف لقطة التعافي المختارة" AutomationProperties.Name="تأكيد حذف لقطة التعافي نهائياً" />
            <Button Classes="studioSubtle" Content="إلغاء الحذف" Command="{Binding CancelDiscardRecoveryCommand}"
                    ToolTip.Tip="الاحتفاظ بلقطة التعافي" AutomationProperties.Name="إلغاء حذف لقطة التعافي" />
          </StackPanel>
        </StackPanel>
      </controls:StudioCard>
    </StackPanel>

    <controls:StudioDialogShell.FooterContent>
      <StackPanel Spacing="8">
        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" IsEnabled="{Binding IsProjectEditable}">
          <Button x:Name="OpenSelectedProjectButton"
                  Classes="studioPrimary"
                  Content="فتح المشروع المحدد"
                  Command="{Binding OpenSelectedProjectCommand}"
                  IsEnabled="{Binding HasSelectedProject}"
                  ToolTip.Tip="فتح المشروع المحدد مع حماية العمل غير المحفوظ"
                  AutomationProperties.Name="فتح المشروع المحدد" />
          <Button x:Name="RemoveSelectedProjectButton"
                  Classes="studioSubtle"
                  Content="إزالة من القائمة"
                  Command="{Binding RemoveSelectedProjectFromLibraryCommand}"
                  IsEnabled="{Binding HasSelectedProject}"
                  ToolTip.Tip="إزالة المرجع من فهرس المكتبة دون حذف الملف من القرص"
                  AutomationProperties.Name="إزالة المشروع من القائمة" />
          <Button Classes="studioSubtle" Content="فتح ملف آخر…" Command="{Binding OpenProjectCommand}"
                  ToolTip.Tip="اختيار ملف .ziwa" AutomationProperties.Name="فتح ملف مشروع آخر" />
          <Button Classes="studioSubtle" Content="تصدير نسخة احتياطية…" Command="{Binding ExportLibraryBackupCommand}"
                  ToolTip.Tip="نسخ المكتبة ومشاريعها إلى حزمة احتياطية" AutomationProperties.Name="تصدير نسخة احتياطية" />
          <Button Classes="studioSubtle" Content="استيراد نسخة احتياطية…" Command="{Binding ImportLibraryBackupCommand}"
                  ToolTip.Tip="استيراد مشاريع إلى مجلد مستقل دون استبدال الموجود" AutomationProperties.Name="استيراد نسخة احتياطية" />
        </WrapPanel>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                     FontSize="12" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
          <Button Grid.Column="1" Classes="studioDestructive" IsVisible="{Binding IsProjectBusy}" Command="{Binding CancelProjectOperationCommand}"
                  Content="إلغاء العملية" ToolTip.Tip="إلغاء عملية المشروع الحالية" AutomationProperties.Name="إلغاء عملية المكتبة" />
        </Grid>
      </StackPanel>
    </controls:StudioDialogShell.FooterContent>
  </controls:StudioDialogShell>
</UserControl>
