<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ziwa.App.ViewModels"
             x:Class="Ziwa.App.Views.Workspace.WindowTitleBarView"
             x:DataType="vm:MainWindowViewModel"
             Height="32">
  <Border x:Name="TitleBarDragRegion"
          Background="{DynamicResource ZiwaCardBrush}"
          BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
          BorderThickness="0,0,0,1"
          Padding="10,0"
          PointerPressed="OnTitleBarPointerPressed"
          DoubleTapped="OnTitleBarDoubleTapped">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsHitTestVisible="False">
        <Border Width="18" Height="18" CornerRadius="{StaticResource ControlCornerRadius}" Background="{DynamicResource ZiwaPrimaryActionBrush}">
          <TextBlock Text="Z" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}" />
        </Border>
        <TextBlock Text="{Binding ProjectWindowTitle}" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource ZiwaPrimaryTextBrush}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" MaxWidth="420" />
        <Ellipse x:Name="TitleUnsavedDot"
                 Width="6" Height="6"
                 VerticalAlignment="Center"
                 Fill="{DynamicResource ZiwaWarningBrush}"
                 IsVisible="{Binding HasUnsavedChanges}" />
      </StackPanel>

      <Border Grid.Column="1" Background="Transparent" />

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button x:Name="MinimizeWindowButton"
                Classes="workspaceAction iconOnly"
                Width="30" Height="24" MinWidth="30" MinHeight="24" Padding="0"
                Click="OnMinimizeClick"
                ToolTip.Tip="تصغير النافذة"
                AutomationProperties.Name="تصغير النافذة">
          <PathIcon Data="{DynamicResource IconWindowMinimize}" Width="12" Height="12" IsHitTestVisible="False" />
        </Button>
        <Button x:Name="MaximizeWindowButton"
                Classes="workspaceAction iconOnly"
                Width="30" Height="24" MinWidth="30" MinHeight="24" Padding="0"
                Click="OnMaximizeRestoreClick"
                ToolTip.Tip="تكبير أو استعادة النافذة"
                AutomationProperties.Name="تكبير أو استعادة النافذة">
          <PathIcon x:Name="MaximizeWindowIcon" Data="{DynamicResource IconWindowMaximize}" Width="11" Height="11" IsHitTestVisible="False" />
        </Button>
        <Button x:Name="CloseWindowButton"
                Classes="workspaceAction iconOnly windowClose"
                Width="30" Height="24" MinWidth="30" MinHeight="24" Padding="0"
                Click="OnCloseClick"
                ToolTip.Tip="إغلاق التطبيق"
                AutomationProperties.Name="إغلاق التطبيق">
          <PathIcon Data="{DynamicResource IconWindowClose}" Width="11" Height="11" IsHitTestVisible="False" />
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
