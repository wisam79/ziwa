<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ziwa.App.ViewModels"
             x:Class="Ziwa.App.Views.Workspace.CommandBarView"
             x:DataType="vm:MainWindowViewModel">
  <Border Background="{DynamicResource ZiwaCardBrush}"
          BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
          BorderThickness="0,0,0,1"
          Padding="{StaticResource ToolbarPadding}">
    <DockPanel>
      <StackPanel DockPanel.Dock="Left" Margin="0,0,8,0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button x:Name="ProjectFileMenuButton" Classes="workspaceAction"
                ToolTip.Tip="فتح وحفظ المشاريع ومكتبة المشاريع" AutomationProperties.Name="ملف المشروع">
          <StackPanel Classes="workspaceActionLabel">
            <PathIcon Classes="workspaceIcon" Data="{StaticResource IconFolder}" />
            <TextBlock Text="ملف" />
            <PathIcon Data="{StaticResource IconChevronDown}" Width="10" Height="10" IsHitTestVisible="False"
                      Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
          </StackPanel>
          <Button.Flyout>
            <Flyout>
              <StackPanel MinWidth="235" Spacing="2">
                <Button Classes="studioMenuItem" Click="OnProjectMenuItemClick" Command="{Binding OpenProjectCommand}"
                        ToolTip.Tip="فتح مشروع (Ctrl+O)" AutomationProperties.Name="فتح مشروع">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" Text="فتح مشروع…" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Classes="shortcutBadge">
                      <TextBlock Text="Ctrl+O" FontSize="10.5" FlowDirection="LeftToRight" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                    </Border>
                  </Grid>
                </Button>
                <Button Classes="studioMenuItem" Click="OnProjectMenuItemClick" Command="{Binding SaveProjectCommand}"
                        ToolTip.Tip="حفظ المشروع (Ctrl+S)" AutomationProperties.Name="حفظ المشروع">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" Text="حفظ" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Classes="shortcutBadge">
                      <TextBlock Text="Ctrl+S" FontSize="10.5" FlowDirection="LeftToRight" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                    </Border>
                  </Grid>
                </Button>
                <Button Classes="studioMenuItem" Click="OnProjectMenuItemClick" Command="{Binding SaveProjectAsCommand}"
                        ToolTip.Tip="حفظ باسم (Ctrl+Shift+S)" AutomationProperties.Name="حفظ المشروع باسم">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" Text="حفظ باسم…" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Classes="shortcutBadge">
                      <TextBlock Text="Ctrl+Shift+S" FontSize="10.5" FlowDirection="LeftToRight" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                    </Border>
                  </Grid>
                </Button>
                <Border Classes="studioDivider" Margin="4,3" />
                <Button Classes="studioMenuItem" Content="مكتبة المشاريع والتعافي" Click="OnProjectMenuItemClick" Command="{Binding OpenProjectLibraryCommand}"
                        ToolTip.Tip="عرض المشاريع الحديثة والتعافي" AutomationProperties.Name="مكتبة المشاريع والتعافي" />
                <Border Classes="studioDivider" Margin="4,3" />
                <Button Classes="studioMenuItem" Content="تصدير سجلات الدعم الفني…" Click="OnProjectMenuItemClick" Command="{Binding ExportSupportLogsCommand}"
                        ToolTip.Tip="تصدير أرشيف سجلات الدعم المنقّاة من البيانات الحساسة" AutomationProperties.Name="تصدير سجلات الدعم الفني" />
                <Button Classes="studioMenuItem" Content="التحقق من وجود تحديثات…" Click="OnProjectMenuItemClick" Command="{Binding OpenUpdateDialogCommand}"
                        ToolTip.Tip="فحص التحديثات والتحقق عبر HTTPS وSHA-256" AutomationProperties.Name="التحقق من وجود تحديثات" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button x:Name="QuickSaveButton" Classes="workspaceAction iconOnly" Command="{Binding SaveProjectCommand}"
                ToolTip.Tip="حفظ المشروع (Ctrl+S)" AutomationProperties.Name="حفظ سريع">
          <PathIcon Classes="workspaceIcon" Data="{StaticResource IconSave}" />
        </Button>
        <Button x:Name="UndoButton" Classes="workspaceAction iconOnly" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"
                ToolTip.Tip="{Binding UndoToolTipText}" AutomationProperties.Name="تراجع">
          <PathIcon Classes="workspaceIcon" Data="{StaticResource IconUndo}" />
        </Button>
        <Button x:Name="RedoButton" Classes="workspaceAction iconOnly" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"
                ToolTip.Tip="{Binding RedoToolTipText}" AutomationProperties.Name="إعادة">
          <PathIcon Classes="workspaceIcon" Data="{StaticResource IconRedo}" />
        </Button>
        <Border Classes="workspaceDivider" />
        <Button x:Name="TemplatesMenuButton" Classes="workspaceAction"
                ToolTip.Tip="قوالب البدء السريع" AutomationProperties.Name="قوالب البدء السريع">
          <StackPanel Classes="workspaceActionLabel">
            <PathIcon Classes="workspaceIcon" Data="{StaticResource IconTemplates}" />
            <TextBlock Text="قوالب" />
            <PathIcon Data="{StaticResource IconChevronDown}" Width="10" Height="10" IsHitTestVisible="False"
                      Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
          </StackPanel>
          <Button.Flyout>
            <Flyout>
              <StackPanel MinWidth="220" Spacing="2">
                <Button x:Name="QuickStartIdButton" Classes="studioMenuItem" Click="OnTemplateMenuItemClick" Command="{Binding StartIdPhotoSheetCommand}"
                        ToolTip.Tip="بدء سريع: شيت صور هوية 4×6 (Alt+1)" AutomationProperties.Name="شيت صور هوية">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" Text="شيت هوية 4×6" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Classes="shortcutBadge">
                      <TextBlock Text="Alt+1" FontSize="10.5" FlowDirection="LeftToRight" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                    </Border>
                  </Grid>
                </Button>
                <Button x:Name="QuickStartCardButton" Classes="studioMenuItem" Click="OnTemplateMenuItemClick" Command="{Binding StartBusinessCardCommand}"
                        ToolTip.Tip="بدء سريع: بطاقة عمل (Alt+2)" AutomationProperties.Name="بطاقة عمل">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" Text="بطاقة عمل" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Classes="shortcutBadge">
                      <TextBlock Text="Alt+2" FontSize="10.5" FlowDirection="LeftToRight" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                    </Border>
                  </Grid>
                </Button>
                <Button x:Name="QuickStartStickerButton" Classes="studioMenuItem" Click="OnTemplateMenuItemClick" Command="{Binding StartStickerSheetCommand}"
                        ToolTip.Tip="بدء سريع: شيت ملصقات بارامتري (Alt+3)" AutomationProperties.Name="شيت ملصقات">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" Text="شيت ملصقات" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Classes="shortcutBadge">
                      <TextBlock Text="Alt+3" FontSize="10.5" FlowDirection="LeftToRight" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                    </Border>
                  </Grid>
                </Button>
                <Button x:Name="QuickStartBlankA4Button" Classes="studioMenuItem" Click="OnTemplateMenuItemClick" Command="{Binding StartFreeformSheetCommand}"
                        ToolTip.Tip="صفحة تصميم حرة A4 (Alt+4)" AutomationProperties.Name="صفحة حرة A4">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" Text="صفحة حرة A4" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Classes="shortcutBadge">
                      <TextBlock Text="Alt+4" FontSize="10.5" FlowDirection="LeftToRight" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                    </Border>
                  </Grid>
                </Button>
                <Border Classes="studioDivider" Margin="4,3" />
                <Button x:Name="TransferToCollageButton" Classes="studioMenuItem" Click="OnTemplateMenuItemClick" Command="{Binding TransferFreeformToCollageCommand}"
                        ToolTip.Tip="نقل التصميم الحر إلى شيت الكولاج" AutomationProperties.Name="نقل إلى الكولاج">
                  <StackPanel Classes="workspaceActionLabel">
                    <PathIcon Classes="workspaceIcon" Data="{StaticResource IconCollage}" />
                    <TextBlock Text="نقل للكولاج" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>

      <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button x:Name="CommandPaletteButton" Classes="workspaceAction iconOnly" Command="{Binding ToggleCommandPaletteCommand}"
                ToolTip.Tip="البحث عن الأوامر (Ctrl+K)" AutomationProperties.Name="لوحة الأوامر">
          <PathIcon Classes="workspaceIcon" Data="{StaticResource IconSearch}" />
        </Button>
        <Border Classes="workspaceDivider" />
        <Border Background="{DynamicResource ZiwaSurfaceBrush}"
                BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                BorderThickness="{StaticResource HairlineBorderThickness}"
                CornerRadius="{StaticResource ControlCornerRadius}">
          <StackPanel Orientation="Horizontal" Spacing="0">
            <Button x:Name="ZoomOutButton" Classes="workspaceAction iconOnly" Command="{Binding ZoomOutCommand}"
                    ToolTip.Tip="تصغير المعاينة" AutomationProperties.Name="تصغير المعاينة">
              <PathIcon Classes="workspaceIcon" Data="{StaticResource IconMinus}" />
            </Button>
            <Button x:Name="ResetZoomButton" Classes="workspaceAction zoomReadout" Command="{Binding ResetZoomCommand}"
                    ToolTip.Tip="إعادة التكبير إلى 100% (Ctrl+1)" AutomationProperties.Name="إعادة التكبير إلى 100%">
              <TextBlock Text="{Binding ZoomPercentText}" FlowDirection="LeftToRight" FontSize="12" FontWeight="SemiBold" />
            </Button>
            <Button x:Name="ZoomInButton" Classes="workspaceAction iconOnly" Command="{Binding ZoomInCommand}"
                    ToolTip.Tip="تكبير المعاينة" AutomationProperties.Name="تكبير المعاينة">
              <PathIcon Classes="workspaceIcon" Data="{StaticResource IconPlus}" />
            </Button>
          </StackPanel>
        </Border>
        <Button x:Name="FitPageButton" Classes="workspaceAction iconOnly" Command="{Binding FitPageCommand}"
                ToolTip.Tip="ملاءمة الصفحة (Ctrl+0)" AutomationProperties.Name="ملاءمة الصفحة">
          <PathIcon Classes="workspaceIcon" Data="{StaticResource IconFitPage}" />
        </Button>
        <Button x:Name="ZenModeButton" Classes="workspaceAction iconOnly" Command="{Binding ToggleZenModeCommand}"
                ToolTip.Tip="وضع التركيز الكامل (Ctrl+.)" AutomationProperties.Name="وضع التركيز">
          <PathIcon Classes="workspaceIcon" Data="{StaticResource IconFocus}" />
        </Button>
        <Border Classes="workspaceDivider" />
        <Button x:Name="ThemeToggleButton" Classes="workspaceAction iconOnly" Command="{Binding ToggleThemeCommand}"
                ToolTip.Tip="{Binding ThemeToggleText}" AutomationProperties.Name="{Binding ThemeToggleText}">
          <Grid>
            <PathIcon Classes="workspaceIcon" Data="{StaticResource IconSun}" IsVisible="{Binding IsDarkTheme}" />
            <PathIcon Classes="workspaceIcon" Data="{StaticResource IconMoon}" IsVisible="{Binding !IsDarkTheme}" />
          </Grid>
        </Button>
        <Button x:Name="AccountHeaderButton" Classes="workspaceAction" Command="{Binding OpenAccountDialogCommand}"
                ToolTip.Tip="{Binding AccountHeaderBadgeText}" AutomationProperties.Name="الحساب والترخيص (Ctrl+Shift+A)">
          <StackPanel Classes="workspaceActionLabel">
            <PathIcon Classes="workspaceIcon" Data="{StaticResource IconAccount}" />
            <TextBlock Text="{Binding AccountHeaderBadgeText}" MaxWidth="78" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
        <Border Classes="workspaceDivider" />
        <Button x:Name="PrintDialogButton" Classes="workspaceAction" Command="{Binding OpenPrintDialogCommand}"
                ToolTip.Tip="الطباعة المباشرة وتصدير PDF وCMYK (Ctrl+P)" AutomationProperties.Name="طباعة وتصدير احترافي">
          <StackPanel Classes="workspaceActionLabel">
            <PathIcon Classes="workspaceIcon" Data="{StaticResource IconPrinter}" />
            <TextBlock Text="طباعة وPDF" />
          </StackPanel>
        </Button>
        <Button x:Name="Export300DpiButton" Classes="workspaceAction primary" Command="{Binding ExportSample300DpiCommand}"
                ToolTip.Tip="تصدير الورقة النشطة بدقة 300 DPI (Ctrl+E)" AutomationProperties.Name="تصدير الورقة النشطة بدقة 300 DPI">
          <StackPanel Classes="workspaceActionLabel">
            <PathIcon Classes="workspaceIcon" Data="{StaticResource IconExport}" />
            <TextBlock Text="تصدير 300 DPI" />
          </StackPanel>
        </Button>
      </StackPanel>
      <TextBlock x:Name="DocumentTitleLabel" Text="{Binding DocumentTitle}" ToolTip.Tip="{Binding DocumentTitle}"
                 MaxWidth="200" TextTrimming="CharacterEllipsis" FontSize="{StaticResource WorkspaceTitleSize}"
                 FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </DockPanel>
  </Border>
</UserControl>
