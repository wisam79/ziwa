<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ziwa.App.ViewModels"
             xmlns:local="using:Ziwa.App.Views.Inspector"
             x:Class="Ziwa.App.Views.Inspector.InspectorPanelView"
             x:DataType="vm:MainWindowViewModel"
             FlowDirection="RightToLeft">
  <UserControl.Styles>
    <StyleInclude Source="avares://Ziwa.App/Themes/InspectorStyles.axaml" />
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource ZiwaSurfaceBrush}">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="12,4,8,0">
      <TextBlock Text="المفتش" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Button x:Name="InspectorWarningsButton" Grid.Column="1" Classes="workspaceAction"
              IsVisible="{Binding HasPreflightWarnings}" Command="{Binding ShowInspectorWarningsCommand}"
              ToolTip.Tip="{Binding PreflightSummaryText}" AutomationProperties.Name="{Binding PreflightSummaryText}">
        <StackPanel Classes="workspaceActionLabel">
          <PathIcon Classes="workspaceIcon" Data="{StaticResource IconWarning}" Foreground="{DynamicResource ZiwaWarningBrush}" />
          <TextBlock Text="{Binding PreflightIssues.Count}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button x:Name="CloseInspectorButton" Grid.Column="2" Classes="workspaceAction iconOnly"
              Command="{Binding CloseInspectorCommand}" ToolTip.Tip="طي المفتش (Ctrl+I)" AutomationProperties.Name="طي المفتش">
        <PathIcon Classes="workspaceIcon" Data="{StaticResource IconWindowClose}" />
      </Button>
    </Grid>
    <TabControl x:Name="InspectorTabs" Grid.Row="1" Padding="0" Background="{DynamicResource ZiwaSurfaceBrush}"
                SelectedIndex="{Binding InspectorTabIndex, Mode=TwoWay}" AutomationProperties.Name="أقسام المفتش">
      <TabControl.ItemsPanel>
        <ItemsPanelTemplate><UniformGrid Rows="1" Columns="3" /></ItemsPanelTemplate>
      </TabControl.ItemsPanel>
      <TabItem x:Name="PropertiesTab" Header="خصائص" AutomationProperties.Name="خصائص التحديد">
        <local:InspectorPropertiesView />
      </TabItem>
      <TabItem x:Name="LayersTab" Header="طبقات" AutomationProperties.Name="طبقات الصفحة">
        <local:InspectorLayersView />
      </TabItem>
      <TabItem x:Name="PageTab" Header="صفحة" AutomationProperties.Name="إعدادات الصفحة">
        <local:InspectorPageView x:Name="PageSettings" />
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
