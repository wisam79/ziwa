<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ziwa.App.ViewModels"
             xmlns:prep="using:Ziwa.Domain.PrePress"
             xmlns:controls="using:Ziwa.App.Controls"
             x:Class="Ziwa.App.Views.Inspector.InspectorPanelView"
             x:DataType="vm:MainWindowViewModel"
             FlowDirection="RightToLeft">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Border Padding="{StaticResource InspectorPadding}">
      <StackPanel Spacing="10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Text="مفتش الورقة والمشهد"
                   FontSize="15"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
        <Button x:Name="CloseInspectorButton"
                Grid.Column="1"
                Classes="workspaceAction iconOnly"
                Command="{Binding CloseInspectorCommand}"
                ToolTip.Tip="طي لوح المفتش"
                AutomationProperties.Name="طي المفتش"
                Content="✕" />
      </Grid>

      <controls:StudioCard>
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding SelectionSummary}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
          <TextBlock Text="{Binding PageSizeMmText}"
                     FlowDirection="LeftToRight"
                     HorizontalAlignment="Right"
                     FontSize="12"
                     Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
          <TextBlock Text="{Binding EffectiveDpiText}"
                     FlowDirection="LeftToRight"
                     HorizontalAlignment="Right"
                     FontSize="12"
                     Foreground="{DynamicResource ZiwaInfoBrush}" />
        </StackPanel>
      </controls:StudioCard>

      <!-- فاحص ما قبل الطباعة -->
      <controls:StudioCard x:Name="PreflightCard"
                           IsVisible="{Binding HasPreflightWarnings}"
                           Header="{Binding PreflightSummaryText}"
                           AccentKind="Warning">
        <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding PreflightIssues}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="prep:PreflightIssue">
                <Button Margin="0,0,0,4"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectPreflightIssueCommand}"
                        CommandParameter="{Binding}"
                        MinHeight="{StaticResource CompactButtonSize}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource ZiwaCardBrush}"
                        Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                        BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                        BorderThickness="{StaticResource HairlineBorderThickness}"
                        ToolTip.Tip="{Binding MessageAr}"
                        AutomationProperties.Name="{Binding MessageAr}">
                  <TextBlock Text="{Binding MessageAr}"
                             FontSize="11"
                             TextWrapping="Wrap" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </controls:StudioCard>

      <!-- سياقية الملصق أولاً (FF-05) -->
      <controls:StudioCard x:Name="StickerInspectorCard"
                           IsVisible="{Binding IsStickerSelected}"
                           Header="إجراءات الملصق البارامتري"
                           AccentKind="Focus">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0"
                       Text="{Binding SelectedStickerTemplateTitle}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Border Width="14" Height="14" CornerRadius="3" Background="{Binding SelectedStickerPrimaryBrush}" BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}" BorderThickness="1" />
              <Border Width="14" Height="14" CornerRadius="3" Background="{Binding SelectedStickerSecondaryBrush}" BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}" BorderThickness="1" />
              <Border Width="14" Height="14" CornerRadius="3" Background="{Binding SelectedStickerAccentBrush}" BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}" BorderThickness="1" />
              <Border Width="14" Height="14" CornerRadius="3" Background="{Binding SelectedStickerSurfaceBrush}" BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}" BorderThickness="1" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,6,*" ColumnSpacing="0">
            <Button x:Name="InspectorEditStickerButton"
                    Grid.Column="0"
                    Classes="studioPrimary"
                    HorizontalAlignment="Stretch"
                    Command="{Binding EditSelectedStickerCommand}"
                    ToolTip.Tip="فتح استوديو الملصق لتعديله في مكانه"
                    AutomationProperties.Name="تعديل الملصق في مكانه"
                    Content="تعديل الملصق" />
            <Button x:Name="InspectorRandomStickerPaletteButton"
                    Grid.Column="2"
                    Classes="studioSubtle"
                    HorizontalAlignment="Stretch"
                    Command="{Binding RandomizeSelectedStickerPaletteCommand}"
                    ToolTip.Tip="اشتقاق ألوان جديدة في فضاء OKLCH"
                    AutomationProperties.Name="توليفة ألوان OKLCH"
                    Content="توليفة ذكية" />
          </Grid>
        </StackPanel>
      </controls:StudioCard>

      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasSelection}">
        <Button x:Name="GroupButton"
                Classes="studioSubtle"
                Command="{Binding GroupCommand}"
                IsVisible="{Binding CanGroup}"
                ToolTip.Tip="تجميع العناصر المحددة (Ctrl+G)"
                AutomationProperties.Name="تجميع العناصر المحددة"
                Content="تجميع" />
        <Button x:Name="UngroupButton"
                Classes="studioSubtle"
                Command="{Binding UngroupCommand}"
                IsVisible="{Binding CanUngroup}"
                ToolTip.Tip="فك التجميع (Ctrl+Shift+G)"
                AutomationProperties.Name="فك التجميع"
                Content="فك التجميع" />
        <Button x:Name="MaskWithShapeButton"
                Classes="studioPrimary"
                Command="{Binding MaskWithShapeCommand}"
                IsVisible="{Binding CanMaskImageWithShape}"
                ToolTip.Tip="قنّع الصورة بهذا الشكل"
                AutomationProperties.Name="قنّع الصورة بهذا الشكل"
                Content="قنّع بالشكل" />
      </StackPanel>

      <!-- بطاقة الموقع والأبعاد الرقمية والمحاذاة للورقة -->
      <controls:StudioCard x:Name="TransformAndAlignCard"
                           IsVisible="{Binding HasSelection}"
                           Header="الموقع والأبعاد والمحاذاة (مم)">
        <StackPanel Spacing="8">
          <UniformGrid Columns="3" Rows="2" ColumnSpacing="4" RowSpacing="4">
            <Button x:Name="AlignRightPageButton" Classes="studioSegment" HorizontalAlignment="Stretch"
                    Command="{Binding AlignSelectionRightCommand}"
                    ToolTip.Tip="محاذاة مع حافة الورقة اليمنى" AutomationProperties.Name="محاذاة يمين الورقة" Content="يمين" />
            <Button x:Name="AlignCenterHPageButton" Classes="studioSegment" HorizontalAlignment="Stretch"
                    Command="{Binding AlignSelectionCenterHCommand}"
                    ToolTip.Tip="توسيط أفقي في منتصف الورقة" AutomationProperties.Name="توسيط أفقي" Content="توسيط ↔" />
            <Button x:Name="AlignLeftPageButton" Classes="studioSegment" HorizontalAlignment="Stretch"
                    Command="{Binding AlignSelectionLeftCommand}"
                    ToolTip.Tip="محاذاة مع حافة الورقة اليسرى" AutomationProperties.Name="محاذاة يسار الورقة" Content="يسار" />
            <Button x:Name="AlignTopPageButton" Classes="studioSegment" HorizontalAlignment="Stretch"
                    Command="{Binding AlignSelectionTopCommand}"
                    ToolTip.Tip="محاذاة مع أعلى الورقة" AutomationProperties.Name="محاذاة أعلى الورقة" Content="أعلى" />
            <Button x:Name="AlignCenterVPageButton" Classes="studioSegment" HorizontalAlignment="Stretch"
                    Command="{Binding AlignSelectionCenterVCommand}"
                    ToolTip.Tip="توسيط رأسي في منتصف الورقة" AutomationProperties.Name="توسيط رأسي" Content="توسيط ↕" />
            <Button x:Name="AlignBottomPageButton" Classes="studioSegment" HorizontalAlignment="Stretch"
                    Command="{Binding AlignSelectionBottomCommand}"
                    ToolTip.Tip="محاذاة مع أسفل الورقة" AutomationProperties.Name="محاذاة أسفل الورقة" Content="أسفل" />
          </UniformGrid>

          <StackPanel Spacing="8" IsVisible="{Binding IsSingleNodeSelected}">
            <Grid ColumnDefinitions="*,6,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
              <controls:StudioNumberField Grid.Row="0" Grid.Column="0" Label="الموقع س (X)" Unit="مم"
                                          Increment="0.5" FormatString="0.#" Value="{Binding SelectedNodeXMm}"
                                          ToolTip.Tip="الإحداثي الأفقي بالمليمتر" AccessibleName="الإحداثي الأفقي X" />
              <controls:StudioNumberField Grid.Row="0" Grid.Column="2" Label="الموقع ص (Y)" Unit="مم"
                                          Increment="0.5" FormatString="0.#" Value="{Binding SelectedNodeYMm}"
                                          ToolTip.Tip="الإحداثي الرأسي بالمليمتر" AccessibleName="الإحداثي الرأسي Y" />
              <controls:StudioNumberField Grid.Row="1" Grid.Column="0" Label="العرض" Unit="مم"
                                          Minimum="2" Maximum="2000" Increment="1" FormatString="0.#" Value="{Binding SelectedNodeWidthMm}"
                                          ToolTip.Tip="عرض العنصر بالمليمتر" AccessibleName="عرض العنصر" />
              <controls:StudioNumberField Grid.Row="1" Grid.Column="2" Label="الارتفاع" Unit="مم"
                                          Minimum="2" Maximum="2000" Increment="1" FormatString="0.#" Value="{Binding SelectedNodeHeightMm}"
                                          ToolTip.Tip="ارتفاع العنصر بالمليمتر" AccessibleName="ارتفاع العنصر" />
              <controls:StudioNumberField Grid.Row="2" Grid.Column="0" Label="الدوران" Unit="°"
                                          Minimum="0" Maximum="360" Increment="5" FormatString="0.#" Value="{Binding SelectedNodeRotationDeg}"
                                          ToolTip.Tip="زاوية الدوران بالدرجات" AccessibleName="زاوية الدوران" />
              <controls:StudioNumberField Grid.Row="2" Grid.Column="2" Label="الشفافية" Unit="%"
                                          Minimum="5" Maximum="100" Increment="5" FormatString="0" Value="{Binding SelectedNodeOpacityPercent}"
                                          ToolTip.Tip="شفافية العنصر المحدد" AccessibleName="شفافية العنصر" />
            </Grid>
            <Button x:Name="ApplyNumericTransformButton"
                    Classes="studioPrimary"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ApplyNumericTransformCommand}"
                    ToolTip.Tip="تطبيق القيم الرقمية للموقع والأبعاد والدوران"
                    AutomationProperties.Name="تطبيق الأبعاد والموقع"
                    Content="تطبيق الأبعاد والموقع" />
          </StackPanel>
        </StackPanel>
      </controls:StudioCard>

      <!-- أدوات الصورة والمرشحات والذكاء الاصطناعي -->
      <StackPanel x:Name="PhotoAndFilterToolsPanel" Spacing="8" IsVisible="{Binding IsPhotoToolsVisible}">
        <controls:StudioCard x:Name="OfflineAiCard"
                             IsVisible="{Binding IsPhotoAiTargetVisible}"
                             Header="الذكاء الاصطناعي المحلي (أوفلاين)">
          <StackPanel Spacing="6">
            <Button x:Name="InspectorRemoveBgButton"
                    Classes="studioPrimary"
                    HorizontalAlignment="Stretch"
                    Command="{Binding RemoveBackgroundCommand}"
                    IsEnabled="{Binding IsAllAiIdle}"
                    ToolTip.Tip="عزل الخلفية محلياً عبر ONNX مع حفظ تفاصيل الشعر (Ctrl+Shift+B)"
                    AutomationProperties.Name="عزل الخلفية تلقائياً"
                    Content="عزل الخلفية تلقائياً" />
            <Button x:Name="InspectorEditMaskButton"
                    Classes="studioSubtle"
                    HorizontalAlignment="Stretch"
                    Command="{Binding OpenMaskEditorCommand}"
                    IsEnabled="{Binding IsAllAiIdle}"
                    ToolTip.Tip="فتح محرر القناع اليدوي بفرشاة المسح والاستعادة ومعاينة قبل/بعد"
                    AutomationProperties.Name="تعديل القناع بالفرشاة"
                    Content="تعديل القناع بالفرشاة (قبل/بعد)" />
            <TextBlock Text="معيار تأطير الوجه للهوية"
                       FontSize="11"
                       Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
            <ComboBox x:Name="FramingPresetComboBox"
                      ItemsSource="{Binding AvailableFramingPresets}"
                      SelectedItem="{Binding SelectedFramingPresetOption}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:IdPhotoFramingPresetOption">
                  <TextBlock Text="{Binding TitleAr}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="InspectorAutoFrameFaceButton"
                    Classes="studioSubtle"
                    HorizontalAlignment="Stretch"
                    Command="{Binding AutoFrameFaceCommand}"
                    IsEnabled="{Binding IsAllAiIdle}"
                    ToolTip.Tip="توسيط الرأس والكتفين تلقائياً وفق نسب صور الهوية (Ctrl+Shift+F)"
                    AutomationProperties.Name="تأطير الوجه لصور الهوية"
                    Content="تأطير الوجه لصور الهوية" />
            <Button x:Name="InspectorOpenScannerButton"
                    Classes="studioSubtle"
                    HorizontalAlignment="Stretch"
                    Command="{Binding OpenDocumentScannerCommand}"
                    IsEnabled="{Binding IsScannerToolsEnabled}"
                    ToolTip.Tip="فتح ماسح المستندات والبطاقات واستعدال المنظور (Ctrl+Shift+D)"
                    AutomationProperties.Name="ماسح المستندات والبطاقات"
                    Content="ماسح المستندات والمنظور" />
            <StackPanel x:Name="AiWaitPanel" Spacing="4" IsVisible="{Binding IsAiBusy}">
              <ProgressBar IsIndeterminate="True" Minimum="0" Maximum="100" />
              <TextBlock Text="{Binding AiBusyStatusText}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource ZiwaInfoBrush}" />
              <Button x:Name="CancelAiOperationButton"
                      Classes="studioDestructive"
                      HorizontalAlignment="Stretch"
                      Command="{Binding CancelAiOperationCommand}"
                      ToolTip.Tip="إلغاء عملية الذكاء الاصطناعي الجارية فوراً"
                      AutomationProperties.Name="إلغاء الاستدلال المحلي"
                      Content="إلغاء الاستدلال" />
            </StackPanel>
          </StackPanel>
        </controls:StudioCard>

        <controls:StudioCard x:Name="CloudAiCard"
                             IsVisible="{Binding IsPhotoAiTargetVisible}"
                             Header="الترميم السحابي (Modal 2x)">
          <controls:StudioCard.HeaderBadge>
            <Border Background="{DynamicResource ZiwaSubtleFillBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Padding="6,2">
              <TextBlock x:Name="CloudQuotaBadgeTextBlock"
                         Text="{Binding CloudQuotaBadgeText}"
                         FontSize="10"
                         Foreground="{DynamicResource ZiwaInfoBrush}" />
            </Border>
          </controls:StudioCard.HeaderBadge>
          <StackPanel Spacing="6">
            <Button x:Name="InspectorCloudEnhanceButton"
                    Classes="studioPrimary"
                    HorizontalAlignment="Stretch"
                    Command="{Binding EnhancePhotoCloudCommand}"
                    IsEnabled="{Binding IsAllAiIdle}"
                    ToolTip.Tip="ترميم الوجوه بـ CodeFormer ومضاعفة الدقة 2x عبر Modal CPU (Ctrl+Shift+U)"
                    AutomationProperties.Name="ترميم الوجوه ومضاعفة الدقة 2x"
                    Content="ترميم الوجوه ومضاعفة الدقة 2x" />
            <StackPanel x:Name="CloudAiWaitPanel" Spacing="4" IsVisible="{Binding IsCloudAiBusy}">
              <ProgressBar IsIndeterminate="True" Minimum="0" Maximum="100" />
              <TextBlock Text="{Binding CloudAiBusyStatusText}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource ZiwaInfoBrush}" />
              <Button x:Name="CancelCloudAiButton"
                      Classes="studioDestructive"
                      HorizontalAlignment="Stretch"
                      Command="{Binding CancelCloudAiOperationCommand}"
                      ToolTip.Tip="إلغاء الترميم السحابي فوراً دون إعادة محاولة"
                      AutomationProperties.Name="إلغاء الترميم السحابي"
                      Content="إلغاء الترميم السحابي" />
            </StackPanel>
          </StackPanel>
        </controls:StudioCard>

        <controls:StudioCard Header="مرشحات الصورة والقناع">
          <StackPanel Spacing="8">
            <ComboBox x:Name="FilterPresetComboBox"
                      ItemsSource="{Binding AvailableFilterPresetOptions}"
                      SelectedItem="{Binding SelectedFilterPresetOption}"
                      HorizontalAlignment="Stretch"
                      ToolTip.Tip="اختيار مرشح لوني جاهز للصورة"
                      AutomationProperties.Name="مرشح الصورة الجاهز">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterPresetOption">
                  <TextBlock Text="{Binding TitleAr}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <controls:StudioSliderRow x:Name="FilterBrightnessSlider"
                                      Label="سطوع"
                                      Minimum="-1" Maximum="1" TickFrequency="0.05" DefaultValue="0"
                                      DisplayScale="100" DisplayFormat="+0;-0;0" Unit="%"
                                      Value="{Binding FilterBrightness}" />
            <controls:StudioSliderRow x:Name="FilterContrastSlider"
                                      Label="تباين"
                                      Minimum="-1" Maximum="1" TickFrequency="0.05" DefaultValue="0"
                                      DisplayScale="100" DisplayFormat="+0;-0;0" Unit="%"
                                      Value="{Binding FilterContrast}" />
            <controls:StudioSliderRow x:Name="FilterSaturationSlider"
                                      Label="تشبع"
                                      Minimum="-1" Maximum="1" TickFrequency="0.05" DefaultValue="0"
                                      DisplayScale="100" DisplayFormat="+0;-0;0" Unit="%"
                                      Value="{Binding FilterSaturation}" />
            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
              <Button x:Name="ApplyFilterButton"
                      Classes="studioPrimary"
                      Command="{Binding ApplyImageFiltersCommand}"
                      ToolTip.Tip="تطبيق المرشح على الصورة أو الخانة"
                      AutomationProperties.Name="تطبيق المرشح"
                      Content="تطبيق" />
              <Button x:Name="ApplyFilterAllSlotsButton"
                      Classes="studioSubtle"
                      Command="{Binding ApplyFiltersToAllSlotsCommand}"
                      IsVisible="{Binding IsCollageMode}"
                      ToolTip.Tip="تطبيق على كل الخانات"
                      AutomationProperties.Name="تطبيق على كل الخانات"
                      Content="على كل الخانات" />
              <Button x:Name="ResetFilterButton"
                      Classes="studioSubtle"
                      Command="{Binding ResetImageOrSlotFiltersCommand}"
                      ToolTip.Tip="إعادة تعيين المرشحات"
                      AutomationProperties.Name="إعادة تعيين المرشح"
                      Content="إعادة تعيين" />
            </WrapPanel>
            <Button x:Name="RestoreOriginalImageButton"
                    Classes="studioSubtle"
                    HorizontalAlignment="Stretch"
                    Command="{Binding RestoreOriginalImageCommand}"
                    IsVisible="{Binding CanRestoreOriginalTarget}"
                    ToolTip.Tip="استعادة الصورة الأصلية وإلغاء العزل والقص"
                    AutomationProperties.Name="استعادة الأصل"
                    Content="استعادة الأصل" />
            <Border Classes="studioDivider" />
            <TextBlock Text="قناع وزاوية الصورة" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
            <ComboBox x:Name="ImageMaskComboBox"
                      ItemsSource="{Binding AvailableMaskOptions}"
                      SelectedItem="{Binding SelectedMaskOption}"
                      HorizontalAlignment="Stretch"
                      ToolTip.Tip="اختيار شكل قناع قص غير هدام للصورة أو خانة الكولاج"
                      AutomationProperties.Name="قناع الصورة">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MaskOption">
                  <TextBlock Text="{Binding TitleAr}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="ApplyMaskAllSlotsButton"
                    Classes="studioSubtle"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ApplyMaskToAllSlotsCommand}"
                    IsVisible="{Binding IsCollageMode}"
                    ToolTip.Tip="تطبيق شكل القناع على جميع خانات شيت الكولاج"
                    AutomationProperties.Name="تعميم القناع على كل الخانات"
                    Content="تعميم القناع لكل الخانات" />
          </StackPanel>
        </controls:StudioCard>
      </StackPanel>

      <!-- زوايا وإطار خانة الكولاج -->
      <controls:StudioCard IsVisible="{Binding IsCollageSlotSelected}" Header="إطار وزوايا الخانة (مم)">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,6,*" RowDefinitions="Auto,Auto" RowSpacing="6">
            <controls:StudioNumberField x:Name="CollageSlotCornerRadiusInput"
                                        Grid.Row="0" Grid.Column="0"
                                        Label="تدوير الزوايا" Unit="مم"
                                        Minimum="0" Maximum="25" Increment="0.5" FormatString="0.#"
                                        Value="{Binding CollageSlotCornerRadiusMm}"
                                        ToolTip.Tip="نصف قطر استدارة زوايا الخانة بالمليمتر"
                                        AccessibleName="استدارة زوايا الخانة" />
            <controls:StudioNumberField x:Name="CollageSlotBorderWidthInput"
                                        Grid.Row="0" Grid.Column="2"
                                        Label="سمك الإطار" Unit="مم"
                                        Minimum="0" Maximum="10" Increment="0.2" FormatString="0.#"
                                        Value="{Binding CollageSlotBorderWidthMm}"
                                        ToolTip.Tip="سمك إطار خانة الكولاج بالمليمتر (0 لإلغاء الإطار)"
                                        AccessibleName="سمك إطار الخانة" />
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8">
              <TextBlock Text="لون الإطار:" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
              <ColorPicker x:Name="CollageSlotBorderColorPicker"
                           Color="{Binding CollageSlotBorderColor}"
                           ToolTip.Tip="اختيار لون إطار خانة الكولاج"
                           AutomationProperties.Name="لون إطار الخانة" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,6,*">
            <Button x:Name="ApplySlotStyleButton"
                    Grid.Column="0"
                    Classes="studioPrimary"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ApplySlotStyleCommand}"
                    ToolTip.Tip="تطبيق استدارة الزوايا والإطار على الخانة المحددة"
                    AutomationProperties.Name="تطبيق نمط الخانة"
                    Content="تطبيق الإطار" />
            <Button x:Name="ApplySlotStyleAllButton"
                    Grid.Column="2"
                    Classes="studioSubtle"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ApplySlotStyleToAllCommand}"
                    ToolTip.Tip="تعميم الزوايا والإطار على جميع خانات الشيت"
                    AutomationProperties.Name="تعميم الإطار على كل الخانات"
                    Content="لكل الخانات" />
          </Grid>
        </StackPanel>
      </controls:StudioCard>

      <!-- الشعار المتجه -->
      <controls:StudioCard IsVisible="{Binding IsSvgSelected}" Header="لون الشعار المتجه">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
          <ColorPicker x:Name="SvgTintColorPicker" Grid.Column="0" Color="{Binding SelectedSvgTintColor}"
                       ToolTip.Tip="اختيار لون تلوين الشعار" AutomationProperties.Name="لون الشعار" />
          <Button x:Name="ToggleSvgTintButton"
                  Grid.Column="1"
                  Classes="studioPrimary"
                  HorizontalAlignment="Stretch"
                  Command="{Binding ToggleSvgTintCommand}"
                  ToolTip.Tip="تلوين الشعار المتجه بضغطة واحدة"
                  AutomationProperties.Name="تلوين الشعار"
                  Content="تلوين سريع" />
          <Button x:Name="ClearSvgTintButton"
                  Grid.Column="2"
                  Classes="studioSubtle"
                  Command="{Binding ClearSvgTintCommand}"
                  ToolTip.Tip="استعادة ألوان الشعار الأصلية"
                  AutomationProperties.Name="إزالة تلوين الشعار"
                  Content="أصلي" />
        </Grid>
      </controls:StudioCard>

      <!-- الشكل الهندسي -->
      <controls:StudioCard IsVisible="{Binding IsShapeSelected}" Header="مظهر الشكل الهندسي والحدود">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <ColorPicker x:Name="ShapeFillColorPicker" Grid.Column="0" Color="{Binding SelectedShapeFillColor}"
                         ToolTip.Tip="اختيار لون تعبئة الشكل" AutomationProperties.Name="لون الشكل" />
            <controls:StudioSliderRow x:Name="ShapeOpacitySlider"
                                      Grid.Column="1"
                                      Label="الشفافية"
                                      Minimum="10" Maximum="100" TickFrequency="5" DefaultValue="100"
                                      DisplayFormat="0" Unit="%"
                                      Value="{Binding SelectedShapeOpacityPercent}" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <ColorPicker x:Name="ShapeStrokeColorPicker" Grid.Column="0" Color="{Binding SelectedShapeStrokeColor}"
                         ToolTip.Tip="لون حدود الشكل أو الخط" AutomationProperties.Name="لون حدود الشكل" />
            <controls:StudioNumberField x:Name="ShapeStrokeWidthNumeric"
                                        Grid.Column="1"
                                        Label="سُمك الحدود" Unit="مم"
                                        Minimum="0" Maximum="20" Increment="0.2" FormatString="0.#"
                                        Value="{Binding SelectedShapeStrokeWidthMm}"
                                        ToolTip.Tip="سُمك حدود الشكل بالمليمتر (0 لإلغاء الحدود)"
                                        AccessibleName="سُمك حدود الشكل" />
          </Grid>
          <Button x:Name="ApplyShapeStyleButton"
                  Classes="studioPrimary"
                  HorizontalAlignment="Stretch"
                  Command="{Binding ApplySelectedShapeStyleCommand}"
                  ToolTip.Tip="تطبيق التعبئة والحدود والشفافية على الشكل المحدد"
                  AutomationProperties.Name="تطبيق نمط الشكل"
                  Content="تطبيق نمط الشكل" />
        </StackPanel>
      </controls:StudioCard>

      <!-- النص والانحناء والتأثيرات -->
      <controls:StudioCard IsVisible="{Binding IsTextSelected}" Header="تحرير وتنسيق النص والانحناء">
        <StackPanel Spacing="8">
          <TextBox Text="{Binding SelectedTextContent}"
                   AcceptsReturn="True"
                   MinHeight="56" />
          <Grid ColumnDefinitions="Auto,*,74" ColumnSpacing="6">
            <ColorPicker x:Name="TextColorPicker" Grid.Column="0" Color="{Binding SelectedTextColor}"
                         ToolTip.Tip="لون النص" AutomationProperties.Name="لون النص" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFontFamilies}" SelectedItem="{Binding SelectedTextFontFamily}"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ToolTip.Tip="اختيار نوع الخط" AutomationProperties.Name="نوع الخط" />
            <controls:StudioNumberField Grid.Column="2" Unit="pt"
                                        Minimum="6" Maximum="240" Increment="2" FormatString="0"
                                        Value="{Binding SelectedTextFontSizePt}"
                                        ToolTip.Tip="حجم الخط بالنقاط" AccessibleName="حجم الخط" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <UniformGrid Grid.Column="0" Columns="3" ColumnSpacing="4">
              <Button x:Name="AlignTextRightButton" Classes="studioSegment" Classes.active="{Binding IsTextAlignRight}"
                      HorizontalAlignment="Stretch" Command="{Binding AlignTextRightCommand}"
                      ToolTip.Tip="محاذاة النص لليمين" AutomationProperties.Name="محاذاة النص يمين" Content="يمين" />
              <Button x:Name="AlignTextCenterButton" Classes="studioSegment" Classes.active="{Binding IsTextAlignCenter}"
                      HorizontalAlignment="Stretch" Command="{Binding AlignTextCenterCommand}"
                      ToolTip.Tip="توسيط النص" AutomationProperties.Name="توسيط النص" Content="وسط" />
              <Button x:Name="AlignTextLeftButton" Classes="studioSegment" Classes.active="{Binding IsTextAlignLeft}"
                      HorizontalAlignment="Stretch" Command="{Binding AlignTextLeftCommand}"
                      ToolTip.Tip="محاذاة النص لليسار" AutomationProperties.Name="محاذاة النص يسار" Content="يسار" />
            </UniformGrid>
            <CheckBox x:Name="TextBoldCheckBox" Grid.Column="1" IsChecked="{Binding SelectedTextBold}" VerticalAlignment="Center"
                      ToolTip.Tip="جعل النص عريضاً" AutomationProperties.Name="خط عريض" Content="عريض" />
          </Grid>
          <StackPanel Spacing="6">
            <TextBlock Text="مسار وانحناء النص" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
            <ComboBox x:Name="TextCurveKindComboBox"
                      ItemsSource="{Binding AvailableTextCurveOptions}"
                      SelectedItem="{Binding SelectedTextCurveOption}"
                      HorizontalAlignment="Stretch"
                      ToolTip.Tip="تحويل النص إلى قوس علوي أو سفلي أو دائرة ختم"
                      AutomationProperties.Name="انحناء النص">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TextCurveOption">
                  <TextBlock Text="{Binding TitleAr}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <controls:StudioSliderRow x:Name="TextCurveBendSlider"
                                      IsVisible="{Binding HasSelectedTextCurve}"
                                      Label="شدة القوس"
                                      Minimum="0.2" Maximum="1.0" TickFrequency="0.05" DefaultValue="0.5"
                                      DisplayFormat="0.##"
                                      Value="{Binding SelectedTextCurveBend}" />
            <controls:StudioSliderRow x:Name="TextLetterSpacingSlider"
                                      Label="تباعد الأحرف"
                                      Minimum="-0.05" Maximum="0.35" TickFrequency="0.02" DefaultValue="0"
                                      DisplayFormat="0.##"
                                      Value="{Binding SelectedTextLetterSpacingEm}" />
          </StackPanel>
          <controls:StudioCard AccentKind="Subtle" Header="تأثيرات النص (الحدود، الكبسولة، الظل)">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6">
                <CheckBox x:Name="TextOutlineCheckBox" Grid.Column="0" IsChecked="{Binding SelectedTextHasOutline}"
                          ToolTip.Tip="إضافة حد خارجي حول أحرف النص" AutomationProperties.Name="حد خارجي للنص" Content="حد خارجي" />
                <ColorPicker x:Name="TextOutlineColorPicker" Grid.Column="1" Color="{Binding SelectedTextOutlineColor}"
                             ToolTip.Tip="لون الحد الخارجي للنص" AutomationProperties.Name="لون الحد الخارجي للنص" />
                <controls:StudioNumberField x:Name="TextOutlineWidthNumeric"
                                            Grid.Column="2" Unit="مم"
                                            Minimum="0.1" Maximum="5" Increment="0.1" FormatString="0.##"
                                            Value="{Binding SelectedTextOutlineWidthMm}"
                                            ToolTip.Tip="سُمك الحد الخارجي للنص بالمليمتر" AccessibleName="سُمك حد النص" />
              </Grid>
              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                <CheckBox x:Name="TextPillCheckBox" Grid.Column="0" IsChecked="{Binding SelectedTextHasPill}"
                          ToolTip.Tip="تفعيل خلفية شارة كبسولة خلف النص" AutomationProperties.Name="خلفية كبسولة للنص" Content="كبسولة" />
                <ColorPicker x:Name="TextPillColorPicker" Grid.Column="1" Color="{Binding SelectedTextPillColor}"
                             ToolTip.Tip="لون خلفية الشارة الكبسولة" AutomationProperties.Name="لون الكبسولة" />
                <CheckBox x:Name="TextShadowCheckBox" Grid.Column="2" IsChecked="{Binding SelectedTextHasShadow}"
                          ToolTip.Tip="إضافة ظل ناعم للنص" AutomationProperties.Name="ظل النص" Content="ظل" />
              </Grid>
              <Button x:Name="ApplyTextEffectsButton"
                      Classes="studioSubtle"
                      HorizontalAlignment="Stretch"
                      Command="{Binding ApplySelectedTextEffectsCommand}"
                      ToolTip.Tip="تحديث ألوان وسُمك تأثيرات النص"
                      AutomationProperties.Name="تطبيق تأثيرات النص"
                      Content="تحديث التأثيرات" />
            </StackPanel>
          </controls:StudioCard>
          <Grid ColumnDefinitions="*,6,*">
            <Button x:Name="CommitTextButton"
                    Grid.Column="0"
                    Classes="studioPrimary"
                    HorizontalAlignment="Stretch"
                    Command="{Binding CommitSelectedTextCommand}"
                    ToolTip.Tip="اعتماد تعديل النص"
                    AutomationProperties.Name="اعتماد النص"
                    Content="تطبيق النص" />
            <Button x:Name="ApplyTextStyleButton"
                    Grid.Column="2"
                    Classes="studioSubtle"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ApplySelectedTextStyleCommand}"
                    ToolTip.Tip="تطبيق الخط والحجم واللون"
                    AutomationProperties.Name="تطبيق تنسيق النص"
                    Content="تطبيق التنسيق" />
          </Grid>
        </StackPanel>
      </controls:StudioCard>

      <!-- شبكة الكولاج وقائمة الانتظار -->
      <controls:StudioCard IsVisible="{Binding IsCollageMode}"
                           Header="شبكة الكولاج والهوية (مم)"
                           Subtitle="{Binding CollageSheetSummaryText}">
        <StackPanel Spacing="8">
          <StackPanel Spacing="3">
            <TextBlock Text="قالب الهوية / الشبكة" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
            <ComboBox x:Name="CollagePresetComboBox"
                      ItemsSource="{Binding AvailableCollagePresetOptions}"
                      SelectedItem="{Binding SelectedCollagePresetOption}"
                      HorizontalAlignment="Stretch"
                      ToolTip.Tip="اختيار مقاس صور هوية أو شبكة كولاج جاهزة"
                      AutomationProperties.Name="قالب الكولاج الجاهز">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CollagePresetOption">
                  <TextBlock Text="{Binding TitleAr}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <Grid ColumnDefinitions="*,6,*">
            <StackPanel Grid.Column="0" Spacing="3">
              <TextBlock Text="نمط المقاس" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
              <ComboBox x:Name="CollageSizingModeComboBox"
                        ItemsSource="{Binding AvailableCollageSizingOptions}"
                        SelectedItem="{Binding SelectedCollageSizingOption}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="تحديد مقاس الخلية بالمليمتر أو التمديد لملء الورقة"
                        AutomationProperties.Name="نمط مقاس الكولاج">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CollageSizingModeOption">
                    <TextBlock Text="{Binding TitleAr}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="3">
              <TextBlock Text="المحاذاة" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
              <ComboBox x:Name="CollageAlignmentComboBox"
                        ItemsSource="{Binding AvailableCollageAlignmentOptions}"
                        SelectedItem="{Binding SelectedCollageAlignmentOption}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="موضع محاذاة شبكة الكولاج داخل الورقة"
                        AutomationProperties.Name="محاذاة شبكة الكولاج">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:GridAlignmentOption">
                    <TextBlock Text="{Binding TitleAr}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,6,*" IsVisible="{Binding IsCollageFixedPhysicalSizing}">
            <controls:StudioNumberField x:Name="CollageCellWidthInput"
                                        Grid.Column="0" Label="عرض الخلية" Unit="مم"
                                        Minimum="10" Maximum="250" Increment="1" FormatString="0.#"
                                        Value="{Binding CollageCellWidthInputMm}"
                                        ToolTip.Tip="العرض الفيزيائي الفعلي لكل صورة هوية بالمليمتر"
                                        AccessibleName="عرض خانة الكولاج" />
            <controls:StudioNumberField x:Name="CollageCellHeightInput"
                                        Grid.Column="2" Label="ارتفاع الخلية" Unit="مم"
                                        Minimum="10" Maximum="250" Increment="1" FormatString="0.#"
                                        Value="{Binding CollageCellHeightInputMm}"
                                        ToolTip.Tip="الارتفاع الفيزيائي الفعلي لكل صورة هوية بالمليمتر"
                                        AccessibleName="ارتفاع خانة الكولاج" />
          </Grid>
          <Grid ColumnDefinitions="*,6,*" RowDefinitions="Auto,Auto" RowSpacing="6">
            <controls:StudioNumberField Grid.Row="0" Grid.Column="0" Label="الصفوف"
                                        Minimum="1" Maximum="12" Increment="1" FormatString="0"
                                        Value="{Binding CollageRowsInput}"
                                        ToolTip.Tip="عدد صفوف شبكة الكولاج" AccessibleName="صفوف الكولاج" />
            <controls:StudioNumberField Grid.Row="0" Grid.Column="2" Label="الأعمدة"
                                        Minimum="1" Maximum="12" Increment="1" FormatString="0"
                                        Value="{Binding CollageColumnsInput}"
                                        ToolTip.Tip="عدد أعمدة شبكة الكولاج" AccessibleName="أعمدة الكولاج" />
            <controls:StudioNumberField Grid.Row="1" Grid.Column="0" Label="الفجوة" Unit="مم"
                                        Minimum="0" Maximum="25" Increment="0.5" FormatString="0.#"
                                        Value="{Binding CollageGapInputMm}"
                                        ToolTip.Tip="المسافة بين خانات الكولاج بالمليمتر" AccessibleName="فجوة الكولاج" />
            <controls:StudioNumberField Grid.Row="1" Grid.Column="2" Label="الهامش" Unit="مم"
                                        Minimum="0" Maximum="30" Increment="0.5" FormatString="0.#"
                                        Value="{Binding CollageMarginInputMm}"
                                        ToolTip.Tip="هامش شبكة الكولاج الخارجي بالمليمتر" AccessibleName="هامش الكولاج" />
          </Grid>
          <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
            <Button x:Name="ApplyCollageGridButton"
                    Classes="studioPrimary"
                    Command="{Binding ApplyCollageGridAdjustmentsCommand}"
                    ToolTip.Tip="تحديث صفوف وأعمدة ومقاس وفجوات شبكة الكولاج"
                    AutomationProperties.Name="تطبيق شبكة الكولاج"
                    Content="تطبيق الشبكة" />
            <Button x:Name="ToggleAutoRepeatButton"
                    Classes="studioSubtle"
                    Command="{Binding ToggleAutoRepeatCommand}"
                    ToolTip.Tip="تفعيل أو إيقاف تكرار صورة الهوية على كامل الشيت"
                    AutomationProperties.Name="تكرار صورة الهوية"
                    Content="{Binding AutoRepeatToggleText}" />
            <Button x:Name="ClearAllCollageSlotsButton"
                    Classes="studioDestructive"
                    Command="{Binding ClearAllCollageSlotsCommand}"
                    ToolTip.Tip="تفريغ جميع خانات شيت الكولاج الحالي"
                    AutomationProperties.Name="تفريغ كل الخانات"
                    Content="تفريغ الكل" />
          </WrapPanel>
          <StackPanel Spacing="4" IsVisible="{Binding HasPendingCollageAssets}">
            <TextBlock Text="{Binding CollagePendingBadgeText}" FontSize="11" Foreground="{DynamicResource ZiwaInfoBrush}" />
            <Button x:Name="DistributePendingCollageButton"
                    Classes="studioSubtle"
                    HorizontalAlignment="Stretch"
                    Command="{Binding AutoDistributePendingCollageAssetsCommand}"
                    ToolTip.Tip="توزيع الصور المنتظرة تلقائياً في الخانات الشاغرة"
                    AutomationProperties.Name="توزيع الصور المنتظرة"
                    Content="توزيع الصور المنتظرة" />
          </StackPanel>
        </StackPanel>
      </controls:StudioCard>

      <!-- المشروع والورقة والنزيف -->
      <controls:StudioCard Header="المشروع والورقة (مم)">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,6,Auto">
            <TextBox x:Name="DocumentTitleInputBox" Grid.Column="0"
                     Text="{Binding EditableDocumentTitle}"
                     Watermark="اسم المشروع..."
                     ToolTip.Tip="تعديل عنوان المشروع الظاهر في المكتبة والمطبوعات"
                     AutomationProperties.Name="اسم المشروع" />
            <Button x:Name="RenameDocumentButton" Grid.Column="2"
                    Classes="studioSubtle"
                    Command="{Binding RenameDocumentCommand}"
                    ToolTip.Tip="حفظ الاسم الجديد للمشروع"
                    AutomationProperties.Name="تسمية المشروع"
                    Content="تسمية" />
          </Grid>
          <ComboBox ItemsSource="{Binding AvailablePaperPresets}" SelectedItem="{Binding SelectedPaperPreset}" HorizontalAlignment="Stretch"
                    ToolTip.Tip="اختيار مقاس ورق جاهز" AutomationProperties.Name="مقاسات الورق الجاهزة">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PaperPresetOption">
                <TextBlock Text="{Binding TitleAr}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Grid ColumnDefinitions="*,6,*,6,*">
            <controls:StudioNumberField Grid.Column="0" Label="العرض" Unit="مم"
                                        Minimum="10" Maximum="2000" Increment="1" FormatString="0.#"
                                        Value="{Binding PageWidthInputMm}"
                                        ToolTip.Tip="عرض الورقة بالمليمتر" AccessibleName="عرض الورقة" />
            <controls:StudioNumberField Grid.Column="2" Label="الارتفاع" Unit="مم"
                                        Minimum="10" Maximum="2000" Increment="1" FormatString="0.#"
                                        Value="{Binding PageHeightInputMm}"
                                        ToolTip.Tip="ارتفاع الورقة بالمليمتر" AccessibleName="ارتفاع الورقة" />
            <controls:StudioNumberField Grid.Column="4" Label="النزيف" Unit="مم"
                                        Minimum="0" Maximum="25" Increment="0.5" FormatString="0.#"
                                        Value="{Binding PageBleedInputMm}"
                                        ToolTip.Tip="مساحة النزيف بالمليمتر" AccessibleName="النزيف" />
          </Grid>
          <Button x:Name="ApplyPageGeometryButton"
                  Classes="studioSubtle"
                  HorizontalAlignment="Stretch"
                  Command="{Binding ApplyPageGeometryCommand}"
                  ToolTip.Tip="تطبيق مقاس الورقة والنزيف بالمليمتر على الصفحات"
                  AutomationProperties.Name="تطبيق مقاس الورقة"
                  Content="تطبيق المقاس" />
        </StackPanel>
      </controls:StudioCard>

      <TextBlock Text="الطبقات وعناصر الصفحة"
                 FontSize="13"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />

      <ItemsControl x:Name="LayersListControl" ItemsSource="{Binding LayerItems}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SceneLayerItemViewModel">
            <Border Margin="0,0,0,6"
                    Padding="6"
                    Background="{DynamicResource ZiwaSurfaceBrush}"
                    BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                    BorderThickness="{StaticResource HairlineBorderThickness}"
                    CornerRadius="{StaticResource ControlCornerRadius}">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                <Button Grid.Column="0"
                        Classes="workspaceAction statusAction"
                        Classes.active="{Binding IsSelected}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsEnabled="{Binding CanSelectOnCanvas}"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectLayerCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding LayerTip}"
                        AutomationProperties.Name="{Binding SelectAccessibleName}">
                  <StackPanel Spacing="1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                      <TextBlock Grid.Column="0"
                                 Text="{Binding Name}"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding KindBadgeAr}"
                                 FontSize="10"
                                 Foreground="{DynamicResource ZiwaInfoBrush}"
                                 VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding DimensionsText}"
                               FlowDirection="LeftToRight"
                               HorizontalAlignment="Right"
                               FontSize="10"
                               Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="1"
                        Classes="workspaceAction statusAction"
                        Classes.active="{Binding !IsVisible}"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleLayerVisibilityCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="تبديل إظهار أو إخفاء هذه الطبقة"
                        AutomationProperties.Name="{Binding VisibilityAccessibleName}"
                        Content="{Binding VisibilityLabel}" />
                <Button Grid.Column="2"
                        Classes="workspaceAction statusAction"
                        Classes.active="{Binding IsLocked}"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleLayerLockCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="تبديل قفل أو فتح هذه الطبقة"
                        AutomationProperties.Name="{Binding LockAccessibleName}"
                        Content="{Binding LockLabel}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
