<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ziwa.App.ViewModels"
        xmlns:controls="using:Ziwa.App.Controls"
        xmlns:views="using:Ziwa.App.Views"
        xmlns:dialogs="using:Ziwa.App.Views.Dialogs"
        xmlns:inspector="using:Ziwa.App.Views.Inspector"
        xmlns:workspace="using:Ziwa.App.Views.Workspace"
        x:Class="Ziwa.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding ProjectWindowTitle}"
        Width="1360"
        Height="892"
        MinWidth="960"
        MinHeight="640"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="32"
        DragDrop.AllowDrop="True"
        FlowDirection="RightToLeft"
        Background="{DynamicResource ZiwaSurfaceBrush}"
        Foreground="{DynamicResource ZiwaPrimaryTextBrush}">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
    <workspace:WindowTitleBarView x:Name="WindowTitleBarRegion" Grid.Row="0" IsVisible="{Binding IsChromeVisible}" />
    <workspace:CommandBarView x:Name="CommandBarRegion" Grid.Row="1" IsVisible="{Binding IsChromeVisible}" />

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <workspace:WorkspaceRailView x:Name="WorkspaceRailRegion" Grid.Column="0" IsVisible="{Binding IsChromeVisible}" />

      <!-- إطار الورقة يطابق إحداثيات الطباعة؛ الألواح العائمة تبقى RTL. -->
      <Grid x:Name="CanvasWorkspaceRegion" Grid.Column="1" FlowDirection="LeftToRight"
            Container.Name="QuickBarViewport" Container.Sizing="Width">
        <Grid.RowDefinitions>
          <RowDefinition Height="{StaticResource RulerGridLength}" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{StaticResource RulerGridLength}" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Background="{DynamicResource ZiwaRulerBackgroundBrush}"
                BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                BorderThickness="0,0,1,1">
          <TextBlock Text="مم"
                     FlowDirection="RightToLeft"
                     FontSize="10"
                     Foreground="{DynamicResource ZiwaSecondaryTextBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <Border Grid.Row="0"
                Grid.Column="1"
                BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                BorderThickness="0,0,0,1">
          <controls:CanvasRulerControl x:Name="HorizontalRuler"
                                       Orientation="Horizontal"
                                       Viewport="{Binding Viewport}"
                                       PageLengthMm="{Binding PageWidthMm}"
                                       PointerPositionMm="{Binding CanvasPointerXMm}"
                                       SelectionStartMm="{Binding SelectionStartXMm}"
                                       SelectionEndMm="{Binding SelectionEndXMm}"
                                       BackgroundBrush="{DynamicResource ZiwaRulerBackgroundBrush}"
                                       TickBrush="{DynamicResource ZiwaSecondaryTextBrush}"
                                       PaperHighlightBrush="{DynamicResource ZiwaSubtleFillBrush}"
                                       OriginBrush="{DynamicResource ZiwaPrimaryActionBrush}" />
        </Border>

        <Border Grid.Row="1"
                Grid.Column="0"
                BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                BorderThickness="0,0,1,0">
          <controls:CanvasRulerControl x:Name="VerticalRuler"
                                       Orientation="Vertical"
                                       Viewport="{Binding Viewport}"
                                       PageLengthMm="{Binding PageHeightMm}"
                                       PointerPositionMm="{Binding CanvasPointerYMm}"
                                       SelectionStartMm="{Binding SelectionStartYMm}"
                                       SelectionEndMm="{Binding SelectionEndYMm}"
                                       BackgroundBrush="{DynamicResource ZiwaRulerBackgroundBrush}"
                                       TickBrush="{DynamicResource ZiwaSecondaryTextBrush}"
                                       PaperHighlightBrush="{DynamicResource ZiwaSubtleFillBrush}"
                                       OriginBrush="{DynamicResource ZiwaPrimaryActionBrush}" />
        </Border>

        <controls:SkiaViewportHost x:Name="ViewportHost"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   Session="{Binding Session}"
                                   IsEnabled="{Binding IsProjectEditable}"
                                   CommandRegistry="{Binding CommandRegistry}"
                                   Page="{Binding ActivePage}"
                                   SceneRenderer="{Binding SceneRenderer}"
                                   Viewport="{Binding Viewport}"
                                   PointerPageXMm="{Binding CanvasPointerXMm}"
                                   PointerPageYMm="{Binding CanvasPointerYMm}"
                                   PasteboardBrush="{DynamicResource ZiwaCanvasBackgroundBrush}"
                                   SelectionAccentBrush="{DynamicResource ZiwaPrimaryActionBrush}">
          <controls:SkiaViewportHost.ContextMenu>
            <ContextMenu FlowDirection="RightToLeft">
              <MenuItem Header="إدراج / استبدال صورة الخانة" Command="{Binding ImportImageCommand}" IsVisible="{Binding IsCollageSlotSelected}" />
              <MenuItem Header="تكرار الصورة على كامل الشيت" Command="{Binding FillAllSlotsWithSelectedSlotCommand}" IsVisible="{Binding CanFillSheetWithSelectedSlot}" />
              <MenuItem Header="تدوير محتوى الخانة 90°" Command="{Binding RotateSelectedSlotCommand}" IsVisible="{Binding IsCollageSlotSelected}" />
              <MenuItem Header="قلب أفقي للخانة" Command="{Binding FlipSelectedSlotCommand}" IsVisible="{Binding IsCollageSlotSelected}" />
              <MenuItem Header="إعادة ضبط تأطير الخانة" Command="{Binding ResetSelectedSlotTransformCommand}" IsVisible="{Binding IsCollageSlotWithImageSelected}" />
              <MenuItem Header="تفريغ الخانة (Delete)" Command="{Binding ClearSelectedSlotCommand}" IsVisible="{Binding IsCollageSlotWithImageSelected}" />
              <Separator IsVisible="{Binding IsCollageSlotSelected}" />
              <MenuItem Header="قص الصورة" Command="{Binding EnterSelectedCropModeCommand}" IsVisible="{Binding IsImageSelected}" />
              <MenuItem Header="تحرير النص" Command="{Binding EnterSelectedTextEditCommand}" IsVisible="{Binding IsTextSelected}" />
              <MenuItem Header="تعديل الملصق" Command="{Binding EditSelectedStickerCommand}" IsVisible="{Binding IsStickerSelected}" />
              <MenuItem Header="تكرار (Ctrl+D)" Command="{Binding DuplicateSelectionCommand}" IsEnabled="{Binding HasSelection}" />
              <Separator />
              <MenuItem Header="إحضار للأمام (Ctrl+])" Command="{Binding BringForwardSelectionCommand}" IsEnabled="{Binding HasSelection}" />
              <MenuItem Header="إرسال للخلف (Ctrl+[)" Command="{Binding SendBackwardSelectionCommand}" IsEnabled="{Binding HasSelection}" />
              <MenuItem Header="تجميع (Ctrl+G)" Command="{Binding GroupCommand}" IsVisible="{Binding CanGroup}" />
              <MenuItem Header="فك التجميع (Ctrl+Shift+G)" Command="{Binding UngroupCommand}" IsVisible="{Binding CanUngroup}" />
              <Separator />
              <MenuItem Header="تحديد الكل (Ctrl+A)" Command="{Binding SelectAllNodesCommand}" />
              <MenuItem Header="ملاءمة الصفحة (Ctrl+0)" Command="{Binding FitPageCommand}" />
              <Separator />
              <MenuItem Header="حذف المحدد (Delete)" Command="{Binding DeleteSelectionCommand}" IsEnabled="{Binding HasAnySelection}" />
            </ContextMenu>
          </controls:SkiaViewportHost.ContextMenu>
        </controls:SkiaViewportHost>

        <!-- محرر النص الموضعي على اللوحة -->
        <Canvas Grid.Row="1"
                Grid.Column="1"
                FlowDirection="LeftToRight"
                ZIndex="1"
                SizeChanged="OnInlineEditorSizeChanged"
                IsVisible="{Binding IsInlineTextEditOpen}">
          <Border x:Name="InlineTextEditOverlay"
                  FlowDirection="RightToLeft"
                  SizeChanged="OnInlineEditorSizeChanged"
                  MinWidth="260"
                  MaxWidth="390"
                  Padding="12"
                  Background="{DynamicResource ZiwaElevatedCardBrush}"
                  BorderBrush="{DynamicResource ZiwaFocusStrokeBrush}"
                  BorderThickness="1.5"
                  CornerRadius="{StaticResource OverlayCornerRadius}"
                  BoxShadow="{StaticResource ZiwaFloatingShadow}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="تحرير النص السريع"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
                <TextBlock Grid.Column="1"
                           Text="Enter للحفظ · Esc للإلغاء"
                           FontSize="10.5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
              </Grid>
              <TextBox x:Name="InlineCanvasTextBox"
                       Text="{Binding InlineTextEditDraft}"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MaxHeight="120"
                       Watermark="اكتب النص واضغط Enter للحفظ أو Esc للإلغاء"
                       AutomationProperties.Name="محرر النص الموضعي" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                <Button x:Name="InlineTextCancelButton"
                        Classes="studioSubtle"
                        Command="{Binding CancelInlineTextEditCommand}"
                        ToolTip.Tip="إلغاء تحرير النص (Esc)"
                        AutomationProperties.Name="إلغاء تحرير النص"
                        Content="إلغاء" />
                <Button x:Name="InlineTextSaveButton"
                        Classes="studioPrimary"
                        Command="{Binding CommitInlineTextEditCommand}"
                        ToolTip.Tip="اعتماد النص المعدّل (Enter)"
                        AutomationProperties.Name="اعتماد النص"
                        Content="حفظ النص" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Canvas>

        <!-- الشريط السريع السياقي العائم (QuickBar) -->
        <Border x:Name="ContextualQuickBar"
                FlowDirection="RightToLeft"
                Grid.Row="1"
                Grid.Column="1"
                IsVisible="{Binding IsQuickBarVisible}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="14"
                Padding="10,6"
                Background="{DynamicResource ZiwaElevatedCardBrush}"
                BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                BorderThickness="{StaticResource HairlineBorderThickness}"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                BoxShadow="{StaticResource ZiwaFloatingShadow}">
          <Grid>
            <!-- شريط أدوات القص الموضعي -->
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsCropModeActive}" KeyDown="OnCropBarKeyDown">
              <Button x:Name="QuickCropZoomOutButton" Classes="quickBarChip quickBarIcon"
                      Command="{Binding ZoomOutCropCommand}"
                      ToolTip.Tip="تصغير الصورة داخل إطار القص" AutomationProperties.Name="تصغير القص">
                <PathIcon Classes="workspaceIcon" Data="{StaticResource IconMinus}" />
              </Button>
              <TextBlock Text="{Binding CropZoomPercentText}"
                         FlowDirection="LeftToRight"
                         VerticalAlignment="Center"
                         FontWeight="SemiBold"
                         Margin="2,0"
                         Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
              <Button x:Name="QuickCropZoomInButton" Classes="quickBarChip quickBarIcon"
                      Command="{Binding ZoomInCropCommand}"
                      ToolTip.Tip="تكبير الصورة داخل إطار القص" AutomationProperties.Name="تكبير القص">
                <PathIcon Classes="workspaceIcon" Data="{StaticResource IconPlus}" />
              </Button>
              <Button x:Name="QuickCropResetButton"
                      Classes="quickBarChip"
                      Command="{Binding ResetCropSpecCommand}"
                      ToolTip.Tip="إعادة ضبط القص إلى الحجم الافتراضي"
                      AutomationProperties.Name="إعادة ضبط القص"
                      Content="1×" />
              <Border Classes="workspaceDivider" />
              <Button x:Name="QuickCropApplyButton" Classes="quickBarPrimary quickBarIcon"
                      Command="{Binding ApplyCropModeCommand}"
                      ToolTip.Tip="تطبيق القص الموضعي (Enter)" AutomationProperties.Name="تطبيق القص">
                <PathIcon Classes="workspaceIcon" Data="{StaticResource IconCheckCircle}" />
              </Button>
              <Button x:Name="QuickCropCancelButton" Classes="quickBarChip quickBarIcon"
                      Command="{Binding CancelCropModeCommand}"
                      ToolTip.Tip="إلغاء القص واستعادة الإطار السابق (Esc)" AutomationProperties.Name="إلغاء القص">
                <PathIcon Classes="workspaceIcon" Data="{StaticResource IconWindowClose}" />
              </Button>
            </StackPanel>

            <!-- الشريط السياقي المعتاد عند التحديد -->
            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsNotCropModeActive}">
              <Button x:Name="QuickEditStickerButton" Classes="quickBarPrimary quickBarLabeledIcon"
                      Command="{Binding EditSelectedStickerCommand}" IsVisible="{Binding IsStickerSelected}"
                      ToolTip.Tip="تعديل الملصق في مكانه" AutomationProperties.Name="تعديل الملصق">
                <StackPanel Classes="workspaceActionLabel">
                  <PathIcon Classes="workspaceIcon" Data="{StaticResource IconSticker}" />
                  <TextBlock Classes="quickBarCaption" Text="تعديل الملصق" />
                </StackPanel>
              </Button>
              <Button x:Name="QuickEditTextButton" Classes="quickBarPrimary quickBarLabeledIcon"
                      Command="{Binding EnterSelectedTextEditCommand}" IsVisible="{Binding IsTextSelected}"
                      ToolTip.Tip="تحرير النص مباشرة على اللوحة (نقر مزدوج)" AutomationProperties.Name="تحرير النص على اللوحة">
                <StackPanel Classes="workspaceActionLabel">
                  <PathIcon Classes="workspaceIcon" Data="{StaticResource IconText}" />
                  <TextBlock Classes="quickBarCaption" Text="تحرير النص" />
                </StackPanel>
              </Button>
              <Button x:Name="QuickEnterCropButton" Classes="quickBarPrimary quickBarLabeledIcon"
                      Command="{Binding EnterSelectedCropModeCommand}" IsVisible="{Binding IsImageSelected}"
                      ToolTip.Tip="قص وتأطير الصورة موضعياً (نقر مزدوج)" AutomationProperties.Name="قص الصورة الموضعي">
                <StackPanel Classes="workspaceActionLabel">
                  <PathIcon Classes="workspaceIcon" Data="{StaticResource IconCrop}" />
                  <TextBlock Classes="quickBarCaption" Text="قص" />
                </StackPanel>
              </Button>
              <Button x:Name="QuickMaskWithShapeButton"
                      Classes="quickBarPrimary"
                      Command="{Binding MaskWithShapeCommand}"
                      IsVisible="{Binding CanMaskImageWithShape}"
                      ToolTip.Tip="دمج الصورة المحددة داخل الشكل المحدد"
                      AutomationProperties.Name="تقنيع الصورة بالشكل"
                      Content="قناع بالشكل" />
              <Button x:Name="QuickInsertSlotImageButton" Classes="quickBarPrimary quickBarLabeledIcon"
                      Command="{Binding ImportImageCommand}" IsVisible="{Binding IsCollageSlotSelected}"
                      ToolTip.Tip="إدراج صورة الخانة أو استبدالها" AutomationProperties.Name="إدراج صورة الخانة أو استبدالها">
                <StackPanel Classes="workspaceActionLabel">
                  <PathIcon Classes="workspaceIcon" Data="{StaticResource IconImage}" />
                  <TextBlock Classes="quickBarCaption" Text="صورة الخانة" />
                </StackPanel>
              </Button>
              <Button x:Name="QuickRotateSlotButton"
                      Classes="quickBarChip"
                      Command="{Binding RotateSelectedSlotCommand}"
                      IsVisible="{Binding IsCollageSlotSelected}"
                      ToolTip.Tip="تدوير محتوى الخانة 90 درجة"
                      AutomationProperties.Name="تدوير الخانة"
                      Content="تدوير 90°" />
              <Button x:Name="QuickClearSlotButton"
                      Classes="quickBarDestructive"
                      Command="{Binding ClearSelectedSlotCommand}"
                      IsVisible="{Binding IsCollageSlotWithImageSelected}"
                      ToolTip.Tip="إزالة الصورة مع إبقاء الخانة (Delete)"
                      AutomationProperties.Name="تفريغ الخانة من الصورة"
                      Content="تفريغ الخانة" />
              <Border Classes="workspaceDivider" IsVisible="{Binding HasSelection}" />
              <Button x:Name="QuickDuplicateButton" Classes="quickBarChip quickBarIcon"
                      Command="{Binding DuplicateSelectionCommand}" IsVisible="{Binding HasSelection}"
                      ToolTip.Tip="تكرار العناصر المحددة (Ctrl+D)" AutomationProperties.Name="تكرار التحديد">
                <PathIcon Classes="workspaceIcon" Data="{StaticResource IconDuplicate}" />
              </Button>
              <Button Classes="quickBarChip quickBarIcon" Command="{Binding AlignSelectionCenterHCommand}" IsVisible="{Binding HasSelection}"
                      ToolTip.Tip="توسيط التحديد أفقياً في الورقة" AutomationProperties.Name="توسيط أفقي">
                <PathIcon Classes="workspaceIcon" Data="{StaticResource IconAlignCenterH}" />
              </Button>
              <Button Classes="quickBarChip quickBarIcon" Command="{Binding AlignSelectionCenterVCommand}" IsVisible="{Binding HasSelection}"
                      ToolTip.Tip="توسيط التحديد رأسياً في الورقة" AutomationProperties.Name="توسيط رأسي">
                <PathIcon Classes="workspaceIcon" Data="{StaticResource IconAlignCenterV}" />
              </Button>
              <Button x:Name="QuickDeleteButton" Classes="quickBarDestructive quickBarIcon"
                      Command="{Binding DeleteSelectionCommand}" IsVisible="{Binding HasSelection}"
                      ToolTip.Tip="حذف العناصر المحددة (Delete)" AutomationProperties.Name="حذف العناصر المحددة">
                <PathIcon Classes="workspaceIcon" Data="{StaticResource IconDelete}" />
              </Button>
              <Button x:Name="QuickMoreButton" Classes="quickBarChip"
                      ToolTip.Tip="أوامر إضافية للتحديد" AutomationProperties.Name="المزيد من أوامر التحديد">
                <StackPanel Classes="workspaceActionLabel">
                  <TextBlock Text="المزيد" VerticalAlignment="Center" />
                  <PathIcon Classes="workspaceIcon" Data="{StaticResource IconChevronDown}" />
                </StackPanel>
                <Button.Flyout>
                  <MenuFlyout Placement="Bottom" ShowMode="Standard">
                    <MenuItem Header="عزل الخلفية محلياً" Command="{Binding RemoveBackgroundCommand}"
                              IsVisible="{Binding IsPhotoAiTargetVisible}" IsEnabled="{Binding IsAllAiIdle}" InputGesture="Ctrl+Shift+B" />
                    <MenuItem Header="تأطير الوجه محلياً" Command="{Binding AutoFrameFaceCommand}"
                              IsVisible="{Binding IsPhotoAiTargetVisible}" IsEnabled="{Binding IsAllAiIdle}" InputGesture="Ctrl+Shift+F" />
                    <MenuItem Header="مسح واستعدال محلي" Command="{Binding OpenDocumentScannerCommand}"
                              IsVisible="{Binding IsPhotoAiTargetVisible}" IsEnabled="{Binding IsScannerToolsEnabled}" InputGesture="Ctrl+Shift+D" />
                    <MenuItem Header="ترميم سحابي 2×" Command="{Binding EnhancePhotoCloudCommand}"
                              IsVisible="{Binding IsPhotoAiTargetVisible}" IsEnabled="{Binding IsAllAiIdle}" InputGesture="Ctrl+Shift+U"
                              AutomationProperties.Name="ترميم الصورة سحابياً بدقة مضاعفة" ToolTip.Tip="إرسال الصورة إلى خدمة Modal لترميم الوجه ومضاعفة الدقة" />
                    <Separator IsVisible="{Binding IsPhotoAiTargetVisible}" />
                    <MenuItem Header="تكرار الصورة على كامل الورقة" Command="{Binding FillAllSlotsWithSelectedSlotCommand}" IsVisible="{Binding CanFillSheetWithSelectedSlot}" />
                    <MenuItem Header="قلب الخانة أفقياً" Command="{Binding FlipSelectedSlotCommand}" IsVisible="{Binding IsCollageSlotSelected}" />
                    <MenuItem Header="إعادة ضبط تأطير الخانة" Command="{Binding ResetSelectedSlotTransformCommand}" IsVisible="{Binding IsCollageSlotWithImageSelected}" />
                    <MenuItem Header="توليفة ألوان جديدة" Command="{Binding RandomizeSelectedStickerPaletteCommand}" IsVisible="{Binding IsStickerSelected}" />
                    <MenuItem Header="تقديم طبقة" Command="{Binding BringForwardSelectionCommand}" IsVisible="{Binding HasSelection}" ToolTip.Tip="تقديم طبقة (Ctrl+])" />
                    <MenuItem Header="تأخير طبقة" Command="{Binding SendBackwardSelectionCommand}" IsVisible="{Binding HasSelection}" ToolTip.Tip="تأخير طبقة (Ctrl+[)" />
                    <MenuItem Header="تجميع" Command="{Binding GroupCommand}" IsVisible="{Binding CanGroup}" InputGesture="Ctrl+G" />
                    <MenuItem Header="فك التجميع" Command="{Binding UngroupCommand}" IsVisible="{Binding CanUngroup}" InputGesture="Ctrl+Shift+G" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- زر عائم لإعادة إظهار لوح المفتش عند طيه -->
        <Button x:Name="ReopenInspectorFloatingButton"
                FlowDirection="RightToLeft"
                Grid.Row="1"
                Grid.Column="1"
                IsVisible="{Binding CanShowReopenInspectorButton}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="14"
                Padding="10,6"
                CornerRadius="{StaticResource PillCornerRadius}"
                Background="{DynamicResource ZiwaElevatedCardBrush}"
                BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                BorderThickness="{StaticResource HairlineBorderThickness}"
                Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                Command="{Binding OpenInspectorCommand}"
                ToolTip.Tip="إظهار لوح الخصائص والمفتش (Ctrl+I)"
                AutomationProperties.Name="إظهار لوح المفتش">
          <StackPanel Classes="workspaceActionLabel">
            <PathIcon Classes="workspaceIcon" Data="{StaticResource IconInspector}" />
            <TextBlock Text="المفتش" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
        </Button>

        <!-- كبسولة عائمة للخروج من وضع التركيز الكامل -->
        <Button x:Name="ExitZenModeFloatingButton"
                FlowDirection="RightToLeft"
                Grid.Row="1"
                Grid.Column="1"
                IsVisible="{Binding IsZenMode}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="14"
                Padding="12,6"
                CornerRadius="{StaticResource PillCornerRadius}"
                Background="{DynamicResource ZiwaElevatedCardBrush}"
                BorderBrush="{DynamicResource ZiwaFocusStrokeBrush}"
                BorderThickness="{StaticResource HairlineBorderThickness}"
                Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                Command="{Binding ToggleZenModeCommand}"
                ToolTip.Tip="إنهاء وضع التركيز الكامل واستعادة مساحة العمل (Ctrl+.)"
                AutomationProperties.Name="الخروج من وضع التركيز">
          <StackPanel Classes="workspaceActionLabel">
            <PathIcon Classes="workspaceIcon" Data="{StaticResource IconFocus}" Foreground="{DynamicResource ZiwaPrimaryActionBrush}" />
            <TextBlock Text="إنهاء وضع التركيز (Ctrl+.)" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- 4. لوح الخصائص المفتش السياقي (Inspector) -->
      <Border x:Name="InspectorRegion"
              Grid.Column="2"
              Width="{StaticResource InspectorWidth}"
              IsVisible="{Binding EffectiveInspectorVisible}"
              Background="{DynamicResource ZiwaCardBrush}"
              BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
              BorderThickness="1,0,0,0">
        <inspector:InspectorPanelView x:Name="InspectorPanelView" />
      </Border>
    </Grid>

    <workspace:PageStripView x:Name="PageStripRegion" Grid.Row="3" IsVisible="{Binding IsChromeVisible}" />
    <workspace:WorkspaceStatusBarView x:Name="StatusBarRegion" Grid.Row="4" IsVisible="{Binding IsChromeVisible}" />

    <dialogs:CommandPaletteView Grid.Row="1" Grid.RowSpan="4" IsVisible="{Binding IsCommandPaletteOpen}" />
    <dialogs:StickerStudioView Grid.Row="1" Grid.RowSpan="4" IsVisible="{Binding IsStickerStudioOpen}" />
    <dialogs:PrintExportDialogView Grid.Row="1" Grid.RowSpan="4" IsVisible="{Binding IsPrintDialogOpen}" />
    <views:ProjectLibraryView Grid.Row="1" Grid.RowSpan="4" IsVisible="{Binding IsProjectLibraryOpen}" />
    <views:AiMaskEditorView Grid.Row="1" Grid.RowSpan="4" IsVisible="{Binding IsMaskEditorOpen}" />
    <views:DocumentScannerView Grid.Row="1" Grid.RowSpan="4" IsVisible="{Binding IsDocumentScannerOpen}" />
    <views:AccountLicenseView Grid.Row="1" Grid.RowSpan="4" IsVisible="{Binding IsAccountDialogOpen}" />
    <views:PhoneBridgeView Grid.Row="1" Grid.RowSpan="4" IsVisible="{Binding IsPhoneBridgeDialogOpen}" />
    <views:AppUpdateView Grid.Row="1" Grid.RowSpan="4" IsVisible="{Binding IsUpdateDialogOpen}" />
    <WindowNotificationManager x:Name="ToastNotificationManager" Grid.RowSpan="5" Position="BottomLeft" MaxItems="3" />
  </Grid>
</Window>
