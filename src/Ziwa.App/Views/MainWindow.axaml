<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ziwa.App.ViewModels"
        xmlns:cmd="using:Ziwa.Application.Commands"
        xmlns:prt="using:Ziwa.Application.Printing"
        xmlns:prep="using:Ziwa.Domain.PrePress"
        xmlns:stk="using:Ziwa.Domain.Stickers"
        xmlns:controls="using:Ziwa.App.Controls"
        xmlns:views="using:Ziwa.App.Views"
        xmlns:workspace="using:Ziwa.App.Views.Workspace"
        x:Class="Ziwa.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding ProjectWindowTitle}"
        Width="1360"
        Height="892"
        MinWidth="960"
        MinHeight="640"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="32"
        DragDrop.AllowDrop="True"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource ZiwaCairoFont}"
        Background="{DynamicResource ZiwaSurfaceBrush}"
        Foreground="{DynamicResource ZiwaPrimaryTextBrush}">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
    <workspace:WindowTitleBarView x:Name="WindowTitleBarRegion" Grid.Row="0" IsVisible="{Binding IsChromeVisible}" />
    <workspace:CommandBarView x:Name="CommandBarRegion" Grid.Row="1" IsVisible="{Binding IsChromeVisible}" />

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <workspace:WorkspaceRailView x:Name="WorkspaceRailRegion" Grid.Column="0" IsVisible="{Binding IsChromeVisible}" />

      <!-- إطار الورقة يطابق إحداثيات الطباعة؛ الألواح العائمة تبقى RTL. -->
      <Grid x:Name="CanvasWorkspaceRegion" Grid.Column="1" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
          <RowDefinition Height="{StaticResource RulerGridLength}" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{StaticResource RulerGridLength}" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Background="{DynamicResource ZiwaRulerBackgroundBrush}"
                BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                BorderThickness="0,0,1,1">
          <TextBlock Text="مم"
                     FlowDirection="RightToLeft"
                     FontSize="10"
                     Foreground="{DynamicResource ZiwaSecondaryTextBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <Border Grid.Row="0"
                Grid.Column="1"
                BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                BorderThickness="0,0,0,1">
          <controls:CanvasRulerControl x:Name="HorizontalRuler"
                                       Orientation="Horizontal"
                                       Viewport="{Binding Viewport}"
                                       PageLengthMm="{Binding PageWidthMm}"
                                       PointerPositionMm="{Binding CanvasPointerXMm}"
                                       SelectionStartMm="{Binding SelectionStartXMm}"
                                       SelectionEndMm="{Binding SelectionEndXMm}"
                                       BackgroundBrush="{DynamicResource ZiwaRulerBackgroundBrush}"
                                       TickBrush="{DynamicResource ZiwaSecondaryTextBrush}"
                                       PaperHighlightBrush="{DynamicResource ZiwaSubtleFillBrush}"
                                       OriginBrush="{DynamicResource ZiwaPrimaryActionBrush}" />
        </Border>

        <Border Grid.Row="1"
                Grid.Column="0"
                BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                BorderThickness="0,0,1,0">
          <controls:CanvasRulerControl x:Name="VerticalRuler"
                                       Orientation="Vertical"
                                       Viewport="{Binding Viewport}"
                                       PageLengthMm="{Binding PageHeightMm}"
                                       PointerPositionMm="{Binding CanvasPointerYMm}"
                                       SelectionStartMm="{Binding SelectionStartYMm}"
                                       SelectionEndMm="{Binding SelectionEndYMm}"
                                       BackgroundBrush="{DynamicResource ZiwaRulerBackgroundBrush}"
                                       TickBrush="{DynamicResource ZiwaSecondaryTextBrush}"
                                       PaperHighlightBrush="{DynamicResource ZiwaSubtleFillBrush}"
                                       OriginBrush="{DynamicResource ZiwaPrimaryActionBrush}" />
        </Border>

        <controls:SkiaViewportHost x:Name="ViewportHost"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   Session="{Binding Session}"
                                   IsEnabled="{Binding IsProjectEditable}"
                                   CommandRegistry="{Binding CommandRegistry}"
                                   Page="{Binding ActivePage}"
                                   SceneRenderer="{Binding SceneRenderer}"
                                   Viewport="{Binding Viewport}"
                                   PointerPageXMm="{Binding CanvasPointerXMm}"
                                   PointerPageYMm="{Binding CanvasPointerYMm}"
                                   PasteboardBrush="{DynamicResource ZiwaCanvasBackgroundBrush}"
                                   SelectionAccentBrush="{DynamicResource ZiwaPrimaryActionBrush}">
          <controls:SkiaViewportHost.ContextMenu>
            <ContextMenu FlowDirection="RightToLeft">
              <MenuItem Header="إدراج / استبدال صورة الخانة" Command="{Binding ImportImageCommand}" IsVisible="{Binding IsCollageSlotSelected}" />
              <MenuItem Header="تكرار الصورة على كامل الشيت" Command="{Binding FillAllSlotsWithSelectedSlotCommand}" IsVisible="{Binding CanFillSheetWithSelectedSlot}" />
              <MenuItem Header="تدوير محتوى الخانة 90°" Command="{Binding RotateSelectedSlotCommand}" IsVisible="{Binding IsCollageSlotSelected}" />
              <MenuItem Header="قلب أفقي للخانة" Command="{Binding FlipSelectedSlotCommand}" IsVisible="{Binding IsCollageSlotSelected}" />
              <MenuItem Header="إعادة ضبط تأطير الخانة" Command="{Binding ResetSelectedSlotTransformCommand}" IsVisible="{Binding IsCollageSlotWithImageSelected}" />
              <MenuItem Header="تفريغ الخانة (Delete)" Command="{Binding ClearSelectedSlotCommand}" IsVisible="{Binding IsCollageSlotWithImageSelected}" />
              <MenuItem Header="قص الصورة" Command="{Binding EnterSelectedCropModeCommand}" IsVisible="{Binding IsImageSelected}" />
              <MenuItem Header="تحرير النص" Command="{Binding EnterSelectedTextEditCommand}" IsVisible="{Binding IsTextSelected}" />
              <MenuItem Header="تعديل الملصق" Command="{Binding EditSelectedStickerCommand}" IsVisible="{Binding IsStickerSelected}" />
              <MenuItem Header="تكرار (Ctrl+D)" Command="{Binding DuplicateSelectionCommand}" IsEnabled="{Binding HasSelection}" />
              <MenuItem Header="إحضار للأمام (Ctrl+])" Command="{Binding BringForwardSelectionCommand}" IsEnabled="{Binding HasSelection}" />
              <MenuItem Header="إرسال للخلف (Ctrl+[)" Command="{Binding SendBackwardSelectionCommand}" IsEnabled="{Binding HasSelection}" />
              <MenuItem Header="تجميع (Ctrl+G)" Command="{Binding GroupCommand}" IsVisible="{Binding CanGroup}" />
              <MenuItem Header="فك التجميع (Ctrl+Shift+G)" Command="{Binding UngroupCommand}" IsVisible="{Binding CanUngroup}" />
              <MenuItem Header="تحديد الكل (Ctrl+A)" Command="{Binding SelectAllNodesCommand}" />
              <MenuItem Header="ملاءمة الصفحة (Ctrl+0)" Command="{Binding FitPageCommand}" />
              <MenuItem Header="حذف المحدد (Delete)" Command="{Binding DeleteSelectionCommand}" IsEnabled="{Binding HasAnySelection}" />
            </ContextMenu>
          </controls:SkiaViewportHost.ContextMenu>
        </controls:SkiaViewportHost>

        <!-- محرر النص الموضعي على اللوحة -->
        <Canvas Grid.Row="1"
                Grid.Column="1"
                FlowDirection="LeftToRight"
                IsVisible="{Binding IsInlineTextEditOpen}">
          <Border x:Name="InlineTextEditOverlay"
                  FlowDirection="RightToLeft"
                  Canvas.Left="24"
                  Canvas.Top="24"
                  MinWidth="240"
                  MaxWidth="380"
                  Padding="10"
                  Background="{DynamicResource ZiwaCardBrush}"
                  BorderBrush="{DynamicResource ZiwaPrimaryActionBrush}"
                  BorderThickness="2"
                  CornerRadius="{StaticResource OverlayCornerRadius}"
                  BoxShadow="{StaticResource ZiwaFloatingShadow}">
            <StackPanel Spacing="8">
              <TextBox x:Name="InlineCanvasTextBox"
                       Text="{Binding InlineTextEditDraft}"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MaxHeight="120"
                       Watermark="اكتب النص واضغط Enter للحفظ أو Esc للإلغاء"
                       AutomationProperties.Name="محرر النص الموضعي" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                <Button x:Name="InlineTextSaveButton"
                        Command="{Binding CommitInlineTextEditCommand}"
                        MinHeight="{StaticResource CompactButtonSize}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource ZiwaPrimaryActionBrush}"
                        Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}"
                        ToolTip.Tip="اعتماد النص المعدّل (Enter)"
                        AutomationProperties.Name="اعتماد النص"
                        Content="حفظ" />
                <Button x:Name="InlineTextCancelButton"
                        Command="{Binding CancelInlineTextEditCommand}"
                        MinHeight="{StaticResource CompactButtonSize}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource ZiwaSubtleFillBrush}"
                        Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                        ToolTip.Tip="إلغاء تحرير النص (Esc)"
                        AutomationProperties.Name="إلغاء تحرير النص"
                        Content="إلغاء" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Canvas>

        <!-- الشريط السريع السياقي العائم (QuickBar) -->
        <Border x:Name="ContextualQuickBar"
                FlowDirection="RightToLeft"
                Grid.Row="1"
                Grid.Column="1"
                IsVisible="{Binding IsQuickBarVisible}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="14"
                Padding="10,6"
                Background="{DynamicResource ZiwaCardBrush}"
                BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                BorderThickness="{StaticResource HairlineBorderThickness}"
                CornerRadius="{StaticResource PillCornerRadius}"
                BoxShadow="{StaticResource ZiwaFloatingShadow}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <!-- شريط أدوات القص الموضعي -->
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsCropModeActive}">
              <Button x:Name="QuickCropZoomOutButton"
                      Command="{Binding ZoomOutCropCommand}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                      ToolTip.Tip="تصغير الصورة داخل إطار القص"
                      AutomationProperties.Name="تصغير القص"
                      Content="-" />
              <TextBlock Text="{Binding CropZoomPercentText}"
                         FlowDirection="LeftToRight"
                         VerticalAlignment="Center"
                         FontWeight="SemiBold"
                         Margin="2,0"
                         Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
              <Button x:Name="QuickCropZoomInButton"
                      Command="{Binding ZoomInCropCommand}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                      ToolTip.Tip="تكبير الصورة داخل إطار القص"
                      AutomationProperties.Name="تكبير القص"
                      Content="+" />
              <Button x:Name="QuickCropResetButton"
                      Command="{Binding ResetCropSpecCommand}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                      ToolTip.Tip="إعادة ضبط القص إلى الحجم الافتراضي"
                      AutomationProperties.Name="إعادة ضبط القص"
                      Content="1×" />
              <Button x:Name="QuickCropApplyButton"
                      Command="{Binding ApplyCropModeCommand}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaPrimaryActionBrush}"
                      Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}"
                      ToolTip.Tip="تطبيق القص الموضعي (Enter)"
                      AutomationProperties.Name="تطبيق القص"
                      Content="تطبيق القص" />
              <Button x:Name="QuickCropCancelButton"
                      Command="{Binding CancelCropModeCommand}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaDestructiveActionBrush}"
                      ToolTip.Tip="إلغاء القص واستعادة الإطار السابق (Esc)"
                      AutomationProperties.Name="إلغاء القص"
                      Content="إلغاء" />
            </StackPanel>

            <!-- الشريط السياقي المعتاد عند التحديد -->
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsNotCropModeActive}">
              <Button x:Name="QuickEditStickerButton"
                      Command="{Binding EditSelectedStickerCommand}"
                      IsVisible="{Binding IsStickerSelected}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaPrimaryActionBrush}"
                      Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}"
                      ToolTip.Tip="تعديل الملصق في مكانه"
                      AutomationProperties.Name="تعديل الملصق"
                      Content="تعديل الملصق" />
              <Button x:Name="QuickRandomPaletteButton"
                      Command="{Binding RandomizeSelectedStickerPaletteCommand}"
                      IsVisible="{Binding IsStickerSelected}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                      ToolTip.Tip="توليفة لونية عشوائية ذكية OKLCH"
                      AutomationProperties.Name="توليفة ألوان ذكية"
                      Content="توليفة ذكية" />
              <Button x:Name="QuickEditTextButton"
                      Command="{Binding EnterSelectedTextEditCommand}"
                      IsVisible="{Binding IsTextSelected}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaPrimaryActionBrush}"
                      Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}"
                      ToolTip.Tip="تحرير النص مباشرة على اللوحة (نقر مزدوج)"
                      AutomationProperties.Name="تحرير النص على اللوحة"
                      Content="تحرير النص" />
              <Button x:Name="QuickEnterCropButton"
                      Command="{Binding EnterSelectedCropModeCommand}"
                      IsVisible="{Binding IsImageSelected}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                      ToolTip.Tip="قص وتأطير الصورة موضعياً (نقر مزدوج)"
                      AutomationProperties.Name="قص الصورة الموضعي"
                      Content="قص" />
              <Button x:Name="QuickMaskWithShapeButton"
                      Command="{Binding MaskWithShapeCommand}"
                      IsVisible="{Binding CanMaskImageWithShape}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaPrimaryActionBrush}"
                      Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}"
                      ToolTip.Tip="دمج الصورة المحددة داخل الشكل المحدد"
                      AutomationProperties.Name="تقنيع الصورة بالشكل"
                      Content="قناع بالشكل" />
              <Button x:Name="QuickInsertSlotImageButton"
                      Command="{Binding ImportImageCommand}"
                      IsVisible="{Binding IsCollageSlotSelected}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaPrimaryActionBrush}"
                      Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}"
                      ToolTip.Tip="إدراج أو استبدال صورة في هذه الخانة"
                      AutomationProperties.Name="إدراج صورة في الخانة"
                      Content="إدراج صورة" />
              <Button x:Name="QuickFillAllSlotsButton"
                      Command="{Binding FillAllSlotsWithSelectedSlotCommand}"
                      IsVisible="{Binding CanFillSheetWithSelectedSlot}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                      ToolTip.Tip="تكرار صورة الخانة على كامل شيت الهوية"
                      AutomationProperties.Name="تكرار صورة الخانة"
                      Content="تكرار للكل" />
              <Button x:Name="QuickRotateSlotButton"
                      Command="{Binding RotateSelectedSlotCommand}"
                      IsVisible="{Binding IsCollageSlotSelected}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                      ToolTip.Tip="تدوير محتوى الخانة 90 درجة"
                      AutomationProperties.Name="تدوير الخانة"
                      Content="تدوير 90°" />
              <Button x:Name="QuickFlipSlotButton"
                      Command="{Binding FlipSelectedSlotCommand}"
                      IsVisible="{Binding IsCollageSlotSelected}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                      ToolTip.Tip="قلب محتوى الخانة أفقياً"
                      AutomationProperties.Name="قلب الخانة"
                      Content="قلب أفقي" />
              <Button x:Name="QuickResetSlotCropButton"
                      Command="{Binding ResetSelectedSlotTransformCommand}"
                      IsVisible="{Binding IsCollageSlotWithImageSelected}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                      ToolTip.Tip="إعادة ضبط التكبير والتدوير داخل الخانة"
                      AutomationProperties.Name="إعادة ضبط الخانة"
                      Content="ضبط 1×" />
              <Button x:Name="QuickClearSlotButton"
                      Command="{Binding ClearSelectedSlotCommand}"
                      IsVisible="{Binding IsCollageSlotWithImageSelected}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaDestructiveActionBrush}"
                      ToolTip.Tip="تفريغ الخانة المحددة (Delete)"
                      AutomationProperties.Name="تفريغ الخانة"
                      Content="تفريغ" />
              <Button x:Name="QuickRemoveBgButton"
                      Command="{Binding RemoveBackgroundCommand}"
                      IsVisible="{Binding IsPhotoAiTargetVisible}"
                      IsEnabled="{Binding IsAllAiIdle}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaPrimaryActionBrush}"
                      Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}"
                      ToolTip.Tip="عزل الخلفية محلياً أوفلاين (Ctrl+Shift+B)"
                      AutomationProperties.Name="عزل الخلفية السريع"
                      Content="عزل الخلفية" />
              <Button x:Name="QuickAutoFrameFaceButton"
                      Command="{Binding AutoFrameFaceCommand}"
                      IsVisible="{Binding IsPhotoAiTargetVisible}"
                      IsEnabled="{Binding IsAllAiIdle}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                      ToolTip.Tip="تأطير الوجه التلقائي لصور الهوية (Ctrl+Shift+F)"
                      AutomationProperties.Name="تأطير الوجه السريع"
                      Content="تأطير الوجه" />
              <Button x:Name="QuickCloudEnhanceButton"
                      Command="{Binding EnhancePhotoCloudCommand}"
                      IsVisible="{Binding IsPhotoAiTargetVisible}"
                      IsEnabled="{Binding IsAllAiIdle}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                      ToolTip.Tip="ترميم الوجوه ومضاعفة الدقة 2x عبر Modal CPU (Ctrl+Shift+U)"
                      AutomationProperties.Name="ترميم 2x سحابي"
                      Content="ترميم 2x سحابي" />
              <Button x:Name="QuickScanDocumentButton"
                      Command="{Binding OpenDocumentScannerCommand}"
                      IsVisible="{Binding IsPhotoAiTargetVisible}"
                      IsEnabled="{Binding IsScannerToolsEnabled}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                      ToolTip.Tip="فتح الماسح الضوئي واستعدال المنظور وتقسيم البطاقات (Ctrl+Shift+D)"
                      AutomationProperties.Name="ماسح المستندات السريع"
                      Content="مسح واستعدال" />
              <Button x:Name="QuickDuplicateButton"
                      Command="{Binding DuplicateSelectionCommand}"
                      IsVisible="{Binding HasSelection}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                      ToolTip.Tip="تكرار العناصر المحددة (Ctrl+D)"
                      AutomationProperties.Name="تكرار التحديد"
                      Content="تكرار" />
              <Button x:Name="QuickBringForwardButton"
                      Command="{Binding BringForwardSelectionCommand}"
                      IsVisible="{Binding HasSelection}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                      ToolTip.Tip="تقديم خطوة للأمام (Ctrl+])"
                      AutomationProperties.Name="إحضار للأمام"
                      Content="للأمام" />
              <Button x:Name="QuickSendBackwardButton"
                      Command="{Binding SendBackwardSelectionCommand}"
                      IsVisible="{Binding HasSelection}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                      ToolTip.Tip="إرجاع خطوة للخلف (Ctrl+[)"
                      AutomationProperties.Name="إرسال للخلف"
                      Content="للخلف" />
              <Button x:Name="QuickGroupButton"
                      Command="{Binding GroupCommand}"
                      IsVisible="{Binding CanGroup}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                      ToolTip.Tip="تجميع العناصر المحددة (Ctrl+G)"
                      AutomationProperties.Name="تجميع العناصر"
                      Content="تجميع" />
              <Button x:Name="QuickUngroupButton"
                      Command="{Binding UngroupCommand}"
                      IsVisible="{Binding CanUngroup}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                      ToolTip.Tip="فك تجميع المجموعة المحددة (Ctrl+Shift+G)"
                      AutomationProperties.Name="فك التجميع"
                      Content="فك تجميع" />
              <Button x:Name="QuickDeleteButton"
                      Command="{Binding DeleteSelectionCommand}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaDestructiveActionBrush}"
                      ToolTip.Tip="حذف أو تفريغ العنصر المحدد (Delete)"
                      AutomationProperties.Name="حذف المحدد"
                      Content="حذف" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- لوحة الأوامر السريعة Ctrl+K -->
        <Border x:Name="CommandPaletteOverlay"
                FlowDirection="RightToLeft"
                Grid.Row="1"
                Grid.Column="1"
                IsVisible="{Binding IsCommandPaletteOpen}"
                Width="460"
                MaxHeight="390"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,36,0,0"
                Padding="{StaticResource InspectorPadding}"
                Background="{DynamicResource ZiwaCardBrush}"
                BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                BorderThickness="{StaticResource HairlineBorderThickness}"
                CornerRadius="{StaticResource DialogCornerRadius}"
                BoxShadow="{StaticResource ZiwaSheetShadow}">
          <StackPanel Spacing="8">
            <TextBox x:Name="CommandSearchTextBox"
                     Text="{Binding CommandSearchQuery}"
                     Watermark="ابحث عن أمر أو اختصار..." />
            <ScrollViewer MaxHeight="280">
              <ItemsControl ItemsSource="{Binding FilteredCommands}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="cmd:CommandDefinition">
                    <Button Margin="0,0,0,4"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExecutePaletteCommandCommand}"
                            CommandParameter="{Binding}"
                            MinHeight="{StaticResource CompactButtonSize}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{DynamicResource ZiwaSurfaceBrush}"
                            Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                            ToolTip.Tip="{Binding TitleAr}"
                            AutomationProperties.Name="{Binding TitleAr}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding TitleAr}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ShortcutGesture}"
                                   FlowDirection="LeftToRight"
                                   Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <!-- نافذة استوديو الملصقات البارامتري -->
        <Border x:Name="StickerStudioOverlay"
                FlowDirection="RightToLeft"
                Grid.Row="1"
                Grid.Column="1"
                IsVisible="{Binding IsStickerStudioOpen}"
                Width="410"
                MaxHeight="620"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="16"
                Padding="{StaticResource InspectorPadding}"
                Background="{DynamicResource ZiwaCardBrush}"
                BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                BorderThickness="{StaticResource HairlineBorderThickness}"
                CornerRadius="{StaticResource DialogCornerRadius}"
                BoxShadow="{StaticResource ZiwaSheetShadow}">
          <ScrollViewer>
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="استوديو الملصقات البارامتري"
                           FontSize="14"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
                <Button x:Name="CloseStickerStudioButton"
                        Grid.Column="1"
                        Command="{Binding CloseStickerStudioCommand}"
                        MinWidth="{StaticResource CompactButtonSize}"
                        MinHeight="{StaticResource CompactButtonSize}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource ZiwaSubtleFillBrush}"
                        Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                        ToolTip.Tip="إغلاق استوديو الملصقات"
                        AutomationProperties.Name="إغلاق استوديو الملصقات"
                        Content="✕" />
              </Grid>

              <Border Height="148"
                      Background="{DynamicResource ZiwaCanvasBackgroundBrush}"
                      BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                      BorderThickness="{StaticResource HairlineBorderThickness}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      ClipToBounds="True">
                <controls:SkiaBitmapPreviewControl x:Name="StickerStudioPreviewControl"
                                                   PreviewBitmap="{Binding StickerPreviewBitmap}"
                                                   PasteboardBrush="{DynamicResource ZiwaCanvasBackgroundBrush}" />
              </Border>

              <ComboBox x:Name="StickerTemplateComboBox"
                        ItemsSource="{Binding StickerTemplates}"
                        SelectedItem="{Binding SelectedStickerTemplate}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="اختيار قالب الملصق أو الختم البارامتري"
                        AutomationProperties.Name="قالب الملصق">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="stk:StickerTemplateDefinition">
                    <TextBlock Text="{Binding TitleAr}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <ItemsControl ItemsSource="{Binding StickerFieldItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StickerFieldViewModel">
                    <StackPanel Margin="0,0,0,6" Spacing="2">
                      <TextBlock Text="{Binding LabelAr}"
                                 FontSize="12"
                                 Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                      <TextBox Text="{Binding Value}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="لون أساسي وتناغم OKLCH:" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <Border Width="18" Height="18" CornerRadius="4" Background="{Binding StudioPrimaryBrush}" BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}" BorderThickness="1" />
                  <Border Width="18" Height="18" CornerRadius="4" Background="{Binding StudioSecondaryBrush}" BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}" BorderThickness="1" />
                  <Border Width="18" Height="18" CornerRadius="4" Background="{Binding StudioAccentBrush}" BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}" BorderThickness="1" />
                  <Border Width="18" Height="18" CornerRadius="4" Background="{Binding StudioSurfaceBrush}" BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}" BorderThickness="1" />
                </StackPanel>
                <ColorPicker x:Name="StickerCustomPrimaryColorPicker" Grid.Column="2"
                             Color="{Binding StickerCustomPrimaryColor}"
                             ToolTip.Tip="تحديد اللون الأساسي لاشتقاق باقة ألوان متناغمة بتباين WCAG"
                             AutomationProperties.Name="لون الملصق الأساسي" />
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="StudioRandomPaletteButton"
                        Command="{Binding RandomizeStickerPaletteCommand}"
                        MinHeight="{StaticResource CompactButtonSize}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource ZiwaSubtleFillBrush}"
                        Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                        ToolTip.Tip="توليفة ألوان OKLCH عشوائية ذكية"
                        AutomationProperties.Name="توليفة عشوائية"
                        Content="توليفة عشوائية ذكية" />
                <Button x:Name="StudioApplyStickerButton"
                        Command="{Binding ApplyStickerStudioCommand}"
                        MinHeight="{StaticResource CompactButtonSize}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource ZiwaPrimaryActionBrush}"
                        Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}"
                        ToolTip.Tip="اعتماد وإدراج الملصق"
                        AutomationProperties.Name="اعتماد الملصق"
                        Content="اعتماد الملصق" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- نافذة الطباعة المباشرة والتجهيز الطباعي (P3-03 / P3-04 / P3-05) -->
        <Border x:Name="PrintDialogOverlay"
                FlowDirection="RightToLeft"
                Grid.Row="1"
                Grid.Column="1"
                IsVisible="{Binding IsPrintDialogOpen}"
                Width="490"
                MaxHeight="660"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="16"
                Padding="{StaticResource InspectorPadding}"
                Background="{DynamicResource ZiwaCardBrush}"
                BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                BorderThickness="{StaticResource HairlineBorderThickness}"
                CornerRadius="{StaticResource DialogCornerRadius}"
                BoxShadow="{StaticResource ZiwaSheetShadow}">
          <ScrollViewer>
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="الطباعة والتجهيز المطبعي والتصدير (1:1 مم)"
                           FontSize="15"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
                <Button x:Name="ClosePrintDialogButton"
                        Grid.Column="1"
                        Command="{Binding ClosePrintDialogCommand}"
                        MinWidth="{StaticResource CompactButtonSize}"
                        MinHeight="{StaticResource CompactButtonSize}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource ZiwaSubtleFillBrush}"
                        Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                        ToolTip.Tip="إغلاق نافذة الطباعة (Esc)"
                        AutomationProperties.Name="إغلاق نافذة الطباعة"
                        Content="✕" />
              </Grid>

              <StackPanel Spacing="4">
                <TextBlock Text="الطابعة المستهدفة"
                           FontSize="12"
                           Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                <Grid ColumnDefinitions="*,Auto">
                  <ComboBox x:Name="PrinterDeviceComboBox"
                            Grid.Column="0"
                            ItemsSource="{Binding AvailablePrinters}"
                            SelectedItem="{Binding SelectedPrinter}"
                            HorizontalAlignment="Stretch"
                            ToolTip.Tip="اختيار الطابعة المتصلة أو طابعة المعاينة"
                            AutomationProperties.Name="الطابعة المستهدفة">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="prt:PrinterDeviceInfo">
                        <TextBlock Text="{Binding PrinterName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button x:Name="SelectVirtualPrinterButton"
                          Grid.Column="1"
                          Margin="6,0,0,0"
                          Command="{Binding SelectVirtualPreviewPrinterCommand}"
                          MinHeight="{StaticResource CompactButtonSize}"
                          CornerRadius="{StaticResource ControlCornerRadius}"
                          Background="{DynamicResource ZiwaSubtleFillBrush}"
                          Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                          ToolTip.Tip="اختيار طابعة المعاينة الافتراضية 300 DPI"
                          AutomationProperties.Name="اختيار طابعة المعاينة"
                          Content="افتراضية" />
                </Grid>
              </StackPanel>

              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="اتجاه الطباعة"
                             FontSize="12"
                             Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                  <ComboBox x:Name="PrintOrientationComboBox"
                            ItemsSource="{Binding AvailableOrientationOptions}"
                            SelectedItem="{Binding SelectedPrintOrientationOption}"
                            HorizontalAlignment="Stretch"
                            ToolTip.Tip="تحديد الاتجاه العمودي أو الأفقي للطباعة"
                            AutomationProperties.Name="اتجاه الطباعة">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:PrintOrientationOption">
                        <TextBlock Text="{Binding TitleAr}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Width="105" Spacing="4">
                  <TextBlock Text="النسخ"
                             FontSize="12"
                             Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                  <NumericUpDown x:Name="PrintCopiesNumeric"
                                 Minimum="1"
                                 Maximum="99"
                                 Increment="1"
                                 FormatString="0"
                                 Value="{Binding PrintCopies}"
                                 FlowDirection="LeftToRight"
                                 ToolTip.Tip="عدد النسخ المراد طباعتها"
                                 AutomationProperties.Name="عدد النسخ" />
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="*,8,*">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="دقة التصدير (DPI)"
                             FontSize="12"
                             Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                  <ComboBox x:Name="ExportDpiComboBox"
                            ItemsSource="{Binding AvailableExportDpiOptions}"
                            SelectedItem="{Binding SelectedExportDpiOption}"
                            HorizontalAlignment="Stretch"
                            ToolTip.Tip="اختيار دقة التصيير والتصدير المطبعي"
                            AutomationProperties.Name="دقة التصدير">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ExportDpiOption">
                        <TextBlock Text="{Binding TitleAr}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                  <TextBlock Text="ملف تعريف CMYK TIFF"
                             FontSize="12"
                             Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                  <ComboBox x:Name="CmykProfileComboBox"
                            ItemsSource="{Binding AvailableCmykProfileOptions}"
                            SelectedItem="{Binding SelectedCmykProfileOption}"
                            HorizontalAlignment="Stretch"
                            ToolTip.Tip="اختيار ملف تعريف ألوان ICC للطباعة التجارية"
                            AutomationProperties.Name="ملف تعريف CMYK">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:CmykProfileOption">
                        <TextBlock Text="{Binding TitleAr}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>

              <WrapPanel Orientation="Horizontal">
                <CheckBox Margin="0,0,12,4"
                          IsChecked="{Binding PrintAllPages}"
                          ToolTip.Tip="تضمين كافة صفحات المستند في الطباعة أو التصدير"
                          AutomationProperties.Name="كل الصفحات"
                          Content="كل الصفحات" />
                <CheckBox Margin="0,0,12,4"
                          IsChecked="{Binding PrintBorderless}"
                          ToolTip.Tip="طباعة ممتدة حتى حواف الورقة بدون هوامش"
                          AutomationProperties.Name="طباعة بلا حواف"
                          Content="بلا حواف" />
                <CheckBox Margin="0,0,12,4"
                          IsChecked="{Binding PrintIncludeBleed}"
                          ToolTip.Tip="تضمين منطقة النزيف المطبعي"
                          AutomationProperties.Name="تضمين النزيف"
                          Content="تضمين النزيف" />
                <CheckBox Margin="0,0,12,4"
                          IsChecked="{Binding PrintIncludeCropMarks}"
                          ToolTip.Tip="إظهار علامات القص عند الزوايا"
                          AutomationProperties.Name="علامات القص"
                          Content="علامات القص" />
                <CheckBox Margin="0,0,12,4"
                          IsChecked="{Binding PrintIncludeRegistrationMarks}"
                          ToolTip.Tip="إظهار علامات التسجيل والمطابقة اللونية"
                          AutomationProperties.Name="علامات التسجيل"
                          Content="علامات التسجيل" />
                <CheckBox Margin="0,0,12,4"
                          IsChecked="{Binding PrintIncludeCutContour}"
                          ToolTip.Tip="تضمين مسار القطع CutContour"
                          AutomationProperties.Name="مسار القطع"
                          Content="مسار القطع CutContour" />
              </WrapPanel>

              <Border x:Name="PrintPreflightBanner"
                      IsVisible="{Binding HasPreflightWarnings}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      BorderBrush="{DynamicResource ZiwaWarningBrush}"
                      BorderThickness="{StaticResource HairlineBorderThickness}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Padding="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Grid.Column="0"
                             Text="{Binding PreflightSummaryText}"
                             FontSize="12"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource ZiwaWarningBrush}" />
                  <Button x:Name="ReviewPreflightButton"
                          Grid.Column="1"
                          Command="{Binding ReviewPreflightWarningsCommand}"
                          MinHeight="{StaticResource CompactButtonSize}"
                          CornerRadius="{StaticResource ControlCornerRadius}"
                          Background="{DynamicResource ZiwaCardBrush}"
                          Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                          ToolTip.Tip="الانتقال إلى قائمة تنبيهات ما قبل الطباعة وتحديد العنصر"
                          AutomationProperties.Name="مراجعة تنبيهات ما قبل الطباعة"
                          Content="مراجعة التنبيهات" />
                </Grid>
              </Border>

              <Border Background="{DynamicResource ZiwaSurfaceBrush}"
                      BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                      BorderThickness="{StaticResource HairlineBorderThickness}"
                      CornerRadius="{StaticResource OverlayCornerRadius}"
                      Padding="{StaticResource CardPadding}">
                <StackPanel Spacing="4">
                  <TextBlock Text="معايرة المليمتر الفيزيائية"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
                  <TextBlock Text="{Binding PrintCalibrationSummaryText}"
                             FontSize="11"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                  <TextBlock IsVisible="{Binding HasHardwareMarginClipWarning}"
                             Text="تنبيه: أبعاد التصميم تتجاوز المنطقة القابلة للطباعة لهذه الطابعة."
                             FontSize="11"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource ZiwaWarningBrush}" />
                </StackPanel>
              </Border>

              <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                <Button x:Name="ExecuteDirectPrintButton"
                        Command="{Binding ExecuteDirectPrintCommand}"
                        MinHeight="{StaticResource CompactButtonSize}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource ZiwaPrimaryActionBrush}"
                        Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}"
                        ToolTip.Tip="تنفيذ الطباعة المباشرة عبر طابور النظام أو المعاينة"
                        AutomationProperties.Name="طباعة مباشرة"
                        Content="طباعة مباشرة" />
                <Button x:Name="CancelLastPrintJobButton"
                        Command="{Binding CancelLastPrintJobCommand}"
                        IsEnabled="{Binding CanCancelLastPrintJob}"
                        MinHeight="{StaticResource CompactButtonSize}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource ZiwaSubtleFillBrush}"
                        Foreground="{DynamicResource ZiwaDestructiveActionBrush}"
                        ToolTip.Tip="إلغاء آخر مهمة طباعة مرسلة"
                        AutomationProperties.Name="إلغاء مهمة الطباعة"
                        Content="إلغاء المهمة" />
                <Button x:Name="ExportVectorPdfButton"
                        Command="{Binding ExportVectorPdfCommand}"
                        MinHeight="{StaticResource CompactButtonSize}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource ZiwaSubtleFillBrush}"
                        Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                        ToolTip.Tip="تصدير ملف Vector PDF متجه متعدد الصفحات"
                        AutomationProperties.Name="تصدير Vector PDF"
                        Content="تصدير PDF" />
                <Button x:Name="ExportCmykTiffButton"
                        Command="{Binding ExportCmykTiffCommand}"
                        MinHeight="{StaticResource CompactButtonSize}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource ZiwaSubtleFillBrush}"
                        Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                        ToolTip.Tip="تصدير CMYK TIFF مضغوط LZW بملف ICC"
                        AutomationProperties.Name="تصدير CMYK TIFF"
                        Content="تصدير CMYK TIFF" />
                <Button x:Name="ExportRasterPngButton"
                        Command="{Binding ExportPngCommand}"
                        MinHeight="{StaticResource CompactButtonSize}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource ZiwaSubtleFillBrush}"
                        Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                        ToolTip.Tip="تصدير صورة PNG بالدقة المحددة (150-600 DPI)"
                        AutomationProperties.Name="تصدير PNG"
                        Content="تصدير PNG" />
                <Button x:Name="ExportRasterJpegButton"
                        Command="{Binding ExportJpegCommand}"
                        MinHeight="{StaticResource CompactButtonSize}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource ZiwaSubtleFillBrush}"
                        Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                        ToolTip.Tip="تصدير صورة JPEG بالدقة المحددة (150-600 DPI)"
                        AutomationProperties.Name="تصدير JPEG"
                        Content="تصدير JPEG" />
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- 4. لوح الخصائص المفتش السياقي (Inspector) -->
      <Border x:Name="InspectorRegion"
              Grid.Column="2"
              Width="{StaticResource InspectorWidth}"
              IsVisible="{Binding EffectiveInspectorVisible}"
              Background="{DynamicResource ZiwaCardBrush}"
              BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
              BorderThickness="1,0,0,0"
              Padding="{StaticResource InspectorPadding}">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0"
                         Text="مفتش الورقة والمشهد"
                         FontSize="15"
                         FontWeight="Bold"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
              <Button x:Name="CloseInspectorButton"
                      Grid.Column="1"
                      Command="{Binding CloseInspectorCommand}"
                      MinWidth="{StaticResource CompactButtonSize}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                      ToolTip.Tip="طي لوح المفتش"
                      AutomationProperties.Name="طي المفتش"
                      Content="✕" />
            </Grid>

            <Border Background="{DynamicResource ZiwaSurfaceBrush}"
                    BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                    BorderThickness="{StaticResource HairlineBorderThickness}"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Padding="{StaticResource CardPadding}">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding SelectionSummary}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
                <TextBlock Text="{Binding PageSizeMmText}"
                           FlowDirection="LeftToRight"
                           HorizontalAlignment="Right"
                           FontSize="12"
                           Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                <TextBlock Text="{Binding EffectiveDpiText}"
                           FlowDirection="LeftToRight"
                           HorizontalAlignment="Right"
                           FontSize="12"
                           Foreground="{DynamicResource ZiwaInfoBrush}" />
              </StackPanel>
            </Border>

            <!-- فاحص ما قبل الطباعة الهادئ (P3-02 Preflight) -->
            <Border x:Name="PreflightCard"
                    IsVisible="{Binding HasPreflightWarnings}"
                    Background="{DynamicResource ZiwaSurfaceBrush}"
                    BorderBrush="{DynamicResource ZiwaWarningBrush}"
                    BorderThickness="{StaticResource HairlineBorderThickness}"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Padding="{StaticResource CardPadding}">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding PreflightSummaryText}"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{DynamicResource ZiwaWarningBrush}" />
                <ItemsControl ItemsSource="{Binding PreflightIssues}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="prep:PreflightIssue">
                      <Button Margin="0,0,0,4"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectPreflightIssueCommand}"
                              CommandParameter="{Binding}"
                              MinHeight="{StaticResource CompactButtonSize}"
                              CornerRadius="{StaticResource ControlCornerRadius}"
                              Background="{DynamicResource ZiwaCardBrush}"
                              Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                              BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                              BorderThickness="{StaticResource HairlineBorderThickness}"
                              ToolTip.Tip="{Binding MessageAr}"
                              AutomationProperties.Name="{Binding MessageAr}">
                        <TextBlock Text="{Binding MessageAr}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- سياقية الملصق أولاً (FF-05) -->
            <Border x:Name="StickerInspectorCard"
                    IsVisible="{Binding IsStickerSelected}"
                    Background="{DynamicResource ZiwaSurfaceBrush}"
                    BorderBrush="{DynamicResource ZiwaFocusStrokeBrush}"
                    BorderThickness="{StaticResource HairlineBorderThickness}"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Padding="{StaticResource CardPadding}">
              <StackPanel Spacing="6">
                <TextBlock Text="إجراءات الملصق البارامتري"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Grid.Column="0"
                             Text="{Binding SelectedStickerTemplateTitle}"
                             FontSize="11"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Border Width="14" Height="14" CornerRadius="3" Background="{Binding SelectedStickerPrimaryBrush}" BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}" BorderThickness="1" />
                    <Border Width="14" Height="14" CornerRadius="3" Background="{Binding SelectedStickerSecondaryBrush}" BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}" BorderThickness="1" />
                    <Border Width="14" Height="14" CornerRadius="3" Background="{Binding SelectedStickerAccentBrush}" BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}" BorderThickness="1" />
                    <Border Width="14" Height="14" CornerRadius="3" Background="{Binding SelectedStickerSurfaceBrush}" BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}" BorderThickness="1" />
                  </StackPanel>
                </Grid>
                <Button x:Name="InspectorEditStickerButton"
                        Command="{Binding EditSelectedStickerCommand}"
                        MinHeight="{StaticResource CompactButtonSize}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource ZiwaPrimaryActionBrush}"
                        Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}"
                        ToolTip.Tip="فتح استوديو الملصق لتعديله في مكانه"
                        AutomationProperties.Name="تعديل الملصق في مكانه"
                        Content="تعديل الملصق" />
                <Button x:Name="InspectorRandomStickerPaletteButton"
                        Command="{Binding RandomizeSelectedStickerPaletteCommand}"
                        MinHeight="{StaticResource CompactButtonSize}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource ZiwaSubtleFillBrush}"
                        Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                        ToolTip.Tip="اشتقاق ألوان جديدة في فضاء OKLCH"
                        AutomationProperties.Name="توليفة ألوان OKLCH"
                        Content="توليفة ألوان ذكية" />
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasSelection}">
              <Button x:Name="GroupButton"
                      Command="{Binding GroupCommand}"
                      IsVisible="{Binding CanGroup}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                      ToolTip.Tip="تجميع العناصر المحددة (Ctrl+G)"
                      AutomationProperties.Name="تجميع العناصر المحددة"
                      Content="تجميع" />
              <Button x:Name="UngroupButton"
                      Command="{Binding UngroupCommand}"
                      IsVisible="{Binding CanUngroup}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                      ToolTip.Tip="فك التجميع (Ctrl+Shift+G)"
                      AutomationProperties.Name="فك التجميع"
                      Content="فك التجميع" />
              <Button x:Name="MaskWithShapeButton"
                      Command="{Binding MaskWithShapeCommand}"
                      IsVisible="{Binding CanMaskImageWithShape}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaPrimaryActionBrush}"
                      Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}"
                      ToolTip.Tip="قنّع الصورة بهذا الشكل"
                      AutomationProperties.Name="قنّع الصورة بهذا الشكل"
                      Content="قنّع بالشكل" />
            </StackPanel>

            <!-- بطاقة الموقع والأبعاد الرقمية والمحاذاة للورقة -->
            <Border x:Name="TransformAndAlignCard"
                    IsVisible="{Binding HasSelection}"
                    Background="{DynamicResource ZiwaSurfaceBrush}"
                    BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                    BorderThickness="{StaticResource HairlineBorderThickness}"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Padding="{StaticResource CardPadding}">
              <StackPanel Spacing="6">
                <TextBlock Text="الموقع والأبعاد والمحاذاة (مم)"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
                <WrapPanel Orientation="Horizontal">
                  <Button x:Name="AlignRightPageButton" Margin="0,0,4,4" Classes="workspaceAction statusAction"
                          Command="{Binding AlignSelectionRightCommand}"
                          ToolTip.Tip="محاذاة مع حافة الورقة اليمنى" AutomationProperties.Name="محاذاة يمين الورقة" Content="يمين" />
                  <Button x:Name="AlignCenterHPageButton" Margin="0,0,4,4" Classes="workspaceAction statusAction"
                          Command="{Binding AlignSelectionCenterHCommand}"
                          ToolTip.Tip="توسيط أفقي في منتصف الورقة" AutomationProperties.Name="توسيط أفقي" Content="توسيط ↔" />
                  <Button x:Name="AlignLeftPageButton" Margin="0,0,4,4" Classes="workspaceAction statusAction"
                          Command="{Binding AlignSelectionLeftCommand}"
                          ToolTip.Tip="محاذاة مع حافة الورقة اليسرى" AutomationProperties.Name="محاذاة يسار الورقة" Content="يسار" />
                  <Button x:Name="AlignTopPageButton" Margin="0,0,4,4" Classes="workspaceAction statusAction"
                          Command="{Binding AlignSelectionTopCommand}"
                          ToolTip.Tip="محاذاة مع أعلى الورقة" AutomationProperties.Name="محاذاة أعلى الورقة" Content="أعلى" />
                  <Button x:Name="AlignCenterVPageButton" Margin="0,0,4,4" Classes="workspaceAction statusAction"
                          Command="{Binding AlignSelectionCenterVCommand}"
                          ToolTip.Tip="توسيط رأسي في منتصف الورقة" AutomationProperties.Name="توسيط رأسي" Content="توسيط ↕" />
                  <Button x:Name="AlignBottomPageButton" Margin="0,0,0,4" Classes="workspaceAction statusAction"
                          Command="{Binding AlignSelectionBottomCommand}"
                          ToolTip.Tip="محاذاة مع أسفل الورقة" AutomationProperties.Name="محاذاة أسفل الورقة" Content="أسفل" />
                </WrapPanel>

                <StackPanel Spacing="6" IsVisible="{Binding IsSingleNodeSelected}">
                  <Grid ColumnDefinitions="*,6,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                      <TextBlock Text="الموقع س (X)" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                      <NumericUpDown Increment="0.5" FormatString="0.#" Value="{Binding SelectedNodeXMm}" FlowDirection="LeftToRight"
                                     ToolTip.Tip="الإحداثي الأفقي بالمليمتر" AutomationProperties.Name="الإحداثي الأفقي X" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
                      <TextBlock Text="الموقع ص (Y)" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                      <NumericUpDown Increment="0.5" FormatString="0.#" Value="{Binding SelectedNodeYMm}" FlowDirection="LeftToRight"
                                     ToolTip.Tip="الإحداثي الرأسي بالمليمتر" AutomationProperties.Name="الإحداثي الرأسي Y" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                      <TextBlock Text="العرض (مم)" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                      <NumericUpDown Minimum="2" Maximum="2000" Increment="1" FormatString="0.#" Value="{Binding SelectedNodeWidthMm}" FlowDirection="LeftToRight"
                                     ToolTip.Tip="عرض العنصر بالمليمتر" AutomationProperties.Name="عرض العنصر" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
                      <TextBlock Text="الارتفاع (مم)" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                      <NumericUpDown Minimum="2" Maximum="2000" Increment="1" FormatString="0.#" Value="{Binding SelectedNodeHeightMm}" FlowDirection="LeftToRight"
                                     ToolTip.Tip="ارتفاع العنصر بالمليمتر" AutomationProperties.Name="ارتفاع العنصر" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
                      <TextBlock Text="الدوران (°)" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                      <NumericUpDown Minimum="0" Maximum="360" Increment="5" FormatString="0.#" Value="{Binding SelectedNodeRotationDeg}" FlowDirection="LeftToRight"
                                     ToolTip.Tip="زاوية الدوران بالدرجات" AutomationProperties.Name="زاوية الدوران" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Spacing="2">
                      <TextBlock Text="الشفافية %" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                      <NumericUpDown Minimum="5" Maximum="100" Increment="5" FormatString="0" Value="{Binding SelectedNodeOpacityPercent}" FlowDirection="LeftToRight"
                                     ToolTip.Tip="شفافية العنصر المحدد" AutomationProperties.Name="شفافية العنصر" />
                    </StackPanel>
                  </Grid>
                  <Button x:Name="ApplyNumericTransformButton"
                          Command="{Binding ApplyNumericTransformCommand}"
                          MinHeight="{StaticResource CompactButtonSize}"
                          CornerRadius="{StaticResource ControlCornerRadius}"
                          Background="{DynamicResource ZiwaPrimaryActionBrush}"
                          Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}"
                          ToolTip.Tip="تطبيق القيم الرقمية للموقع والأبعاد والدوران"
                          AutomationProperties.Name="تطبيق الأبعاد والموقع"
                          Content="تطبيق الأبعاد والموقع" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- أدوات الصورة والمرشحات والذكاء الاصطناعي المحلي (تُطوى تلقائياً عند تحديد ملصق) -->
            <StackPanel x:Name="PhotoAndFilterToolsPanel" Spacing="6" IsVisible="{Binding IsPhotoToolsVisible}">
              <Border x:Name="OfflineAiCard"
                      IsVisible="{Binding IsPhotoAiTargetVisible}"
                      Background="{DynamicResource ZiwaSurfaceBrush}"
                      BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                      BorderThickness="{StaticResource HairlineBorderThickness}"
                      CornerRadius="{StaticResource OverlayCornerRadius}"
                      Padding="{StaticResource CardPadding}">
                <StackPanel Spacing="6">
                  <TextBlock Text="الذكاء الاصطناعي المحلي (أوفلاين)"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
                  <Button x:Name="InspectorRemoveBgButton"
                          Command="{Binding RemoveBackgroundCommand}"
                          IsEnabled="{Binding IsAllAiIdle}"
                          MinHeight="{StaticResource CompactButtonSize}"
                          CornerRadius="{StaticResource ControlCornerRadius}"
                          Background="{DynamicResource ZiwaPrimaryActionBrush}"
                          Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}"
                          ToolTip.Tip="عزل الخلفية محلياً عبر ONNX مع حفظ تفاصيل الشعر (Ctrl+Shift+B)"
                          AutomationProperties.Name="عزل الخلفية تلقائياً"
                          Content="عزل الخلفية تلقائياً" />
                  <Button x:Name="InspectorEditMaskButton"
                          Command="{Binding OpenMaskEditorCommand}"
                          IsEnabled="{Binding IsAllAiIdle}"
                          MinHeight="{StaticResource CompactButtonSize}"
                          CornerRadius="{StaticResource ControlCornerRadius}"
                          Background="{DynamicResource ZiwaSubtleFillBrush}"
                          Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                          ToolTip.Tip="فتح محرر القناع اليدوي بفرشاة المسح والاستعادة ومعاينة قبل/بعد"
                          AutomationProperties.Name="تعديل القناع بالفرشاة"
                          Content="تعديل القناع بالفرشاة (قبل/بعد)" />
                  <TextBlock Text="معيار تأطير الوجه للهوية"
                             FontSize="11"
                             Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                  <ComboBox x:Name="FramingPresetComboBox"
                            ItemsSource="{Binding AvailableFramingPresets}"
                            SelectedItem="{Binding SelectedFramingPresetOption}"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:IdPhotoFramingPresetOption">
                        <TextBlock Text="{Binding TitleAr}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button x:Name="InspectorAutoFrameFaceButton"
                          Command="{Binding AutoFrameFaceCommand}"
                          IsEnabled="{Binding IsAllAiIdle}"
                          MinHeight="{StaticResource CompactButtonSize}"
                          CornerRadius="{StaticResource ControlCornerRadius}"
                          Background="{DynamicResource ZiwaSubtleFillBrush}"
                          Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                          ToolTip.Tip="توسيط الرأس والكتفين تلقائياً وفق نسب صور الهوية (Ctrl+Shift+F)"
                          AutomationProperties.Name="تأطير الوجه لصور الهوية"
                          Content="تأطير الوجه لصور الهوية" />
                  <Button x:Name="InspectorOpenScannerButton"
                          Command="{Binding OpenDocumentScannerCommand}"
                          IsEnabled="{Binding IsScannerToolsEnabled}"
                          MinHeight="{StaticResource CompactButtonSize}"
                          CornerRadius="{StaticResource ControlCornerRadius}"
                          Background="{DynamicResource ZiwaSubtleFillBrush}"
                          Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                          ToolTip.Tip="فتح ماسح المستندات والبطاقات واستعدال المنظور (Ctrl+Shift+D)"
                          AutomationProperties.Name="ماسح المستندات والبطاقات"
                          Content="ماسح المستندات والمنظور" />
                  <StackPanel x:Name="AiWaitPanel" Spacing="4" IsVisible="{Binding IsAiBusy}">
                    <ProgressBar IsIndeterminate="True" Minimum="0" Maximum="100" />
                    <TextBlock Text="{Binding AiBusyStatusText}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ZiwaInfoBrush}" />
                    <Button x:Name="CancelAiOperationButton"
                            Command="{Binding CancelAiOperationCommand}"
                            MinHeight="{StaticResource CompactButtonSize}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{DynamicResource ZiwaSubtleFillBrush}"
                            Foreground="{DynamicResource ZiwaDestructiveActionBrush}"
                            ToolTip.Tip="إلغاء عملية الذكاء الاصطناعي الجارية فوراً"
                            AutomationProperties.Name="إلغاء الاستدلال المحلي"
                            Content="إلغاء الاستدلال" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border x:Name="CloudAiCard"
                      IsVisible="{Binding IsPhotoAiTargetVisible}"
                      Background="{DynamicResource ZiwaSurfaceBrush}"
                      BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                      BorderThickness="{StaticResource HairlineBorderThickness}"
                      CornerRadius="{StaticResource OverlayCornerRadius}"
                      Padding="{StaticResource CardPadding}">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="الترميم السحابي المزدوج (Modal 2x)"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
                    <Border Grid.Column="1"
                            Background="{DynamicResource ZiwaSubtleFillBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="6,2">
                      <TextBlock x:Name="CloudQuotaBadgeTextBlock"
                                 Text="{Binding CloudQuotaBadgeText}"
                                 FontSize="10"
                                 Foreground="{DynamicResource ZiwaInfoBrush}" />
                    </Border>
                  </Grid>
                  <Button x:Name="InspectorCloudEnhanceButton"
                          Command="{Binding EnhancePhotoCloudCommand}"
                          IsEnabled="{Binding IsAllAiIdle}"
                          MinHeight="{StaticResource CompactButtonSize}"
                          CornerRadius="{StaticResource ControlCornerRadius}"
                          Background="{DynamicResource ZiwaPrimaryActionBrush}"
                          Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}"
                          ToolTip.Tip="ترميم الوجوه بـ CodeFormer ومضاعفة الدقة 2x عبر Modal CPU (Ctrl+Shift+U)"
                          AutomationProperties.Name="ترميم الوجوه ومضاعفة الدقة 2x"
                          Content="ترميم الوجوه ومضاعفة الدقة 2x" />
                  <StackPanel x:Name="CloudAiWaitPanel" Spacing="4" IsVisible="{Binding IsCloudAiBusy}">
                    <ProgressBar IsIndeterminate="True" Minimum="0" Maximum="100" />
                    <TextBlock Text="{Binding CloudAiBusyStatusText}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ZiwaInfoBrush}" />
                    <Button x:Name="CancelCloudAiButton"
                            Command="{Binding CancelCloudAiOperationCommand}"
                            MinHeight="{StaticResource CompactButtonSize}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Background="{DynamicResource ZiwaSubtleFillBrush}"
                            Foreground="{DynamicResource ZiwaDestructiveActionBrush}"
                            ToolTip.Tip="إلغاء الترميم السحابي فوراً دون إعادة محاولة"
                            AutomationProperties.Name="إلغاء الترميم السحابي"
                            Content="إلغاء الترميم السحابي" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <TextBlock Text="مرشحات الصورة الموحدة" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
              <ComboBox x:Name="FilterPresetComboBox"
                        ItemsSource="{Binding AvailableFilterPresetOptions}"
                        SelectedItem="{Binding SelectedFilterPresetOption}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="اختيار مرشح لوني جاهز للصورة"
                        AutomationProperties.Name="مرشح الصورة الجاهز">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FilterPresetOption">
                    <TextBlock Text="{Binding TitleAr}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Text="سطوع" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                <Slider x:Name="FilterBrightnessSlider" Grid.Column="1" Minimum="-1" Maximum="1" TickFrequency="0.05" Value="{Binding FilterBrightness}" />
                <TextBlock Grid.Column="2" Text="{Binding FilterBrightnessLabel}" FlowDirection="LeftToRight" Width="38" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Text="تباين" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                <Slider x:Name="FilterContrastSlider" Grid.Column="1" Minimum="-1" Maximum="1" TickFrequency="0.05" Value="{Binding FilterContrast}" />
                <TextBlock Grid.Column="2" Text="{Binding FilterContrastLabel}" FlowDirection="LeftToRight" Width="38" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Text="تشبع" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                <Slider x:Name="FilterSaturationSlider" Grid.Column="1" Minimum="-1" Maximum="1" TickFrequency="0.05" Value="{Binding FilterSaturation}" />
                <TextBlock Grid.Column="2" Text="{Binding FilterSaturationLabel}" FlowDirection="LeftToRight" Width="38" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="ApplyFilterButton"
                        Command="{Binding ApplyImageFiltersCommand}"
                        MinHeight="{StaticResource CompactButtonSize}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource ZiwaPrimaryActionBrush}"
                        Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}"
                        ToolTip.Tip="تطبيق المرشح على الصورة أو الخانة"
                        AutomationProperties.Name="تطبيق المرشح"
                        Content="تطبيق" />
                <Button x:Name="ApplyFilterAllSlotsButton"
                        Command="{Binding ApplyFiltersToAllSlotsCommand}"
                        IsVisible="{Binding IsCollageMode}"
                        MinHeight="{StaticResource CompactButtonSize}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource ZiwaSubtleFillBrush}"
                        Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                        ToolTip.Tip="تطبيق على كل الخانات"
                        AutomationProperties.Name="تطبيق على كل الخانات"
                        Content="على كل الخانات" />
                <Button x:Name="ResetFilterButton"
                        Command="{Binding ResetImageOrSlotFiltersCommand}"
                        MinHeight="{StaticResource CompactButtonSize}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource ZiwaSubtleFillBrush}"
                        Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                        ToolTip.Tip="إعادة تعيين المرشحات"
                        AutomationProperties.Name="إعادة تعيين المرشح"
                        Content="إعادة تعيين" />
              </StackPanel>

              <Button x:Name="RestoreOriginalImageButton"
                      Command="{Binding RestoreOriginalImageCommand}"
                      IsVisible="{Binding CanRestoreOriginalTarget}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                      ToolTip.Tip="استعادة الصورة الأصلية وإلغاء العزل والقص"
                      AutomationProperties.Name="استعادة الأصل"
                      Content="استعادة الأصل" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding IsPhotoToolsVisible}">
              <TextBlock Text="قناع وزاوية الصورة" FontSize="12" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
              <ComboBox x:Name="ImageMaskComboBox"
                        ItemsSource="{Binding AvailableMaskOptions}"
                        SelectedItem="{Binding SelectedMaskOption}"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="اختيار شكل قناع قص غير هدام للصورة أو خانة الكولاج"
                        AutomationProperties.Name="قناع الصورة">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:MaskOption">
                    <TextBlock Text="{Binding TitleAr}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button x:Name="ApplyMaskAllSlotsButton"
                      Command="{Binding ApplyMaskToAllSlotsCommand}"
                      IsVisible="{Binding IsCollageMode}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaSubtleFillBrush}"
                      Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                      ToolTip.Tip="تطبيق شكل القناع على جميع خانات شيت الكولاج"
                      AutomationProperties.Name="تعميم القناع على كل الخانات"
                      Content="تعميم القناع لكل الخانات" />
            </StackPanel>

            <!-- زوايا وإطار خانة الكولاج -->
            <Border IsVisible="{Binding IsCollageSlotSelected}"
                    Background="{DynamicResource ZiwaSurfaceBrush}"
                    BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                    BorderThickness="{StaticResource HairlineBorderThickness}"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Padding="{StaticResource CardPadding}">
              <StackPanel Spacing="6">
                <TextBlock Text="إطار وزوايا الخانة (مم)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
                <Grid ColumnDefinitions="*,6,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                  <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                    <TextBlock Text="تدوير الزوايا" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                    <NumericUpDown x:Name="CollageSlotCornerRadiusInput"
                                   Minimum="0" Maximum="25" Increment="0.5" FormatString="0.#"
                                   Value="{Binding CollageSlotCornerRadiusMm}" FlowDirection="LeftToRight"
                                   ToolTip.Tip="نصف قطر استدارة زوايا الخانة بالمليمتر"
                                   AutomationProperties.Name="استدارة زوايا الخانة" />
                  </StackPanel>
                  <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
                    <TextBlock Text="سمك الإطار" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                    <NumericUpDown x:Name="CollageSlotBorderWidthInput"
                                   Minimum="0" Maximum="10" Increment="0.2" FormatString="0.#"
                                   Value="{Binding CollageSlotBorderWidthMm}" FlowDirection="LeftToRight"
                                   ToolTip.Tip="سمك إطار خانة الكولاج بالمليمتر (0 لإلغاء الإطار)"
                                   AutomationProperties.Name="سمك إطار الخانة" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="لون الإطار:" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                    <ColorPicker x:Name="CollageSlotBorderColorPicker"
                                 Color="{Binding CollageSlotBorderColor}"
                                 ToolTip.Tip="اختيار لون إطار خانة الكولاج"
                                 AutomationProperties.Name="لون إطار الخانة" />
                  </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button x:Name="ApplySlotStyleButton"
                          Command="{Binding ApplySlotStyleCommand}"
                          MinHeight="{StaticResource CompactButtonSize}"
                          CornerRadius="{StaticResource ControlCornerRadius}"
                          Background="{DynamicResource ZiwaPrimaryActionBrush}"
                          Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}"
                          ToolTip.Tip="تطبيق استدارة الزوايا والإطار على الخانة المحددة"
                          AutomationProperties.Name="تطبيق نمط الخانة"
                          Content="تطبيق الإطار" />
                  <Button x:Name="ApplySlotStyleAllButton"
                          Command="{Binding ApplySlotStyleToAllCommand}"
                          MinHeight="{StaticResource CompactButtonSize}"
                          CornerRadius="{StaticResource ControlCornerRadius}"
                          Background="{DynamicResource ZiwaSubtleFillBrush}"
                          Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                          ToolTip.Tip="تعميم الزوايا والإطار على جميع خانات الشيت"
                          AutomationProperties.Name="تعميم الإطار على كل الخانات"
                          Content="لكل الخانات" />
                </StackPanel>
              </StackPanel>
            </Border>

            <StackPanel Spacing="6" IsVisible="{Binding IsSvgSelected}">
              <TextBlock Text="لون الشعار المتجه" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <ColorPicker x:Name="SvgTintColorPicker" Grid.Column="0" Color="{Binding SelectedSvgTintColor}"
                             ToolTip.Tip="اختيار لون تلوين الشعار" AutomationProperties.Name="لون الشعار" />
                <Button x:Name="ToggleSvgTintButton"
                        Grid.Column="1"
                        Command="{Binding ToggleSvgTintCommand}"
                        HorizontalAlignment="Stretch"
                        MinHeight="{StaticResource CompactButtonSize}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource ZiwaPrimaryActionBrush}"
                        Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}"
                        ToolTip.Tip="تلوين الشعار المتجه بضغطة واحدة"
                        AutomationProperties.Name="تلوين الشعار"
                        Content="تلوين سريع" />
                <Button x:Name="ClearSvgTintButton"
                        Grid.Column="2"
                        Command="{Binding ClearSvgTintCommand}"
                        MinHeight="{StaticResource CompactButtonSize}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource ZiwaSubtleFillBrush}"
                        Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                        ToolTip.Tip="استعادة ألوان الشعار الأصلية"
                        AutomationProperties.Name="إزالة تلوين الشعار"
                        Content="أصلي" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding IsShapeSelected}">
              <TextBlock Text="مظهر الشكل الهندسي والحدود" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <ColorPicker x:Name="ShapeFillColorPicker" Grid.Column="0" Color="{Binding SelectedShapeFillColor}"
                             ToolTip.Tip="اختيار لون تعبئة الشكل" AutomationProperties.Name="لون الشكل" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="الشفافية %" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                  <Slider x:Name="ShapeOpacitySlider" Minimum="10" Maximum="100" TickFrequency="5" Value="{Binding SelectedShapeOpacityPercent}" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <ColorPicker x:Name="ShapeStrokeColorPicker" Grid.Column="0" Color="{Binding SelectedShapeStrokeColor}"
                             ToolTip.Tip="لون حدود الشكل أو الخط" AutomationProperties.Name="لون حدود الشكل" />
                <TextBlock Grid.Column="1" Text="سُمك الحدود (مم)" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                <NumericUpDown x:Name="ShapeStrokeWidthNumeric" Grid.Column="2" Width="82" Minimum="0" Maximum="20" Increment="0.2" FormatString="0.#"
                               Value="{Binding SelectedShapeStrokeWidthMm}" FlowDirection="LeftToRight"
                               ToolTip.Tip="سُمك حدود الشكل بالمليمتر (0 لإلغاء الحدود)" AutomationProperties.Name="سُمك حدود الشكل" />
              </Grid>
              <Button x:Name="ApplyShapeStyleButton"
                      Command="{Binding ApplySelectedShapeStyleCommand}"
                      MinHeight="{StaticResource CompactButtonSize}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Background="{DynamicResource ZiwaPrimaryActionBrush}"
                      Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}"
                      ToolTip.Tip="تطبيق التعبئة والحدود والشفافية على الشكل المحدد"
                      AutomationProperties.Name="تطبيق نمط الشكل"
                      Content="تطبيق نمط الشكل" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding IsTextSelected}">
              <TextBlock Text="تحرير وتنسيق النص والانحناء" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
              <TextBox Text="{Binding SelectedTextContent}"
                       AcceptsReturn="True"
                       MinHeight="56" />
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <ColorPicker x:Name="TextColorPicker" Grid.Column="0" Color="{Binding SelectedTextColor}"
                             ToolTip.Tip="لون النص" AutomationProperties.Name="لون النص" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFontFamilies}" SelectedItem="{Binding SelectedTextFontFamily}" HorizontalAlignment="Stretch"
                          ToolTip.Tip="اختيار نوع الخط" AutomationProperties.Name="نوع الخط" />
                <NumericUpDown Grid.Column="2" Width="76" Minimum="6" Maximum="240" Increment="2" FormatString="0" Value="{Binding SelectedTextFontSizePt}" FlowDirection="LeftToRight"
                               ToolTip.Tip="حجم الخط بالنقاط" AutomationProperties.Name="حجم الخط" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                  <Button x:Name="AlignTextRightButton" Classes="workspaceAction statusAction" Classes.active="{Binding IsTextAlignRight}"
                          Command="{Binding AlignTextRightCommand}" ToolTip.Tip="محاذاة النص لليمين" AutomationProperties.Name="محاذاة النص يمين" Content="يمين" />
                  <Button x:Name="AlignTextCenterButton" Classes="workspaceAction statusAction" Classes.active="{Binding IsTextAlignCenter}"
                          Command="{Binding AlignTextCenterCommand}" ToolTip.Tip="توسيط النص" AutomationProperties.Name="توسيط النص" Content="وسط" />
                  <Button x:Name="AlignTextLeftButton" Classes="workspaceAction statusAction" Classes.active="{Binding IsTextAlignLeft}"
                          Command="{Binding AlignTextLeftCommand}" ToolTip.Tip="محاذاة النص لليسار" AutomationProperties.Name="محاذاة النص يسار" Content="يسار" />
                </StackPanel>
                <CheckBox x:Name="TextBoldCheckBox" Grid.Column="1" IsChecked="{Binding SelectedTextBold}" VerticalAlignment="Center"
                          ToolTip.Tip="جعل النص عريضاً" AutomationProperties.Name="خط عريض" Content="عريض" />
              </Grid>
              <StackPanel Spacing="4">
                <TextBlock Text="مسار وانحناء النص" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                <ComboBox x:Name="TextCurveKindComboBox"
                          ItemsSource="{Binding AvailableTextCurveOptions}"
                          SelectedItem="{Binding SelectedTextCurveOption}"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="تحويل النص إلى قوس علوي أو سفلي أو دائرة ختم"
                          AutomationProperties.Name="انحناء النص">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TextCurveOption">
                      <TextBlock Text="{Binding TitleAr}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" IsVisible="{Binding HasSelectedTextCurve}">
                  <TextBlock Grid.Column="0" Text="شدة القوس" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                  <Slider x:Name="TextCurveBendSlider" Grid.Column="1" Minimum="0.2" Maximum="1.0" TickFrequency="0.05" Value="{Binding SelectedTextCurveBend}" />
                  <TextBlock Grid.Column="2" Text="{Binding SelectedTextCurveBend, StringFormat='{}{0:0.##}'}" FlowDirection="LeftToRight" Width="34" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                  <TextBlock Grid.Column="0" Text="تباعد الأحرف" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                  <Slider x:Name="TextLetterSpacingSlider" Grid.Column="1" Minimum="-0.05" Maximum="0.35" TickFrequency="0.02" Value="{Binding SelectedTextLetterSpacingEm}" />
                  <TextBlock Grid.Column="2" Text="{Binding SelectedTextLetterSpacingEm, StringFormat='{}{0:0.##}'}" FlowDirection="LeftToRight" Width="34" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                </Grid>
              </StackPanel>
              <Border Background="{DynamicResource ZiwaSurfaceBrush}"
                      BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                      BorderThickness="{StaticResource HairlineBorderThickness}"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Padding="6">
                <StackPanel Spacing="6">
                  <TextBlock Text="تأثيرات النص (الحدود، الكبسولة، الظل)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                  <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6">
                    <CheckBox x:Name="TextOutlineCheckBox" Grid.Column="0" IsChecked="{Binding SelectedTextHasOutline}"
                              ToolTip.Tip="إضافة حد خارجي حول أحرف النص" AutomationProperties.Name="حد خارجي للنص" Content="حد خارجي" />
                    <ColorPicker x:Name="TextOutlineColorPicker" Grid.Column="1" Color="{Binding SelectedTextOutlineColor}"
                                 ToolTip.Tip="لون الحد الخارجي للنص" AutomationProperties.Name="لون الحد الخارجي للنص" />
                    <NumericUpDown x:Name="TextOutlineWidthNumeric" Grid.Column="2" Minimum="0.1" Maximum="5" Increment="0.1" FormatString="0.##"
                                   Value="{Binding SelectedTextOutlineWidthMm}" FlowDirection="LeftToRight"
                                   ToolTip.Tip="سُمك الحد الخارجي للنص بالمليمتر" AutomationProperties.Name="سُمك حد النص" />
                  </Grid>
                  <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                    <CheckBox x:Name="TextPillCheckBox" Grid.Column="0" IsChecked="{Binding SelectedTextHasPill}"
                              ToolTip.Tip="تفعيل خلفية شارة كبسولة خلف النص" AutomationProperties.Name="خلفية كبسولة للنص" Content="كبسولة" />
                    <ColorPicker x:Name="TextPillColorPicker" Grid.Column="1" Color="{Binding SelectedTextPillColor}"
                                 ToolTip.Tip="لون خلفية الشارة الكبسولة" AutomationProperties.Name="لون الكبسولة" />
                    <CheckBox x:Name="TextShadowCheckBox" Grid.Column="2" IsChecked="{Binding SelectedTextHasShadow}"
                              ToolTip.Tip="إضافة ظل ناعم للنص" AutomationProperties.Name="ظل النص" Content="ظل" />
                  </Grid>
                  <Button x:Name="ApplyTextEffectsButton"
                          Command="{Binding ApplySelectedTextEffectsCommand}"
                          MinHeight="{StaticResource CompactButtonSize}"
                          CornerRadius="{StaticResource ControlCornerRadius}"
                          Background="{DynamicResource ZiwaSubtleFillBrush}"
                          Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                          ToolTip.Tip="تحديث ألوان وسُمك تأثيرات النص"
                          AutomationProperties.Name="تطبيق تأثيرات النص"
                          Content="تحديث التأثيرات" />
                </StackPanel>
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="CommitTextButton"
                        Command="{Binding CommitSelectedTextCommand}"
                        MinHeight="{StaticResource CompactButtonSize}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource ZiwaPrimaryActionBrush}"
                        Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}"
                        ToolTip.Tip="اعتماد تعديل النص"
                        AutomationProperties.Name="اعتماد النص"
                        Content="تطبيق النص" />
                <Button x:Name="ApplyTextStyleButton"
                        Command="{Binding ApplySelectedTextStyleCommand}"
                        MinHeight="{StaticResource CompactButtonSize}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource ZiwaSubtleFillBrush}"
                        Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                        ToolTip.Tip="تطبيق الخط والحجم واللون"
                        AutomationProperties.Name="تطبيق تنسيق النص"
                        Content="تطبيق التنسيق" />
              </StackPanel>
            </StackPanel>

            <!-- إعدادات شبكة الكولاج وقائمة الانتظار -->
            <Border IsVisible="{Binding IsCollageMode}"
                    Background="{DynamicResource ZiwaSurfaceBrush}"
                    BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                    BorderThickness="{StaticResource HairlineBorderThickness}"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Padding="{StaticResource CardPadding}">
              <StackPanel Spacing="6">
                <TextBlock Text="شبكة الكولاج والهوية (مم)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
                <TextBlock Text="{Binding CollageSheetSummaryText}" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                <StackPanel Spacing="2">
                  <TextBlock Text="قالب الهوية / الشبكة" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                  <ComboBox x:Name="CollagePresetComboBox"
                            ItemsSource="{Binding AvailableCollagePresetOptions}"
                            SelectedItem="{Binding SelectedCollagePresetOption}"
                            HorizontalAlignment="Stretch"
                            ToolTip.Tip="اختيار مقاس صور هوية أو شبكة كولاج جاهزة"
                            AutomationProperties.Name="قالب الكولاج الجاهز">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:CollagePresetOption">
                        <TextBlock Text="{Binding TitleAr}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <Grid ColumnDefinitions="*,6,*">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="نمط المقاس" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                    <ComboBox x:Name="CollageSizingModeComboBox"
                              ItemsSource="{Binding AvailableCollageSizingOptions}"
                              SelectedItem="{Binding SelectedCollageSizingOption}"
                              HorizontalAlignment="Stretch"
                              ToolTip.Tip="تحديد مقاس الخلية بالمليمتر أو التمديد لملء الورقة"
                              AutomationProperties.Name="نمط مقاس الكولاج">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CollageSizingModeOption">
                          <TextBlock Text="{Binding TitleAr}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="المحاذاة" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                    <ComboBox x:Name="CollageAlignmentComboBox"
                              ItemsSource="{Binding AvailableCollageAlignmentOptions}"
                              SelectedItem="{Binding SelectedCollageAlignmentOption}"
                              HorizontalAlignment="Stretch"
                              ToolTip.Tip="موضع محاذاة شبكة الكولاج داخل الورقة"
                              AutomationProperties.Name="محاذاة شبكة الكولاج">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GridAlignmentOption">
                          <TextBlock Text="{Binding TitleAr}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,6,*" IsVisible="{Binding IsCollageFixedPhysicalSizing}">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="عرض الخلية (مم)" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                    <NumericUpDown x:Name="CollageCellWidthInput"
                                   Minimum="10" Maximum="250" Increment="1" FormatString="0.#"
                                   Value="{Binding CollageCellWidthInputMm}" FlowDirection="LeftToRight"
                                   ToolTip.Tip="العرض الفيزيائي الفعلي لكل صورة هوية بالمليمتر"
                                   AutomationProperties.Name="عرض خانة الكولاج" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="ارتفاع الخلية (مم)" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                    <NumericUpDown x:Name="CollageCellHeightInput"
                                   Minimum="10" Maximum="250" Increment="1" FormatString="0.#"
                                   Value="{Binding CollageCellHeightInputMm}" FlowDirection="LeftToRight"
                                   ToolTip.Tip="الارتفاع الفيزيائي الفعلي لكل صورة هوية بالمليمتر"
                                   AutomationProperties.Name="ارتفاع خانة الكولاج" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,6,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                  <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                    <TextBlock Text="الصفوف" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                    <NumericUpDown Minimum="1" Maximum="12" Increment="1" FormatString="0" Value="{Binding CollageRowsInput}" FlowDirection="LeftToRight"
                                   ToolTip.Tip="عدد صفوف شبكة الكولاج" AutomationProperties.Name="صفوف الكولاج" />
                  </StackPanel>
                  <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
                    <TextBlock Text="الأعمدة" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                    <NumericUpDown Minimum="1" Maximum="12" Increment="1" FormatString="0" Value="{Binding CollageColumnsInput}" FlowDirection="LeftToRight"
                                   ToolTip.Tip="عدد أعمدة شبكة الكولاج" AutomationProperties.Name="أعمدة الكولاج" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                    <TextBlock Text="الفجوة" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                    <NumericUpDown Minimum="0" Maximum="25" Increment="0.5" FormatString="0.#" Value="{Binding CollageGapInputMm}" FlowDirection="LeftToRight"
                                   ToolTip.Tip="المسافة بين خانات الكولاج بالمليمتر" AutomationProperties.Name="فجوة الكولاج" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
                    <TextBlock Text="الهامش" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                    <NumericUpDown Minimum="0" Maximum="30" Increment="0.5" FormatString="0.#" Value="{Binding CollageMarginInputMm}" FlowDirection="LeftToRight"
                                   ToolTip.Tip="هامش شبكة الكولاج الخارجي بالمليمتر" AutomationProperties.Name="هامش الكولاج" />
                  </StackPanel>
                </Grid>
                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                  <Button x:Name="ApplyCollageGridButton"
                          Command="{Binding ApplyCollageGridAdjustmentsCommand}"
                          MinHeight="{StaticResource CompactButtonSize}"
                          CornerRadius="{StaticResource ControlCornerRadius}"
                          Background="{DynamicResource ZiwaPrimaryActionBrush}"
                          Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}"
                          ToolTip.Tip="تحديث صفوف وأعمدة ومقاس وفجوات شبكة الكولاج"
                          AutomationProperties.Name="تطبيق شبكة الكولاج"
                          Content="تطبيق الشبكة" />
                  <Button x:Name="ToggleAutoRepeatButton"
                          Command="{Binding ToggleAutoRepeatCommand}"
                          MinHeight="{StaticResource CompactButtonSize}"
                          CornerRadius="{StaticResource ControlCornerRadius}"
                          Background="{DynamicResource ZiwaSubtleFillBrush}"
                          Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                          ToolTip.Tip="تفعيل أو إيقاف تكرار صورة الهوية على كامل الشيت"
                          AutomationProperties.Name="تكرار صورة الهوية"
                          Content="{Binding AutoRepeatToggleText}" />
                  <Button x:Name="ClearAllCollageSlotsButton"
                          Command="{Binding ClearAllCollageSlotsCommand}"
                          MinHeight="{StaticResource CompactButtonSize}"
                          CornerRadius="{StaticResource ControlCornerRadius}"
                          Background="{DynamicResource ZiwaSubtleFillBrush}"
                          Foreground="{DynamicResource ZiwaDestructiveActionBrush}"
                          ToolTip.Tip="تفريغ جميع خانات شيت الكولاج الحالي"
                          AutomationProperties.Name="تفريغ كل الخانات"
                          Content="تفريغ الكل" />
                </WrapPanel>
                <StackPanel Spacing="4" IsVisible="{Binding HasPendingCollageAssets}">
                  <TextBlock Text="{Binding CollagePendingBadgeText}" FontSize="11" Foreground="{DynamicResource ZiwaInfoBrush}" />
                  <Button x:Name="DistributePendingCollageButton"
                          Command="{Binding AutoDistributePendingCollageAssetsCommand}"
                          MinHeight="{StaticResource CompactButtonSize}"
                          CornerRadius="{StaticResource ControlCornerRadius}"
                          Background="{DynamicResource ZiwaSubtleFillBrush}"
                          Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                          ToolTip.Tip="توزيع الصور المنتظرة تلقائياً في الخانات الشاغرة"
                          AutomationProperties.Name="توزيع الصور المنتظرة"
                          Content="توزيع الصور المنتظرة" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- اسم المشروع ومقاس الورقة والنزيف بالمليمتر -->
            <Border Background="{DynamicResource ZiwaSurfaceBrush}"
                    BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                    BorderThickness="{StaticResource HairlineBorderThickness}"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Padding="{StaticResource CardPadding}">
              <StackPanel Spacing="6">
                <TextBlock Text="المشروع والورقة (مم)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
                <Grid ColumnDefinitions="*,6,Auto">
                  <TextBox x:Name="DocumentTitleInputBox" Grid.Column="0"
                           Text="{Binding EditableDocumentTitle}"
                           Watermark="اسم المشروع..."
                           ToolTip.Tip="تعديل عنوان المشروع الظاهر في المكتبة والمطبوعات"
                           AutomationProperties.Name="اسم المشروع" />
                  <Button x:Name="RenameDocumentButton" Grid.Column="2"
                          Command="{Binding RenameDocumentCommand}"
                          MinHeight="{StaticResource CompactButtonSize}"
                          CornerRadius="{StaticResource ControlCornerRadius}"
                          Background="{DynamicResource ZiwaSubtleFillBrush}"
                          Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                          ToolTip.Tip="حفظ الاسم الجديد للمشروع"
                          AutomationProperties.Name="تسمية المشروع"
                          Content="تسمية" />
                </Grid>
                <ComboBox ItemsSource="{Binding AvailablePaperPresets}" SelectedItem="{Binding SelectedPaperPreset}" HorizontalAlignment="Stretch"
                          ToolTip.Tip="اختيار مقاس ورق جاهز" AutomationProperties.Name="مقاسات الورق الجاهزة">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PaperPresetOption">
                      <TextBlock Text="{Binding TitleAr}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Grid ColumnDefinitions="*,6,*,6,*">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="العرض" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                    <NumericUpDown Minimum="10" Maximum="2000" Increment="1" FormatString="0.#" Value="{Binding PageWidthInputMm}" FlowDirection="LeftToRight"
                                   ToolTip.Tip="عرض الورقة بالمليمتر" AutomationProperties.Name="عرض الورقة" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="الارتفاع" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                    <NumericUpDown Minimum="10" Maximum="2000" Increment="1" FormatString="0.#" Value="{Binding PageHeightInputMm}" FlowDirection="LeftToRight"
                                   ToolTip.Tip="ارتفاع الورقة بالمليمتر" AutomationProperties.Name="ارتفاع الورقة" />
                  </StackPanel>
                  <StackPanel Grid.Column="4" Spacing="2">
                    <TextBlock Text="النزيف" FontSize="11" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                    <NumericUpDown Minimum="0" Maximum="25" Increment="0.5" FormatString="0.#" Value="{Binding PageBleedInputMm}" FlowDirection="LeftToRight"
                                   ToolTip.Tip="مساحة النزيف بالمليمتر" AutomationProperties.Name="النزيف" />
                  </StackPanel>
                </Grid>
                <Button x:Name="ApplyPageGeometryButton"
                        Command="{Binding ApplyPageGeometryCommand}"
                        MinHeight="{StaticResource CompactButtonSize}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{DynamicResource ZiwaSubtleFillBrush}"
                        Foreground="{DynamicResource ZiwaPrimaryTextBrush}"
                        ToolTip.Tip="تطبيق مقاس الورقة والنزيف بالمليمتر على الصفحات"
                        AutomationProperties.Name="تطبيق مقاس الورقة"
                        Content="تطبيق المقاس" />
              </StackPanel>
            </Border>

            <TextBlock Text="الطبقات وعناصر الصفحة"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />

            <ItemsControl x:Name="LayersListControl" ItemsSource="{Binding LayerItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SceneLayerItemViewModel">
                  <Border Margin="0,0,0,6"
                          Padding="6"
                          Background="{DynamicResource ZiwaSurfaceBrush}"
                          BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                          BorderThickness="{StaticResource HairlineBorderThickness}"
                          CornerRadius="{StaticResource ControlCornerRadius}">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                      <Button Grid.Column="0"
                              Classes="workspaceAction statusAction"
                              Classes.active="{Binding IsSelected}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              IsEnabled="{Binding CanSelectOnCanvas}"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectLayerCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="{Binding LayerTip}"
                              AutomationProperties.Name="{Binding SelectAccessibleName}">
                        <StackPanel Spacing="1">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding KindBadgeAr}"
                                       FontSize="10"
                                       Foreground="{DynamicResource ZiwaInfoBrush}"
                                       VerticalAlignment="Center" />
                          </Grid>
                          <TextBlock Text="{Binding DimensionsText}"
                                     FlowDirection="LeftToRight"
                                     HorizontalAlignment="Right"
                                     FontSize="10"
                                     Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="1"
                              Classes="workspaceAction statusAction"
                              Classes.active="{Binding !IsVisible}"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleLayerVisibilityCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="تبديل إظهار أو إخفاء هذه الطبقة"
                              AutomationProperties.Name="{Binding VisibilityAccessibleName}"
                              Content="{Binding VisibilityLabel}" />
                      <Button Grid.Column="2"
                              Classes="workspaceAction statusAction"
                              Classes.active="{Binding IsLocked}"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleLayerLockCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="تبديل قفل أو فتح هذه الطبقة"
                              AutomationProperties.Name="{Binding LockAccessibleName}"
                              Content="{Binding LockLabel}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <workspace:PageStripView x:Name="PageStripRegion" Grid.Row="3" IsVisible="{Binding IsChromeVisible}" />
    <workspace:WorkspaceStatusBarView x:Name="StatusBarRegion" Grid.Row="4" IsVisible="{Binding IsChromeVisible}" />

    <views:ProjectLibraryView Grid.RowSpan="5" IsVisible="{Binding IsProjectLibraryOpen}" />
    <views:AiMaskEditorView Grid.RowSpan="5" IsVisible="{Binding IsMaskEditorOpen}" />
    <views:DocumentScannerView Grid.RowSpan="5" IsVisible="{Binding IsDocumentScannerOpen}" />
    <views:AccountLicenseView Grid.RowSpan="5" IsVisible="{Binding IsAccountDialogOpen}" />
    <views:PhoneBridgeView Grid.RowSpan="5" IsVisible="{Binding IsPhoneBridgeDialogOpen}" />
    <views:AppUpdateView Grid.RowSpan="5" IsVisible="{Binding IsUpdateDialogOpen}" />
    <WindowNotificationManager x:Name="ToastNotificationManager" Grid.RowSpan="5" Position="BottomLeft" MaxItems="3" />
  </Grid>
</Window>
