<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ziwa.App.ViewModels"
             xmlns:controls="using:Ziwa.App.Controls"
             x:Class="Ziwa.App.Views.AccountLicenseView"
             x:DataType="vm:MainWindowViewModel"
             FlowDirection="RightToLeft">
  <controls:StudioDialogShell Title="الحساب، الاشتراك، والحصة السحابية"
                              CloseCommand="{Binding CloseAccountDialogCommand}"
                              IsCloseEnabled="{Binding IsAccountIdle}"
                              CloseToolTip="إغلاق نافذة الحساب والترخيص (Esc)"
                              CloseAccessibleName="إغلاق نافذة الحساب"
                              DialogWidth="520"
                              DialogMaxHeight="760">
    <StackPanel Spacing="12">
      <!-- تنبيه طرد الجلسة عند الدخول من جهاز آخر (Last-Wins) -->
      <controls:StudioCard x:Name="SessionSupersededBanner"
                           IsVisible="{Binding HasSessionSupersededWarning}"
                           AccentKind="Destructive">
        <TextBlock Text="{Binding SessionSupersededWarningText}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ZiwaDestructiveActionBrush}" />
      </controls:StudioCard>

      <!-- رسالة النتيجة / الأخطاء -->
      <controls:StudioCard x:Name="AccountFeedbackBanner"
                           IsVisible="{Binding HasAccountFeedback}"
                           AccentKind="Info">
        <TextBlock x:Name="AccountFeedbackTextBlock"
                   Text="{Binding AccountFeedbackMessage}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{DynamicResource ZiwaInfoBrush}" />
      </controls:StudioCard>

      <!-- حالة الحساب عند تسجيل الدخول -->
      <controls:StudioCard x:Name="AuthenticatedAccountCard"
                           IsVisible="{Binding IsUserAuthenticated}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock x:Name="AccountDisplayNameText"
                         Text="{Binding AccountDisplayName}"
                         FontSize="14"
                         FontWeight="Bold"
                         Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
              <TextBlock Text="{Binding AccountEmailDisplay}"
                         FlowDirection="LeftToRight"
                         HorizontalAlignment="Right"
                         FontSize="12"
                         Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
            </StackPanel>
            <Border Grid.Column="1"
                    Background="{DynamicResource ZiwaPrimaryActionBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Padding="10,4"
                    VerticalAlignment="Center">
              <TextBlock x:Name="AccountPlanBadgeTextBlock"
                         Text="{Binding AccountPlanBadgeText}"
                         FontWeight="Bold"
                         Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}" />
            </Border>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding AccountStatusDisplayText}"
                       FontSize="12"
                       Foreground="{DynamicResource ZiwaSuccessBrush}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding AccountExpiryDisplayText}"
                       FontSize="12"
                       Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
          </Grid>

          <TextBlock x:Name="AccountQuotaSummaryTextBlock"
                     Text="{Binding CloudQuotaBadgeText}"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ZiwaInfoBrush}" />

          <!-- تفعيل مفتاح ترخيص -->
          <StackPanel Spacing="6">
            <TextBlock Text="تفعيل مفتاح ترخيص"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
            <Grid ColumnDefinitions="*,8,Auto">
              <TextBox x:Name="LicenseKeyTextBox"
                       Grid.Column="0"
                       FlowDirection="LeftToRight"
                       Watermark="ZIWA-XXXX-XXXX-XXXX"
                       Text="{Binding LicenseKeyInput}" />
              <Button x:Name="ActivateLicenseButton"
                      Grid.Column="2"
                      Classes="studioPrimary"
                      Command="{Binding ActivateLicenseKeyCommand}"
                      IsEnabled="{Binding IsAccountIdle}"
                      ToolTip.Tip="تفعيل مفتاح الترخيص وتمديد الاشتراك عبر Supabase"
                      AutomationProperties.Name="تفعيل مفتاح الترخيص"
                      Content="تفعيل المفتاح" />
            </Grid>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="RefreshAccountStatusButton"
                    Classes="studioSubtle"
                    Command="{Binding RefreshAccountStatusCommand}"
                    IsEnabled="{Binding IsAccountIdle}"
                    ToolTip.Tip="مزامنة حالة الاشتراك والحصة والجلسة النشطة"
                    AutomationProperties.Name="مزامنة الحساب"
                    Content="مزامنة الحالة" />
            <Button x:Name="LogoutAccountButton"
                    Classes="studioDestructive"
                    Command="{Binding LogoutAccountCommand}"
                    ToolTip.Tip="تسجيل الخروج وتصفير الجلسة المحلية والحصة"
                    AutomationProperties.Name="تسجيل الخروج"
                    Content="تسجيل الخروج" />
          </StackPanel>
        </StackPanel>
      </controls:StudioCard>

      <!-- بوابة المصادقة عند عدم تسجيل الدخول -->
      <controls:StudioCard x:Name="AnonymousAuthCard" IsVisible="{Binding IsUserAnonymous}">
        <StackPanel Spacing="10">
          <UniformGrid Columns="4" ColumnSpacing="4">
            <Button x:Name="SelectLoginFlowButton"
                    Classes="studioSegment"
                    Classes.active="{Binding IsLoginFlowMode}"
                    HorizontalAlignment="Stretch"
                    Command="{Binding SelectLoginFlowCommand}"
                    IsEnabled="{Binding IsAccountIdle}"
                    ToolTip.Tip="التبديل إلى تسجيل الدخول بالبريد"
                    AutomationProperties.Name="تبويب تسجيل الدخول"
                    Content="دخول" />
            <Button x:Name="SelectRegisterFlowButton"
                    Classes="studioSegment"
                    Classes.active="{Binding IsRegisterFlowMode}"
                    HorizontalAlignment="Stretch"
                    Command="{Binding SelectRegisterFlowCommand}"
                    IsEnabled="{Binding IsAccountIdle}"
                    ToolTip.Tip="التبديل إلى إنشاء حساب جديد"
                    AutomationProperties.Name="تبويب إنشاء حساب"
                    Content="حساب جديد" />
            <Button x:Name="SelectVerifyOtpFlowButton"
                    Classes="studioSegment"
                    Classes.active="{Binding IsVerifyOtpFlowMode}"
                    HorizontalAlignment="Stretch"
                    Command="{Binding SelectVerifyOtpFlowCommand}"
                    IsEnabled="{Binding IsAccountIdle}"
                    ToolTip.Tip="التحقق من رمز OTP المرسل للبريد"
                    AutomationProperties.Name="تبويب تأكيد الرمز"
                    Content="تأكيد OTP" />
            <Button x:Name="SelectRecoverPasswordFlowButton"
                    Classes="studioSegment"
                    Classes.active="{Binding IsRecoverPasswordFlowMode}"
                    HorizontalAlignment="Stretch"
                    Command="{Binding SelectRecoverPasswordFlowCommand}"
                    IsEnabled="{Binding IsAccountIdle}"
                    ToolTip.Tip="استعادة كلمة المرور عبر البريد"
                    AutomationProperties.Name="تبويب استعادة كلمة المرور"
                    Content="استعادة" />
          </UniformGrid>

          <StackPanel Spacing="6" IsVisible="{Binding IsRegisterFlowMode}">
            <TextBlock Text="الاسم الكامل" FontSize="12" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
            <TextBox x:Name="AccountNameTextBox" Text="{Binding AccountNameInput}" Watermark="اسم الاستوديو أو المصمم" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="البريد الإلكتروني" FontSize="12" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
            <TextBox x:Name="AccountEmailTextBox" FlowDirection="LeftToRight" Text="{Binding AccountEmailInput}" Watermark="studio@example.com" />
          </StackPanel>

          <StackPanel Spacing="8" IsVisible="{Binding IsLoginFlowMode}">
            <TextBlock Text="كلمة المرور" FontSize="12" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
            <TextBox x:Name="LoginPasswordTextBox" PasswordChar="●" Text="{Binding AccountPasswordInput}" Watermark="كلمة المرور" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="SubmitLoginButton"
                      Classes="studioPrimary"
                      Command="{Binding SubmitLoginCommand}"
                      IsEnabled="{Binding IsAccountIdle}"
                      ToolTip.Tip="تسجيل الدخول باستخدام Supabase Auth"
                      AutomationProperties.Name="تسجيل الدخول بالبريد"
                      Content="تسجيل الدخول" />
              <Button x:Name="GoogleOAuthButton"
                      Classes="studioSubtle"
                      Command="{Binding LoginWithGoogleCommand}"
                      IsEnabled="{Binding IsAccountIdle}"
                      ToolTip.Tip="تسجيل الدخول عبر حساب Google باستخدام Loopback OAuth الآمن"
                      AutomationProperties.Name="الدخول عبر Google"
                      Content="الدخول عبر Google" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="8" IsVisible="{Binding IsRegisterFlowMode}">
            <TextBlock Text="كلمة المرور (8 أحرف على الأقل تتضمن حروفاً وأرقاماً)" FontSize="12" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
            <TextBox x:Name="RegisterPasswordTextBox" PasswordChar="●" Text="{Binding AccountPasswordInput}" Watermark="كلمة مرور قوية" />
            <Button x:Name="SubmitRegisterButton"
                    Classes="studioPrimary"
                    Command="{Binding SubmitRegisterCommand}"
                    IsEnabled="{Binding IsAccountIdle}"
                    ToolTip.Tip="إنشاء حساب جديد وإرسال رمز التفعيل"
                    AutomationProperties.Name="إنشاء حساب جديد"
                    Content="إنشاء الحساب" />
          </StackPanel>

          <StackPanel Spacing="8" IsVisible="{Binding IsVerifyOtpFlowMode}">
            <TextBlock Text="رمز التحقق (OTP)" FontSize="12" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
            <TextBox x:Name="VerifyOtpTextBox" FlowDirection="LeftToRight" Text="{Binding AccountOtpInput}" Watermark="123456" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="SubmitVerifyOtpButton"
                      Classes="studioPrimary"
                      Command="{Binding SubmitVerifyOtpCommand}"
                      IsEnabled="{Binding IsAccountIdle}"
                      ToolTip.Tip="تأكيد الحساب برمز التحقق"
                      AutomationProperties.Name="تأكيد رمز OTP"
                      Content="تأكيد الرمز" />
              <Button x:Name="ResendOtpButton"
                      Classes="studioSubtle"
                      Command="{Binding ResendOtpCommand}"
                      IsEnabled="{Binding IsAccountIdle}"
                      ToolTip.Tip="إعادة إرسال رمز التحقق للبريد"
                      AutomationProperties.Name="إعادة إرسال OTP"
                      Content="إعادة إرسال" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="8" IsVisible="{Binding IsRecoverPasswordFlowMode}">
            <Button x:Name="RequestRecoveryButton"
                    Classes="studioSubtle"
                    Command="{Binding RequestPasswordRecoveryCommand}"
                    IsEnabled="{Binding IsAccountIdle}"
                    ToolTip.Tip="إرسال رمز الاستعادة إلى البريد الإلكتروني"
                    AutomationProperties.Name="طلب رمز استعادة كلمة المرور"
                    Content="إرسال رمز الاستعادة" />
            <TextBlock Text="رمز الاستعادة" FontSize="12" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
            <TextBox x:Name="RecoveryOtpTextBox" FlowDirection="LeftToRight" Text="{Binding AccountOtpInput}" Watermark="رمز الاستعادة" />
            <TextBlock Text="كلمة المرور الجديدة" FontSize="12" Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
            <TextBox x:Name="RecoveryNewPasswordTextBox" PasswordChar="●" Text="{Binding AccountPasswordInput}" Watermark="كلمة المرور الجديدة" />
            <Button x:Name="SubmitPasswordRecoveryButton"
                    Classes="studioPrimary"
                    Command="{Binding SubmitPasswordRecoveryCommand}"
                    IsEnabled="{Binding IsAccountIdle}"
                    ToolTip.Tip="تأكيد رمز الاستعادة وتعيين كلمة المرور الجديدة"
                    AutomationProperties.Name="تحديث كلمة المرور"
                    Content="تعيين كلمة المرور الجديدة" />
          </StackPanel>
        </StackPanel>
      </controls:StudioCard>

      <!-- مؤشر الانتظار والإلغاء -->
      <StackPanel x:Name="AccountBusyPanel" Spacing="6" IsVisible="{Binding IsAccountBusy}">
        <ProgressBar IsIndeterminate="True" Minimum="0" Maximum="100" />
        <TextBlock Text="{Binding AccountBusyStatusText}"
                   FontSize="12"
                   Foreground="{DynamicResource ZiwaInfoBrush}" />
        <Button x:Name="CancelAccountOperationButton"
                Classes="studioDestructive"
                Command="{Binding CancelAccountOperationCommand}"
                ToolTip.Tip="إلغاء العملية الجارية"
                AutomationProperties.Name="إلغاء عملية الحساب"
                Content="إلغاء" />
      </StackPanel>
    </StackPanel>
  </controls:StudioDialogShell>
</UserControl>
