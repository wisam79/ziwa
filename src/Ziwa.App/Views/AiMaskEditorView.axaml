<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ziwa.App.ViewModels"
             xmlns:controls="using:Ziwa.App.Controls"
             x:Class="Ziwa.App.Views.AiMaskEditorView"
             x:DataType="vm:MainWindowViewModel"
             FlowDirection="RightToLeft">
  <controls:StudioDialogShell Title="تعديل قناع العزل"
                              Subtitle="{Binding MaskEditorTargetTitle}"
                              CloseCommand="{Binding CloseMaskEditorCommand}"
                              CloseToolTip="إغلاق محرر القناع دون اعتماد التغييرات (Esc)"
                              CloseAccessibleName="إغلاق محرر القناع"
                              DialogWidth="860"
                              DialogHeight="670"
                              DialogMaxHeight="720"
                              ScrollableBody="False">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
      <WrapPanel Grid.Row="0" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
        <Button x:Name="EraseBrushModeButton"
                Classes="studioSegment"
                Classes.active="{Binding IsEraseBrushActive}"
                Command="{Binding SetEraseMaskBrushCommand}"
                Content="فرشاة المسح"
                ToolTip.Tip="مسح أجزاء من الخلفية"
                AutomationProperties.Name="فرشاة المسح" />
        <Button x:Name="RestoreBrushModeButton"
                Classes="studioSegment"
                Classes.active="{Binding IsRestoreBrushActive}"
                Command="{Binding SetRestoreMaskBrushCommand}"
                Content="فرشاة الاستعادة"
                ToolTip.Tip="استعادة أجزاء من الصورة الأصلية"
                AutomationProperties.Name="فرشاة الاستعادة" />
        <Border Classes="workspaceDivider" VerticalAlignment="Center" />
        <Button x:Name="MaskStrokeUndoButton"
                Classes="studioSubtle"
                Command="{Binding UndoMaskStrokeCommand}"
                IsEnabled="{Binding CanUndoMaskStroke}"
                Content="تراجع"
                ToolTip.Tip="تراجع عن آخر ضربة فرشاة"
                AutomationProperties.Name="تراجع عن ضربة الفرشاة" />
        <Button x:Name="MaskStrokeRedoButton"
                Classes="studioSubtle"
                Command="{Binding RedoMaskStrokeCommand}"
                IsEnabled="{Binding CanRedoMaskStroke}"
                Content="إعادة"
                ToolTip.Tip="إعادة ضربة الفرشاة"
                AutomationProperties.Name="إعادة ضربة الفرشاة" />
        <Border Classes="workspaceDivider" VerticalAlignment="Center" />
        <Button x:Name="InvertMaskButton"
                Classes="studioSubtle"
                Command="{Binding InvertMaskCommand}"
                Content="عكس القناع"
                ToolTip.Tip="عكس مناطق الإظهار والإخفاء في القناع"
                AutomationProperties.Name="عكس القناع" />
        <Button x:Name="ResetAutoMaskButton"
                Classes="studioSubtle"
                Command="{Binding ResetMaskToAutoCommand}"
                Content="استعادة القناع التلقائي"
                ToolTip.Tip="استعادة القناع الناتج عن العزل التلقائي"
                AutomationProperties.Name="إعادة القناع التلقائي" />
        <Button x:Name="ResetMaskViewButton"
                Classes="studioSubtle"
                Click="OnResetMaskViewClick"
                Content="ملاءمة الصورة"
                ToolTip.Tip="إعادة التكبير والموضع للعرض الكامل (R)"
                AutomationProperties.Name="إعادة ضبط عرض القناع" />
        <ComboBox x:Name="MaskPreviewModeComboBox"
                  Width="206"
                  ItemsSource="{Binding AvailableMaskPreviewModes}"
                  SelectedItem="{Binding SelectedMaskPreviewModeOption}"
                  ToolTip.Tip="وضع معاينة قبل وبعد"
                  AutomationProperties.Name="وضع معاينة القناع">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MaskPreviewModeOption">
              <TextBlock Text="{Binding TitleAr}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </WrapPanel>

      <Border Grid.Row="1"
              CornerRadius="{StaticResource OverlayCornerRadius}"
              BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
              BorderThickness="{StaticResource HairlineBorderThickness}"
              ClipToBounds="True">
        <controls:MaskBrushCanvasControl x:Name="MaskBrushCanvas"
                                         FlowDirection="LeftToRight"
                                         MaskSession="{Binding ActiveMaskSession}"
                                         OriginalBitmap="{Binding MaskEditorOriginalBitmap}"
                                         CutoutBitmap="{Binding MaskEditorCutoutBitmap}"
                                         PreviewMode="{Binding SelectedMaskPreviewMode}"
                                         SplitRatio="{Binding MaskSplitRatio, Mode=TwoWay}"
                                         BrushMode="{Binding SelectedMaskBrushMode}"
                                         BrushRadiusPx="{Binding MaskBrushRadiusPx, Mode=TwoWay}"
                                         BrushSoftness="{Binding MaskBrushSoftness}"
                                         PasteboardBrush="{DynamicResource ZiwaCanvasBackgroundBrush}"
                                         AccentBrush="{DynamicResource ZiwaPrimaryActionBrush}"
                                         MaskModified="OnMaskCanvasModified" />
      </Border>

      <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="14">
        <controls:StudioSliderRow Grid.Column="0"
                                  Label="حجم الفرشاة"
                                  Minimum="4" Maximum="160" TickFrequency="2" DefaultValue="28"
                                  DisplayFormat="0" Unit="px"
                                  Value="{Binding MaskBrushRadiusPx}" />
        <controls:StudioSliderRow Grid.Column="1"
                                  Label="نعومة الحافة"
                                  Minimum="0.05" Maximum="1.0" TickFrequency="0.05" DefaultValue="0.5"
                                  DisplayScale="100" DisplayFormat="0" Unit="%"
                                  Value="{Binding MaskBrushSoftness}" />
        <controls:StudioSliderRow Grid.Column="2"
                                  IsVisible="{Binding IsSplitMaskPreview}"
                                  Label="فاصل المعاينة"
                                  Minimum="0.05" Maximum="0.95" TickFrequency="0.02" DefaultValue="0.5"
                                  DisplayScale="100" DisplayFormat="0" Unit="%"
                                  Value="{Binding MaskSplitRatio}" />
      </Grid>
    </Grid>

    <controls:StudioDialogShell.FooterContent>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="MaskBrushInstruction" Grid.Column="0"
                   Text="{Binding MaskEditorBrushSummary}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="CancelMaskEditorButton"
                  Classes="studioSubtle"
                  Command="{Binding CloseMaskEditorCommand}"
                  Content="إلغاء"
                  ToolTip.Tip="تجاهل التعديلات اليدوية"
                  AutomationProperties.Name="إلغاء تعديل القناع" />
          <Button x:Name="ApplyMaskEditorButton"
                  Classes="studioPrimary"
                  Command="{Binding ApplyMaskEditorCommand}"
                  Content="اعتماد القناع"
                  ToolTip.Tip="اعتماد القناع المعدّل وحفظ الأصل للاستعادة"
                  AutomationProperties.Name="اعتماد القناع المعدل" />
        </StackPanel>
      </Grid>
    </controls:StudioDialogShell.FooterContent>
  </controls:StudioDialogShell>
</UserControl>
