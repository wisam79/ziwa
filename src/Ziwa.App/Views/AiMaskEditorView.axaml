<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ziwa.App.ViewModels"
             xmlns:controls="using:Ziwa.App.Controls"
             x:Class="Ziwa.App.Views.AiMaskEditorView"
             x:DataType="vm:MainWindowViewModel"
             FlowDirection="RightToLeft">
  <UserControl.Styles>
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource ZiwaSubtleFillBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ZiwaPrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ZiwaControlBorderBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
      <Setter Property="MinHeight" Value="{StaticResource ToolbarButtonHeight}" />
    </Style>
  </UserControl.Styles>
  <Border Background="{DynamicResource ZiwaCardBrush}"
          BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
          BorderThickness="{StaticResource HairlineBorderThickness}"
          CornerRadius="{StaticResource DialogCornerRadius}"
          BoxShadow="{StaticResource ZiwaSheetShadow}"
          Padding="20"
          Margin="24"
          Width="860"
          Height="660"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="تعديل قناع العزل بالفرشاة (معاينة قبل/بعد)"
                     FontSize="17"
                     FontWeight="Bold"
                     Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
          <TextBlock Text="{Binding MaskEditorTargetTitle}"
                     FontSize="12"
                     Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
        </StackPanel>
        <Button x:Name="CloseMaskEditorButton"
                Grid.Column="1"
                Command="{Binding CloseMaskEditorCommand}"
                Content="إلغاء وإغلاق"
                ToolTip.Tip="إغلاق محرر القناع دون اعتماد التغييرات (Esc)"
                AutomationProperties.Name="إغلاق محرر القناع" />
      </Grid>

      <WrapPanel Grid.Row="1" Orientation="Horizontal">
        <Button x:Name="EraseBrushModeButton"
                Margin="0,0,6,6"
                Command="{Binding SetEraseMaskBrushCommand}"
                Content="فرشاة المسح"
                ToolTip.Tip="مسح أجزاء من الخلفية"
                AutomationProperties.Name="فرشاة المسح" />
        <Button x:Name="RestoreBrushModeButton"
                Margin="0,0,6,6"
                Command="{Binding SetRestoreMaskBrushCommand}"
                Content="فرشاة الاستعادة"
                ToolTip.Tip="استعادة أجزاء من الصورة الأصلية"
                AutomationProperties.Name="فرشاة الاستعادة" />
        <Button x:Name="MaskStrokeUndoButton"
                Margin="0,0,6,6"
                Command="{Binding UndoMaskStrokeCommand}"
                IsEnabled="{Binding CanUndoMaskStroke}"
                Content="تراجع عن الضربة"
                ToolTip.Tip="تراجع عن آخر ضربة فرشاة"
                AutomationProperties.Name="تراجع عن ضربة الفرشاة" />
        <Button x:Name="MaskStrokeRedoButton"
                Margin="0,0,6,6"
                Command="{Binding RedoMaskStrokeCommand}"
                IsEnabled="{Binding CanRedoMaskStroke}"
                Content="إعادة الضربة"
                ToolTip.Tip="إعادة ضربة الفرشاة"
                AutomationProperties.Name="إعادة ضربة الفرشاة" />
        <Button x:Name="ResetAutoMaskButton"
                Margin="0,0,12,6"
                Command="{Binding ResetMaskToAutoCommand}"
                Content="إعادة لقناع الذكاء"
                ToolTip.Tip="إعادة القناع إلى النتيجة التلقائية لـ ONNX"
                AutomationProperties.Name="إعادة القناع التلقائي" />
        <ComboBox x:Name="MaskPreviewModeComboBox"
                  Width="210"
                  ItemsSource="{Binding AvailableMaskPreviewModes}"
                  SelectedItem="{Binding SelectedMaskPreviewModeOption}"
                  ToolTip.Tip="وضع معاينة قبل وبعد"
                  AutomationProperties.Name="وضع معاينة القناع">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MaskPreviewModeOption">
              <TextBlock Text="{Binding TitleAr}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </WrapPanel>

      <Border Grid.Row="2"
              CornerRadius="{StaticResource OverlayCornerRadius}"
              BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
              BorderThickness="{StaticResource HairlineBorderThickness}"
              ClipToBounds="True">
        <controls:MaskBrushCanvasControl x:Name="MaskBrushCanvas"
                                         MaskSession="{Binding ActiveMaskSession}"
                                         OriginalBitmap="{Binding MaskEditorOriginalBitmap}"
                                         CutoutBitmap="{Binding MaskEditorCutoutBitmap}"
                                         PreviewMode="{Binding SelectedMaskPreviewMode}"
                                         SplitRatio="{Binding MaskSplitRatio, Mode=TwoWay}"
                                         BrushMode="{Binding SelectedMaskBrushMode}"
                                         BrushRadiusPx="{Binding MaskBrushRadiusPx}"
                                         BrushSoftness="{Binding MaskBrushSoftness}"
                                         PasteboardBrush="{DynamicResource ZiwaCanvasBackgroundBrush}"
                                         AccentBrush="{DynamicResource ZiwaPrimaryActionBrush}"
                                         MaskModified="OnMaskCanvasModified" />
      </Border>

      <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="{Binding MaskBrushRadiusText}"
                     FontSize="12"
                     Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
          <Slider Minimum="4" Maximum="160" Value="{Binding MaskBrushRadiusPx}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Text="{Binding MaskBrushSoftnessText}"
                     FontSize="12"
                     Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
          <Slider Minimum="0.05" Maximum="1.0" Value="{Binding MaskBrushSoftness}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="2" IsVisible="{Binding IsSplitMaskPreview}">
          <TextBlock Text="فاصل قبل / بعد"
                     FontSize="12"
                     Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
          <Slider Minimum="0.05" Maximum="0.95" Value="{Binding MaskSplitRatio}" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Text="{Binding MaskEditorBrushSummary}"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="CancelMaskEditorButton"
                  Command="{Binding CloseMaskEditorCommand}"
                  Content="إلغاء"
                  ToolTip.Tip="تجاهل التعديلات اليدوية"
                  AutomationProperties.Name="إلغاء تعديل القناع" />
          <Button x:Name="ApplyMaskEditorButton"
                  Command="{Binding ApplyMaskEditorCommand}"
                  Background="{DynamicResource ZiwaPrimaryActionBrush}"
                  Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}"
                  Content="اعتماد القناع"
                  ToolTip.Tip="اعتماد القناع المعدّل وحفظ الأصل للاستعادة"
                  AutomationProperties.Name="اعتماد القناع المعدل" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
