<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ziwa.App.ViewModels"
             xmlns:cmd="using:Ziwa.Application.Commands"
             xmlns:controls="using:Ziwa.App.Controls"
             x:Class="Ziwa.App.Views.Dialogs.CommandPaletteView"
             x:DataType="vm:MainWindowViewModel"
             FlowDirection="RightToLeft">
  <controls:StudioDialogShell Title="لوحة الأوامر السريعة (Ctrl+K)"
                              Subtitle="ابحث بالاسم أو التصنيف واضغط Enter لتنفيذ أول نتيجة"
                              CloseCommand="{Binding ToggleCommandPaletteCommand}"
                              CloseToolTip="إغلاق لوحة الأوامر (Esc)"
                              CloseAccessibleName="إغلاق لوحة الأوامر"
                              DialogWidth="500"
                              DialogMaxHeight="460"
                              DialogVerticalAlignment="Top"
                              ScrollableBody="False">
    <Grid RowDefinitions="Auto,*" RowSpacing="10">
      <Border Grid.Row="0"
              Background="{DynamicResource ZiwaSurfaceBrush}"
              BorderBrush="{DynamicResource ZiwaControlBorderBrush}"
              BorderThickness="{StaticResource HairlineBorderThickness}"
              CornerRadius="{StaticResource ControlCornerRadius}"
              Padding="10,2">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <PathIcon Grid.Column="0"
                    Data="{StaticResource IconSearch}"
                    Width="15"
                    Height="15"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource ZiwaSecondaryTextBrush}"
                    IsHitTestVisible="False" />
          <TextBox x:Name="CommandSearchTextBox"
                   Grid.Column="1"
                   Background="{DynamicResource ZiwaTransparentBrush}"
                   BorderThickness="0"
                   Padding="2,6"
                   Text="{Binding CommandSearchQuery}"
                   Watermark="ابحث عن أمر أو اختصار..."
                   AutomationProperties.Name="حقل البحث في لوحة الأوامر" />
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <ScrollViewer MaxHeight="300">
          <ItemsControl ItemsSource="{Binding FilteredCommands}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="cmd:CommandDefinition">
                <Button Margin="0,0,0,4"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Classes="studioSubtle"
                        Background="{DynamicResource ZiwaSurfaceBrush}"
                        BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExecutePaletteCommandCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding TitleAr}"
                        AutomationProperties.Name="{Binding TitleAr}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Border Grid.Column="0" Classes="statusPill" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Category}"
                                 FontSize="10.5"
                                 Foreground="{DynamicResource ZiwaInfoBrush}" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding TitleAr}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="2"
                            Classes="shortcutBadge"
                            IsVisible="{Binding ShortcutGesture, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{Binding ShortcutGesture}"
                                 FontSize="11"
                                 FlowDirection="LeftToRight"
                                 Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
                    </Border>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock IsVisible="{Binding HasNoFilteredCommands}"
                   Text="لا توجد أوامر مطابقة للبحث"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
      </Grid>
    </Grid>
  </controls:StudioDialogShell>
</UserControl>
