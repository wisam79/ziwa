<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ziwa.App.ViewModels"
             xmlns:scn="using:Ziwa.Domain.Scanner"
             xmlns:controls="using:Ziwa.App.Controls"
             x:Class="Ziwa.App.Views.DocumentScannerView"
             x:DataType="vm:MainWindowViewModel"
             FlowDirection="RightToLeft">
  <UserControl.Styles>
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource ZiwaSubtleFillBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ZiwaPrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ZiwaControlBorderBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
      <Setter Property="MinHeight" Value="{StaticResource ToolbarButtonHeight}" />
    </Style>
  </UserControl.Styles>
  <Border Background="{DynamicResource ZiwaCardBrush}"
          BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
          BorderThickness="{StaticResource HairlineBorderThickness}"
          CornerRadius="{StaticResource DialogCornerRadius}"
          BoxShadow="{StaticResource ZiwaSheetShadow}"
          Padding="20"
          Margin="24"
          Width="980"
          Height="690"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="الماسح الذكي للمستندات والبطاقات واستعدال المنظور"
                     FontSize="17"
                     FontWeight="Bold"
                     Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
          <TextBlock Text="اسحب الزوايا الأربع بدقة مع العدسة المكبّرة، قسّم بطاقات الهوية، واختر فلتر المستند المناسب"
                     FontSize="12"
                     Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
        </StackPanel>
        <Button x:Name="ScannerOpenFileButton"
                Grid.Column="1"
                IsEnabled="{Binding IsScannerToolsEnabled}"
                Command="{Binding LoadScannerImageFromFileCommand}"
                Content="فتح صورة أخرى…"
                ToolTip.Tip="اختيار صورة ممسوحة من الجهاز"
                AutomationProperties.Name="فتح صورة أخرى في الماسح" />
        <Button x:Name="CloseScannerButton"
                Grid.Column="2"
                IsEnabled="{Binding IsScannerToolsEnabled}"
                Command="{Binding CloseDocumentScannerCommand}"
                Content="إغلاق"
                ToolTip.Tip="إغلاق نافذة الماسح الضوئي (Esc)"
                AutomationProperties.Name="إغلاق الماسح الضوئي" />
      </Grid>

      <WrapPanel Grid.Row="1" Orientation="Horizontal" IsEnabled="{Binding IsScannerToolsEnabled}">
        <Button x:Name="RedetectScanRegionsButton"
                Margin="0,0,6,6"
                Command="{Binding RedetectScanRegionsCommand}"
                Content="كشف تلقائي (مستند / بطاقات)"
                ToolTip.Tip="إعادة الكشف التلقائي لحواف مستند أو عدة بطاقات"
                AutomationProperties.Name="كشف الحواف تلقائياً" />
        <Button x:Name="SplitCardHorizontalButton"
                Margin="0,0,6,6"
                Command="{Binding SplitScanCardHorizontalCommand}"
                Content="تقسيم البطاقة (أعلى / أسفل)"
                ToolTip.Tip="تقسيم الإطار المحدد أفقياً إلى بطاقتي وجه وظهر"
                AutomationProperties.Name="تقسيم بطاقة أفقياً" />
        <Button x:Name="SplitCardVerticalButton"
                Margin="0,0,6,6"
                Command="{Binding SplitScanCardVerticalCommand}"
                Content="تقسيم البطاقة (يمين / يسار)"
                ToolTip.Tip="تقسيم الإطار المحدد عمودياً إلى بطاقتين متجاورتين"
                AutomationProperties.Name="تقسيم بطاقة عمودياً" />
        <Button x:Name="AddScanRegionButton"
                Margin="0,0,6,6"
                Command="{Binding AddManualScanRegionCommand}"
                Content="+ إضافة إطار"
                ToolTip.Tip="إضافة إطار قص مستند جديد يدوياً"
                AutomationProperties.Name="إضافة إطار مسح" />
        <Button x:Name="RemoveScanRegionButton"
                Margin="0,0,12,6"
                Command="{Binding RemoveSelectedScanRegionCommand}"
                IsEnabled="{Binding CanRemoveScanRegion}"
                Foreground="{DynamicResource ZiwaDestructiveActionBrush}"
                Content="حذف الإطار"
                ToolTip.Tip="حذف الإطار المحدد"
                AutomationProperties.Name="حذف إطار المسح" />
        <ComboBox x:Name="ScanFilterComboBox"
                  Width="185"
                  Margin="0,0,6,6"
                  ItemsSource="{Binding AvailableScanFilterOptions}"
                  SelectedItem="{Binding SelectedScanFilterOption}"
                  ToolTip.Tip="اختيار فلتر المستند للإطار المحدد"
                  AutomationProperties.Name="فلتر المستند">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DocumentScanFilterOption">
              <TextBlock Text="{Binding TitleAr}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button x:Name="ApplyScanFilterAllButton"
                Margin="0,0,0,6"
                Command="{Binding ApplyScanFilterToAllRegionsCommand}"
                Content="تعميم الفلتر للكل"
                ToolTip.Tip="تطبيق الفلتر المختار على جميع الإطارات المكتشفة"
                AutomationProperties.Name="تعميم فلتر المستند" />
      </WrapPanel>

      <Grid Grid.Row="2" ColumnDefinitions="1.25*,*" ColumnSpacing="12">
        <Grid Grid.Column="0" RowDefinitions="*,Auto" RowSpacing="8">
          <Border Grid.Row="0"
                  CornerRadius="{StaticResource OverlayCornerRadius}"
                  BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                  BorderThickness="{StaticResource HairlineBorderThickness}"
                  ClipToBounds="True">
            <controls:ScannerQuadCanvasControl x:Name="ScannerQuadCanvas"
                                               FlowDirection="LeftToRight"
                                               IsEnabled="{Binding IsScannerToolsEnabled}"
                                               SourceBitmap="{Binding ScannerSourceBitmap}"
                                               Regions="{Binding ScannerRegions}"
                                               SelectedRegionIndex="{Binding SelectedScannerRegionIndex, Mode=TwoWay}"
                                               PasteboardBrush="{DynamicResource ZiwaCanvasBackgroundBrush}"
                                               AccentBrush="{DynamicResource ZiwaPrimaryActionBrush}"
                                               SecondaryQuadBrush="{DynamicResource ZiwaSecondaryTextBrush}"
                                               CornerMoved="OnScannerCornerMoved"
                                               CornerDragCompleted="OnScannerCornerDragCompleted" />
          </Border>

          <ListBox x:Name="ScannerRegionsList"
                   Grid.Row="1"
                   MaxHeight="82"
                   IsEnabled="{Binding IsScannerToolsEnabled}"
                   ItemsSource="{Binding ScannerRegions}"
                   SelectedIndex="{Binding SelectedScannerRegionIndex, Mode=TwoWay}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="scn:DetectedDocumentRegion">
                <TextBlock Text="{Binding LabelAr}" Padding="6,2" FontSize="12" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="6">
          <TextBlock Grid.Row="0"
                     Text="معاينة الاستعدال والفلتر المباشرة"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
          <Border Grid.Row="1"
                  CornerRadius="{StaticResource OverlayCornerRadius}"
                  BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                  BorderThickness="{StaticResource HairlineBorderThickness}"
                  ClipToBounds="True">
            <controls:SkiaBitmapPreviewControl x:Name="ScannerRectifiedPreview"
                                               FlowDirection="LeftToRight"
                                               PreviewBitmap="{Binding ScannerRectifiedPreviewBitmap}"
                                               PasteboardBrush="{DynamicResource ZiwaCanvasBackgroundBrush}" />
          </Border>
          <TextBlock Grid.Row="2"
                     Text="{Binding ScannerPreviewSummaryText}"
                     FontSize="12"
                     Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
        </Grid>
      </Grid>

      <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding ScannerStatusText}"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsScannerProcessing}">
            <ProgressBar Width="120" IsIndeterminate="True" Minimum="0" Maximum="100" VerticalAlignment="Center" />
            <Button x:Name="CancelScannerOperationButton"
                    Command="{Binding CancelScannerOperationCommand}"
                    Foreground="{DynamicResource ZiwaDestructiveActionBrush}"
                    Content="إلغاء المعالجة"
                    ToolTip.Tip="إلغاء معالجة الماسح الضوئي فوراً"
                    AutomationProperties.Name="إلغاء معالجة الماسح" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding IsScannerToolsEnabled}">
          <CheckBox x:Name="InsertAllRegionsCheckBox"
                    IsChecked="{Binding InsertAllScannedRegions}"
                    Content="إدراج كل البطاقات"
                    VerticalAlignment="Center" />
          <Button x:Name="InsertScannedToCollageButton"
                  Command="{Binding InsertScannedToCollageCommand}"
                  Content="إدراج في خانات الكولاج"
                  ToolTip.Tip="استعدال البطاقات وإدراجها في خانات الكولاج بخطوة تراجع واحدة"
                  AutomationProperties.Name="إدراج المستندات في الكولاج" />
          <Button x:Name="InsertScannedToFreeformButton"
                  Command="{Binding InsertScannedToFreeformCommand}"
                  Background="{DynamicResource ZiwaPrimaryActionBrush}"
                  Foreground="{DynamicResource ZiwaOnPrimaryActionBrush}"
                  Content="إدراج في الورقة الحرة"
                  ToolTip.Tip="استعدال المستندات وإدراجها في الورقة الحرة بخطوة تراجع واحدة"
                  AutomationProperties.Name="إدراج المستندات في الورقة الحرة" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
