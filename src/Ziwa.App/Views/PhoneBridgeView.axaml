<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ziwa.App.ViewModels"
             xmlns:controls="using:Ziwa.App.Controls"
             x:Class="Ziwa.App.Views.PhoneBridgeView"
             x:DataType="vm:MainWindowViewModel"
             FlowDirection="RightToLeft">
  <controls:StudioDialogShell Title="جسر كاميرا الهاتف (QR)"
                              Subtitle="امسح الرمز بكاميرا الهاتف لإرسال الصور مباشرة إلى الورقة أو خانة الكولاج"
                              CloseCommand="{Binding ClosePhoneBridgeDialogCommand}"
                              CloseToolTip="إغلاق النافذة مع إبقاء الجسر متصلاً في الخلفية (Esc)"
                              CloseAccessibleName="إغلاق نافذة جسر الهاتف"
                              DialogWidth="500"
                              DialogMaxHeight="740">
    <StackPanel Spacing="12">
      <!-- تنبيه أو رسالة خطأ -->
      <controls:StudioCard x:Name="PhoneBridgeErrorBanner"
                           IsVisible="{Binding HasPhoneBridgeError}"
                           AccentKind="Info">
        <TextBlock x:Name="PhoneBridgeErrorTextBlock"
                   Text="{Binding PhoneBridgeErrorText}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{DynamicResource ZiwaInfoBrush}" />
      </controls:StudioCard>

      <!-- حالة انتظار التشغيل / التوقف -->
      <controls:StudioCard x:Name="PhoneBridgeStoppedCard" IsVisible="{Binding IsPhoneBridgeStopped}">
        <StackPanel Spacing="12" HorizontalAlignment="Center" Margin="0,8">
          <Border Width="48"
                  Height="48"
                  CornerRadius="{StaticResource OverlayCornerRadius}"
                  Background="{DynamicResource ZiwaPrimarySubtleBrush}"
                  HorizontalAlignment="Center">
            <PathIcon Data="{StaticResource IconPhoneBridge}"
                      Width="24"
                      Height="24"
                      Foreground="{DynamicResource ZiwaPrimaryActionBrush}"
                      IsHitTestVisible="False" />
          </Border>
          <TextBlock Text="الجسر متوقف حالياً"
                     FontSize="14"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource ZiwaPrimaryTextBrush}" />
          <Button x:Name="StartPhoneBridgeButton"
                  Classes="studioPrimary"
                  Command="{Binding StartPhoneBridgeCommand}"
                  IsEnabled="{Binding IsPhoneBridgeIdle}"
                  HorizontalAlignment="Center"
                  ToolTip.Tip="تشغيل خادم جسر الهاتف وتوليد رمز QR"
                  AutomationProperties.Name="تشغيل جسر الهاتف"
                  Content="تشغيل الجسر وتوليد QR" />
        </StackPanel>
      </controls:StudioCard>

      <!-- حالة التشغيل ورمز QR -->
      <StackPanel Spacing="10" IsVisible="{Binding IsPhoneBridgeRunning}">
        <!-- مبدّل الوضع -->
        <UniformGrid Columns="2" ColumnSpacing="8">
          <Button x:Name="SelectCloudModeButton"
                  Classes="studioSegment"
                  Classes.active="{Binding IsPhoneBridgeCloudMode}"
                  HorizontalAlignment="Stretch"
                  Command="{Binding SelectPhoneBridgeCloudModeCommand}"
                  IsEnabled="{Binding CanUsePhoneBridgeCloud}"
                  ToolTip.Tip="الاقتران عبر السحابة (grido.cloud-ip.cc/cam) — يتطلب تسجيل الدخول"
                  AutomationProperties.Name="وضع السحابة"
                  Content="عبر الإنترنت (السحابة)" />
          <Button x:Name="SelectLocalModeButton"
                  Classes="studioSegment"
                  Classes.active="{Binding IsPhoneBridgeLocalMode}"
                  HorizontalAlignment="Stretch"
                  Command="{Binding SelectPhoneBridgeLocalModeCommand}"
                  ToolTip.Tip="الاقتران المباشر على نفس شبكة Wi-Fi المحلية"
                  AutomationProperties.Name="وضع الشبكة المحلية"
                  Content="الشبكة المحلية (LAN)" />
        </UniformGrid>

        <!-- بطاقة رمز QR -->
        <controls:StudioCard HorizontalAlignment="Center">
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <Border Width="236"
                    Height="236"
                    Padding="8"
                    Background="{DynamicResource ZiwaQrSurfaceBrush}"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    BorderBrush="{DynamicResource ZiwaHairlineBorderBrush}"
                    BorderThickness="{StaticResource HairlineBorderThickness}"
                    ClipToBounds="True">
              <controls:SkiaBitmapPreviewControl x:Name="PhoneBridgeQrPreview"
                                                 PreviewBitmap="{Binding PhoneBridgeQrBitmap}"
                                                 PasteboardBrush="{DynamicResource ZiwaQrSurfaceBrush}" />
            </Border>
            <TextBlock x:Name="PhoneBridgeStatusSummaryTextBlock"
                       Text="{Binding PhoneBridgeStatusSummaryText}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource ZiwaSuccessBrush}" />
            <TextBlock x:Name="PhoneBridgeLastReceivedTextBlock"
                       IsVisible="{Binding HasPhoneBridgeReceivedPhotos}"
                       Text="{Binding PhoneBridgeLastReceivedText, StringFormat='آخر صورة مستلمة: {0}'}"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource ZiwaSecondaryTextBrush}" />
          </StackPanel>
        </controls:StudioCard>

        <!-- رابط الاقتران المباشر وزر النسخ -->
        <Grid ColumnDefinitions="*,8,Auto">
          <TextBox x:Name="PhoneBridgeUrlTextBox"
                   Grid.Column="0"
                   IsReadOnly="True"
                   FlowDirection="LeftToRight"
                   Text="{Binding PhoneBridgeActiveUrl, Mode=OneWay}"
                   ToolTip.Tip="رابط الكاميرا المباشر للهاتف"
                   AutomationProperties.Name="رابط جسر الهاتف" />
          <Button x:Name="CopyPhoneBridgeUrlButton"
                  Grid.Column="2"
                  Classes="studioSubtle"
                  Command="{Binding CopyPhoneBridgeUrlCommand}"
                  ToolTip.Tip="نسخ رابط جسر الهاتف إلى الحافظة"
                  AutomationProperties.Name="نسخ الرابط"
                  Content="نسخ الرابط" />
        </Grid>

        <!-- أزرار التحكم بالجلسة -->
        <UniformGrid Columns="3" ColumnSpacing="8">
          <Button x:Name="RestartPhoneBridgeButton"
                  Classes="studioSubtle"
                  HorizontalAlignment="Stretch"
                  Command="{Binding RestartPhoneBridgeCommand}"
                  IsEnabled="{Binding IsPhoneBridgeIdle}"
                  ToolTip.Tip="إعادة توليد رمز جلسة جديد وإعادة تشغيل الخادم"
                  AutomationProperties.Name="إعادة تشغيل الجسر"
                  Content="إعادة تشغيل" />
          <Button x:Name="StopPhoneBridgeButton"
                  Classes="studioDestructive"
                  HorizontalAlignment="Stretch"
                  Command="{Binding StopPhoneBridgeCommand}"
                  IsEnabled="{Binding IsPhoneBridgeIdle}"
                  ToolTip.Tip="إيقاف جسر الهاتف ومسح الجلسة المؤقتة"
                  AutomationProperties.Name="إيقاف الجسر"
                  Content="إيقاف الجسر" />
          <Button x:Name="KeepRunningCloseButton"
                  Classes="studioPrimary"
                  HorizontalAlignment="Stretch"
                  Command="{Binding ClosePhoneBridgeDialogCommand}"
                  ToolTip.Tip="إغلاق النافذة وإبقاء الجسر متصلاً بالخلفية"
                  AutomationProperties.Name="متابعة العمل"
                  Content="إخفاء (متصل)" />
        </UniformGrid>
      </StackPanel>
    </StackPanel>
  </controls:StudioDialogShell>
</UserControl>
