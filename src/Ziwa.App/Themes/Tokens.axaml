<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Typography Tokens (Offline Embedded Arabic Fonts) -->
  <FontFamily x:Key="ZiwaCairoFont">avares://Ziwa.App/Assets/Fonts#Cairo</FontFamily>
  <FontFamily x:Key="ZiwaTajawalFont">avares://Ziwa.App/Assets/Fonts#Tajawal</FontFamily>
  <FontFamily x:Key="ZiwaIbmPlexArabicFont">avares://Ziwa.App/Assets/Fonts#IBM Plex Sans Arabic</FontFamily>
  <StaticResource x:Key="ContentControlThemeFontFamily" ResourceKey="ZiwaIbmPlexArabicFont" />

  <!-- Apple HIG Corner Radius Hierarchy -->
  <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="CheckBoxCornerRadius">3</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
  <CornerRadius x:Key="DialogCornerRadius">12</CornerRadius>
  <CornerRadius x:Key="PillCornerRadius">999</CornerRadius>

  <!-- Apple HIG Layout & Density Tokens -->
  <x:Double x:Key="ToolbarButtonHeight">30</x:Double>
  <x:Double x:Key="CompactButtonSize">28</x:Double>
  <x:Double x:Key="RailWidth">60</x:Double>
  <x:Double x:Key="InspectorWidth">292</x:Double>
  <x:Double x:Key="RulerThickness">20</x:Double>

  <GridLength x:Key="RailGridLength">60</GridLength>
  <GridLength x:Key="InspectorGridLength">292</GridLength>
  <GridLength x:Key="RulerGridLength">20</GridLength>

  <Thickness x:Key="HairlineBorderThickness">1</Thickness>
  <Thickness x:Key="ToolbarPadding">14,7</Thickness>
  <Thickness x:Key="PageStripPadding">14,4</Thickness>
  <Thickness x:Key="StatusBarPadding">14,2</Thickness>
  <x:Double x:Key="WorkspaceLabelSize">13</x:Double>
  <x:Double x:Key="WorkspaceSmallLabelSize">12</x:Double>
  <x:Double x:Key="WorkspaceTitleSize">15</x:Double>
  <x:Double x:Key="WorkspaceIconSize">16</x:Double>
  <x:Double x:Key="WorkspaceRailIconSize">19</x:Double>
  <Thickness x:Key="InspectorPadding">14</Thickness>
  <Thickness x:Key="CardPadding">12</Thickness>
  <Thickness x:Key="ControlPadding">10,5</Thickness>

  <!-- Apple HIG Depth & Sheet Shadows -->
  <BoxShadows x:Key="ZiwaCardShadow">0 2 8 0 #14000000</BoxShadows>
  <BoxShadows x:Key="ZiwaFloatingShadow">0 6 18 0 #26000000</BoxShadows>
  <BoxShadows x:Key="ZiwaSheetShadow">0 14 36 0 #42000000</BoxShadows>

  <SolidColorBrush x:Key="ZiwaTransparentBrush" Color="Transparent" />

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- Apple HIG Light Surfaces -->
      <Color x:Key="ZiwaCanvasBackgroundColor">#E6E7EC</Color>
      <Color x:Key="ZiwaSurfaceColor">#F4F5F8</Color>
      <Color x:Key="ZiwaCardColor">#FFFFFF</Color>
      <Color x:Key="ZiwaElevatedCardColor">#FFFFFF</Color>
      <Color x:Key="ZiwaSubtleFillColor">#E8E9EF</Color>
      <Color x:Key="ZiwaHoverFillColor">#DCDEE7</Color>
      <Color x:Key="ZiwaPressedFillColor">#CFD2DE</Color>
      <Color x:Key="ZiwaRulerBackgroundColor">#EFEFF4</Color>
      <Color x:Key="ZiwaScrimColor">#660B0F19</Color>
      <Color x:Key="ZiwaPrimarySubtleColor">#E6F0FD</Color>
      <Color x:Key="ZiwaPrimaryHoverColor">#0055B3</Color>
      <Color x:Key="ZiwaPrimaryPressedColor">#004494</Color>
      <Color x:Key="ZiwaDestructiveSubtleColor">#FDECEC</Color>
      <Color x:Key="ZiwaSuccessSubtleColor">#E8F6EC</Color>
      <Color x:Key="ZiwaWarningSubtleColor">#FEF5E6</Color>
      <Color x:Key="ZiwaInfoSubtleColor">#E6F2FE</Color>
      <Color x:Key="ZiwaQrSurfaceColor">#FFFFFF</Color>

      <!-- Apple HIG Light Typography -->
      <Color x:Key="ZiwaPrimaryTextColor">#18181B</Color>
      <Color x:Key="ZiwaSecondaryTextColor">#57585E</Color>
      <Color x:Key="ZiwaOnPrimaryActionColor">#FFFFFF</Color>

      <!-- Apple HIG Light Hairlines -->
      <Color x:Key="ZiwaHairlineBorderColor">#D4D6DE</Color>
      <Color x:Key="ZiwaControlBorderColor">#C4C7D0</Color>
      <Color x:Key="ZiwaFocusStrokeColor">#0062C4</Color>

      <!-- Apple HIG Light Semantic Colors (WCAG >= 4.5:1) -->
      <Color x:Key="ZiwaPrimaryActionColor">#0062C4</Color>
      <Color x:Key="ZiwaDestructiveActionColor">#C81E1E</Color>
      <Color x:Key="ZiwaSuccessColor">#167934</Color>
      <Color x:Key="ZiwaWarningColor">#945400</Color>
      <Color x:Key="ZiwaInfoColor">#0062C4</Color>

      <!-- Brushes -->
      <SolidColorBrush x:Key="ZiwaCanvasBackgroundBrush" Color="{StaticResource ZiwaCanvasBackgroundColor}" />
      <SolidColorBrush x:Key="ZiwaSurfaceBrush" Color="{StaticResource ZiwaSurfaceColor}" />
      <SolidColorBrush x:Key="ZiwaCardBrush" Color="{StaticResource ZiwaCardColor}" />
      <SolidColorBrush x:Key="ZiwaElevatedCardBrush" Color="{StaticResource ZiwaElevatedCardColor}" />
      <SolidColorBrush x:Key="ZiwaSubtleFillBrush" Color="{StaticResource ZiwaSubtleFillColor}" />
      <SolidColorBrush x:Key="ZiwaHoverFillBrush" Color="{StaticResource ZiwaHoverFillColor}" />
      <SolidColorBrush x:Key="ZiwaPressedFillBrush" Color="{StaticResource ZiwaPressedFillColor}" />
      <SolidColorBrush x:Key="ZiwaRulerBackgroundBrush" Color="{StaticResource ZiwaRulerBackgroundColor}" />
      <SolidColorBrush x:Key="ZiwaScrimBrush" Color="{StaticResource ZiwaScrimColor}" />
      <SolidColorBrush x:Key="ZiwaPrimarySubtleBrush" Color="{StaticResource ZiwaPrimarySubtleColor}" />
      <SolidColorBrush x:Key="ZiwaPrimaryHoverBrush" Color="{StaticResource ZiwaPrimaryHoverColor}" />
      <SolidColorBrush x:Key="ZiwaPrimaryPressedBrush" Color="{StaticResource ZiwaPrimaryPressedColor}" />
      <SolidColorBrush x:Key="ZiwaDestructiveSubtleBrush" Color="{StaticResource ZiwaDestructiveSubtleColor}" />
      <SolidColorBrush x:Key="ZiwaSuccessSubtleBrush" Color="{StaticResource ZiwaSuccessSubtleColor}" />
      <SolidColorBrush x:Key="ZiwaWarningSubtleBrush" Color="{StaticResource ZiwaWarningSubtleColor}" />
      <SolidColorBrush x:Key="ZiwaInfoSubtleBrush" Color="{StaticResource ZiwaInfoSubtleColor}" />
      <SolidColorBrush x:Key="ZiwaQrSurfaceBrush" Color="{StaticResource ZiwaQrSurfaceColor}" />

      <SolidColorBrush x:Key="ZiwaPrimaryTextBrush" Color="{StaticResource ZiwaPrimaryTextColor}" />
      <SolidColorBrush x:Key="ZiwaSecondaryTextBrush" Color="{StaticResource ZiwaSecondaryTextColor}" />
      <SolidColorBrush x:Key="ZiwaOnPrimaryActionBrush" Color="{StaticResource ZiwaOnPrimaryActionColor}" />

      <SolidColorBrush x:Key="ZiwaHairlineBorderBrush" Color="{StaticResource ZiwaHairlineBorderColor}" />
      <SolidColorBrush x:Key="ZiwaControlBorderBrush" Color="{StaticResource ZiwaControlBorderColor}" />
      <SolidColorBrush x:Key="ZiwaFocusStrokeBrush" Color="{StaticResource ZiwaFocusStrokeColor}" />

      <SolidColorBrush x:Key="ZiwaPrimaryActionBrush" Color="{StaticResource ZiwaPrimaryActionColor}" />
      <SolidColorBrush x:Key="ZiwaDestructiveActionBrush" Color="{StaticResource ZiwaDestructiveActionColor}" />
      <SolidColorBrush x:Key="ZiwaSuccessBrush" Color="{StaticResource ZiwaSuccessColor}" />
      <SolidColorBrush x:Key="ZiwaWarningBrush" Color="{StaticResource ZiwaWarningColor}" />
      <SolidColorBrush x:Key="ZiwaInfoBrush" Color="{StaticResource ZiwaInfoColor}" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <!-- Apple HIG Dark Surfaces -->
      <Color x:Key="ZiwaCanvasBackgroundColor">#121316</Color>
      <Color x:Key="ZiwaSurfaceColor">#1A1B1F</Color>
      <Color x:Key="ZiwaCardColor">#24262B</Color>
      <Color x:Key="ZiwaElevatedCardColor">#2D3037</Color>
      <Color x:Key="ZiwaSubtleFillColor">#32353D</Color>
      <Color x:Key="ZiwaHoverFillColor">#3E424C</Color>
      <Color x:Key="ZiwaPressedFillColor">#4B505C</Color>
      <Color x:Key="ZiwaRulerBackgroundColor">#1F2025</Color>
      <Color x:Key="ZiwaScrimColor">#A606080D</Color>
      <Color x:Key="ZiwaPrimarySubtleColor">#172B46</Color>
      <Color x:Key="ZiwaPrimaryHoverColor">#1A82F0</Color>
      <Color x:Key="ZiwaPrimaryPressedColor">#005EC2</Color>
      <Color x:Key="ZiwaDestructiveSubtleColor">#3A1C1E</Color>
      <Color x:Key="ZiwaSuccessSubtleColor">#163322</Color>
      <Color x:Key="ZiwaWarningSubtleColor">#362B12</Color>
      <Color x:Key="ZiwaInfoSubtleColor">#162E3F</Color>
      <Color x:Key="ZiwaQrSurfaceColor">#FFFFFF</Color>

      <!-- Apple HIG Dark Typography -->
      <Color x:Key="ZiwaPrimaryTextColor">#F4F5F7</Color>
      <Color x:Key="ZiwaSecondaryTextColor">#B0B3BC</Color>
      <Color x:Key="ZiwaOnPrimaryActionColor">#FFFFFF</Color>

      <!-- Apple HIG Dark Hairlines -->
      <Color x:Key="ZiwaHairlineBorderColor">#343740</Color>
      <Color x:Key="ZiwaControlBorderColor">#454954</Color>
      <Color x:Key="ZiwaFocusStrokeColor">#4DA3FF</Color>

      <!-- Apple HIG Dark Semantic Colors (WCAG >= 4.5:1) -->
      <Color x:Key="ZiwaPrimaryActionColor">#006FE0</Color>
      <Color x:Key="ZiwaDestructiveActionColor">#FF6B6B</Color>
      <Color x:Key="ZiwaSuccessColor">#34D399</Color>
      <Color x:Key="ZiwaWarningColor">#FBBF24</Color>
      <Color x:Key="ZiwaInfoColor">#60A5FA</Color>

      <!-- Brushes -->
      <SolidColorBrush x:Key="ZiwaCanvasBackgroundBrush" Color="{StaticResource ZiwaCanvasBackgroundColor}" />
      <SolidColorBrush x:Key="ZiwaSurfaceBrush" Color="{StaticResource ZiwaSurfaceColor}" />
      <SolidColorBrush x:Key="ZiwaCardBrush" Color="{StaticResource ZiwaCardColor}" />
      <SolidColorBrush x:Key="ZiwaElevatedCardBrush" Color="{StaticResource ZiwaElevatedCardColor}" />
      <SolidColorBrush x:Key="ZiwaSubtleFillBrush" Color="{StaticResource ZiwaSubtleFillColor}" />
      <SolidColorBrush x:Key="ZiwaHoverFillBrush" Color="{StaticResource ZiwaHoverFillColor}" />
      <SolidColorBrush x:Key="ZiwaPressedFillBrush" Color="{StaticResource ZiwaPressedFillColor}" />
      <SolidColorBrush x:Key="ZiwaRulerBackgroundBrush" Color="{StaticResource ZiwaRulerBackgroundColor}" />
      <SolidColorBrush x:Key="ZiwaScrimBrush" Color="{StaticResource ZiwaScrimColor}" />
      <SolidColorBrush x:Key="ZiwaPrimarySubtleBrush" Color="{StaticResource ZiwaPrimarySubtleColor}" />
      <SolidColorBrush x:Key="ZiwaPrimaryHoverBrush" Color="{StaticResource ZiwaPrimaryHoverColor}" />
      <SolidColorBrush x:Key="ZiwaPrimaryPressedBrush" Color="{StaticResource ZiwaPrimaryPressedColor}" />
      <SolidColorBrush x:Key="ZiwaDestructiveSubtleBrush" Color="{StaticResource ZiwaDestructiveSubtleColor}" />
      <SolidColorBrush x:Key="ZiwaSuccessSubtleBrush" Color="{StaticResource ZiwaSuccessSubtleColor}" />
      <SolidColorBrush x:Key="ZiwaWarningSubtleBrush" Color="{StaticResource ZiwaWarningSubtleColor}" />
      <SolidColorBrush x:Key="ZiwaInfoSubtleBrush" Color="{StaticResource ZiwaInfoSubtleColor}" />
      <SolidColorBrush x:Key="ZiwaQrSurfaceBrush" Color="{StaticResource ZiwaQrSurfaceColor}" />

      <SolidColorBrush x:Key="ZiwaPrimaryTextBrush" Color="{StaticResource ZiwaPrimaryTextColor}" />
      <SolidColorBrush x:Key="ZiwaSecondaryTextBrush" Color="{StaticResource ZiwaSecondaryTextColor}" />
      <SolidColorBrush x:Key="ZiwaOnPrimaryActionBrush" Color="{StaticResource ZiwaOnPrimaryActionColor}" />

      <SolidColorBrush x:Key="ZiwaHairlineBorderBrush" Color="{StaticResource ZiwaHairlineBorderColor}" />
      <SolidColorBrush x:Key="ZiwaControlBorderBrush" Color="{StaticResource ZiwaControlBorderColor}" />
      <SolidColorBrush x:Key="ZiwaFocusStrokeBrush" Color="{StaticResource ZiwaFocusStrokeColor}" />

      <SolidColorBrush x:Key="ZiwaPrimaryActionBrush" Color="{StaticResource ZiwaPrimaryActionColor}" />
      <SolidColorBrush x:Key="ZiwaDestructiveActionBrush" Color="{StaticResource ZiwaDestructiveActionColor}" />
      <SolidColorBrush x:Key="ZiwaSuccessBrush" Color="{StaticResource ZiwaSuccessColor}" />
      <SolidColorBrush x:Key="ZiwaWarningBrush" Color="{StaticResource ZiwaWarningColor}" />
      <SolidColorBrush x:Key="ZiwaInfoBrush" Color="{StaticResource ZiwaInfoColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
