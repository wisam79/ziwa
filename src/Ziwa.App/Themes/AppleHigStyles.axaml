<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StyleInclude Source="avares://Ziwa.App/Themes/WorkspaceStyles.axaml" />
  <!-- Apple HIG Control Polish (No Raw Hex Literals) -->
  <Style Selector="Button">
    <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.50" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Background" Value="{DynamicResource ZiwaSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ZiwaPrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ZiwaControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource HairlineBorderThickness}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource ZiwaSecondaryTextBrush}" />
  </Style>

  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource ZiwaFocusStrokeBrush}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Background" Value="{DynamicResource ZiwaSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ZiwaPrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ZiwaControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource HairlineBorderThickness}" />
  </Style>

  <Style Selector="ComboBox:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource ZiwaSecondaryTextBrush}" />
  </Style>

  <Style Selector="ComboBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource ZiwaFocusStrokeBrush}" />
  </Style>

  <Style Selector="CheckBox">
    <Style.Resources>
      <CornerRadius x:Key="ControlCornerRadius">3</CornerRadius>
    </Style.Resources>
    <Setter Property="Foreground" Value="{DynamicResource ZiwaPrimaryTextBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="CheckBox /template/ Border#NormalRectangle">
    <Setter Property="CornerRadius" Value="{StaticResource CheckBoxCornerRadius}" />
  </Style>

  <Style Selector="NumericUpDown.compact">
    <Setter Property="ShowButtonSpinner" Value="False" />
    <Setter Property="Padding" Value="6,4" />
  </Style>

  <!-- Popups, Menus, ToolTips & Lists -->
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource ZiwaElevatedCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ZiwaHairlineBorderBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource HairlineBorderThickness}" />
    <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource ZiwaElevatedCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ZiwaHairlineBorderBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource HairlineBorderThickness}" />
    <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
    <Setter Property="Padding" Value="5" />
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource ZiwaElevatedCardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ZiwaPrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ZiwaHairlineBorderBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource HairlineBorderThickness}" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Padding" Value="8,5" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="{DynamicResource ZiwaSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ZiwaHairlineBorderBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource HairlineBorderThickness}" />
    <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Margin" Value="0,1" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ZiwaPrimarySubtleBrush}" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Background" Value="{DynamicResource ZiwaSubtleFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ZiwaPrimaryActionBrush}" />
  </Style>

  <!-- Studio Semantic Button Classes -->
  <Style Selector="Button.studioPrimary">
    <Setter Property="MinHeight" Value="{StaticResource CompactButtonSize}" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Background" Value="{DynamicResource ZiwaPrimaryActionBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ZiwaOnPrimaryActionBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.studioPrimary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ZiwaPrimaryHoverBrush}" />
  </Style>
  <Style Selector="Button.studioPrimary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ZiwaPrimaryPressedBrush}" />
  </Style>
  <Style Selector="Button.studioPrimary:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource ZiwaFocusStrokeBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Button.studioSubtle">
    <Setter Property="MinHeight" Value="{StaticResource CompactButtonSize}" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Background" Value="{DynamicResource ZiwaSubtleFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ZiwaPrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ZiwaControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource HairlineBorderThickness}" />
  </Style>
  <Style Selector="Button.studioSubtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ZiwaHoverFillBrush}" />
  </Style>
  <Style Selector="Button.studioSubtle:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ZiwaPressedFillBrush}" />
  </Style>
  <Style Selector="Button.studioSubtle:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource ZiwaFocusStrokeBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Button.studioDestructive">
    <Setter Property="MinHeight" Value="{StaticResource CompactButtonSize}" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Background" Value="{DynamicResource ZiwaDestructiveSubtleBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ZiwaDestructiveActionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ZiwaControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource HairlineBorderThickness}" />
  </Style>
  <Style Selector="Button.studioDestructive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ZiwaHoverFillBrush}" />
  </Style>
  <Style Selector="Button.studioDestructive:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ZiwaPressedFillBrush}" />
  </Style>
  <Style Selector="Button.studioDestructive:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource ZiwaFocusStrokeBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Button.studioSegment">
    <Setter Property="MinHeight" Value="{StaticResource CompactButtonSize}" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource ZiwaCardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ZiwaPrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ZiwaHairlineBorderBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource HairlineBorderThickness}" />
  </Style>
  <Style Selector="Button.studioSegment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ZiwaSubtleFillBrush}" />
  </Style>
  <Style Selector="Button.studioSegment.active">
    <Setter Property="Background" Value="{DynamicResource ZiwaPrimarySubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ZiwaFocusStrokeBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.studioSegment:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource ZiwaFocusStrokeBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Unified Flyout Menu Item -->
  <Style Selector="Button.studioMenuItem">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Background" Value="{DynamicResource ZiwaTransparentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ZiwaPrimaryTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.studioMenuItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ZiwaSubtleFillBrush}" />
  </Style>
  <Style Selector="Button.studioMenuItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ZiwaHoverFillBrush}" />
  </Style>

  <!-- Floating QuickBar Compact Chips -->
  <Style Selector="Button.quickBarChip">
    <Setter Property="MinHeight" Value="{StaticResource CompactButtonSize}" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource ZiwaSubtleFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ZiwaPrimaryTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <ContainerQuery Name="QuickBarViewport" Query="max-width: 720">
    <Style Selector="TextBlock.quickBarCaption">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.quickBarLabeledIcon">
      <Setter Property="Width" Value="{StaticResource ToolbarButtonHeight}" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </ContainerQuery>

  <Style Selector="Button.quickBarChip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ZiwaHoverFillBrush}" />
  </Style>
  <Style Selector="Button.quickBarChip:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ZiwaPressedFillBrush}" />
  </Style>

  <Style Selector="Button.quickBarPrimary">
    <Setter Property="MinHeight" Value="{StaticResource CompactButtonSize}" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{DynamicResource ZiwaPrimaryActionBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ZiwaOnPrimaryActionBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.quickBarPrimary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ZiwaPrimaryHoverBrush}" />
  </Style>
  <Style Selector="Button.quickBarPrimary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ZiwaPrimaryPressedBrush}" />
  </Style>

  <Style Selector="Button.quickBarDestructive">
    <Setter Property="MinHeight" Value="{StaticResource CompactButtonSize}" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource ZiwaDestructiveSubtleBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ZiwaDestructiveActionBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.quickBarDestructive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ZiwaHoverFillBrush}" />
  </Style>

  <Style Selector="Button.quickBarIcon">
    <Setter Property="Width" Value="{StaticResource ToolbarButtonHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.shortcutBadge">
    <Setter Property="Background" Value="{DynamicResource ZiwaSubtleFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ZiwaHairlineBorderBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource HairlineBorderThickness}" />
    <Setter Property="CornerRadius" Value="{StaticResource CheckBoxCornerRadius}" />
    <Setter Property="Padding" Value="6,2" />
  </Style>

  <Style Selector="Border.statusPill">
    <Setter Property="Background" Value="{DynamicResource ZiwaSubtleFillBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
    <Setter Property="Padding" Value="8,2" />
  </Style>

  <Style Selector="Border.studioDivider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource ZiwaHairlineBorderBrush}" />
  </Style>
</Styles>
